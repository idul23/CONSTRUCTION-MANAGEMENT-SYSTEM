<!DOCTYPE html>

<html>

<head>
    <title>Equipment Usage</title>
</head>

<body>

<p>
    <a href="/dashboard">← Back to Dashboard</a>

    <% if (user.role_name === "Administrator" || user.role_name === "Site Staff") { %>
        |
        <a href="/equipment-usage/add">+ Add Equipment Usage</a>
    <% } %>
</p>

<h1>Equipment Usage</h1>

<% if (usage.length === 0) { %>

    <p>No equipment usage records found.</p>

<% } else { %>

    <table border="1" cellpadding="8" cellspacing="0">

        <thead>
            <tr>
                <th>ID</th>
                <th>Task</th>
                <th>Equipment</th>
                <th>Date Used</th>
                <th>Hours Used</th>
                <th>Usage Cost</th>

                <% if (user.role_name === "Administrator" || user.role_name === "Site Staff") { %>
                    <th>Actions</th>
                <% } %>

            </tr>
        </thead>

        <tbody>

            <% usage.forEach(record => { %>

                <tr>

                    <td>
                        <%= record.usage_id %>
                    </td>

                    <td>
                        <%= record.task ? record.task.task_name : "Unknown Task" %>
                    </td>

                    <td>
                        <%= record.equipment ? record.equipment.name : "Unknown Equipment" %>
                    </td>

                    <td>
                        <%= record.date_used %>
                    </td>

                    <td>
                        <%= record.hours_used %>
                    </td>

                    <td>
                        ₱<%= Number(record.usage_cost || 0).toLocaleString("en-PH", {
                            minimumFractionDigits: 2
                        }) %>
                    </td>

                    <% if (user.role_name === "Administrator" || user.role_name === "Site Staff") { %>

                        <td>

                            <a href="/equipment-usage/edit/<%= record.usage_id %>">
                                Edit
                            </a>

                            |

                            <a
                                href="/equipment-usage/delete/<%= record.usage_id %>"
                                onclick="return confirm('Are you sure you want to delete this record?');"
                            >
                                Delete
                            </a>

                        </td>

                    <% } %>

                </tr>

            <% }) %>

        </tbody>

    </table>

<% } %>

</body>

</html>
