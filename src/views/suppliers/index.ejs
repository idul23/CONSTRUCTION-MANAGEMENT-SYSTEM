<!DOCTYPE html>
<html>

<head>

    <title>Suppliers</title>

    <style>

        body {
            font-family: Arial, sans-serif;
            margin: 30px;
        }

        h1 {
            margin-bottom: 20px;
        }

        .top-links {
            margin-bottom: 20px;
        }

        .top-links a {
            margin-right: 15px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        th,
        td {
            border: 1px solid #ccc;
            padding: 10px;
            text-align: left;
        }

        th {
            background-color: #f2f2f2;
        }

        .actions a {
            margin-right: 10px;
        }

        .no-records {
            color: #666;
        }

    </style>

</head>

<body>

    <div class="top-links">

        <a href="/dashboard">
            ← Back to Dashboard
        </a>

        <a href="/suppliers/add">
            + Add Supplier
        </a>

    </div>

    <h1>Suppliers</h1>

    <% if (suppliers.length === 0) { %>

        <p class="no-records">
            No suppliers found.
        </p>

    <% } else { %>

        <table>

            <thead>

                <tr>

                    <th>ID</th>
                    <th>Name</th>
                    <th>Contact Number</th>
                    <th>Address</th>
                    <th>Actions</th>

                </tr>

            </thead>

            <tbody>

                <% suppliers.forEach(supplier => { %>

                    <tr>

                        <td>
                            <%= supplier.supplier_id %>
                        </td>

                        <td>
                            <%= supplier.name %>
                        </td>

                        <td>
                            <%= supplier.contact_no || "-" %>
                        </td>

                        <td>
                            <%= supplier.address || "-" %>
                        </td>

                        <td class="actions">

                            <a
                                href="/suppliers/edit/<%= supplier.supplier_id %>"
                            >
                                Edit
                            </a>

                            <a
                                href="/suppliers/delete/<%= supplier.supplier_id %>"
                                onclick="return confirm('Are you sure you want to delete this supplier?');"
                            >
                                Delete
                            </a>

                        </td>

                    </tr>

                <% }) %>

            </tbody>

        </table>

    <% } %>

</body>

</html>