<!DOCTYPE html>
<html>
<head>
    <title>Users</title>
</head>
<body>

    <p>
        <a href="/dashboard">← Back to Dashboard</a>
        |
        <a href="/users/add">+ Add User</a>
    </p>

    <h1>Users</h1>

    <% if (users.length === 0) { %>

        <p>No users found.</p>

    <% } else { %>

        <table border="1" cellpadding="8" cellspacing="0">

            <thead>
                <tr>
                    <th>ID</th>
                    <th>Username</th>
                    <th>Email</th>
                    <th>Role</th>
                    <th>Status</th>
                    <th>Created At</th>
                    <th>Actions</th>
                </tr>
            </thead>

            <tbody>

                <% users.forEach(userRecord => { %>

                    <tr>

                        <td>
                            <%= userRecord.user_id %>
                        </td>

                        <td>
                            <%= userRecord.username %>
                        </td>

                        <td>
                            <%= userRecord.email %>
                        </td>

                        <td>
                            <%= userRecord.Role
                                ? userRecord.Role.role_name
                                : "Unknown" %>
                        </td>

                        <td>
                            <%= userRecord.is_active
                                ? "Active"
                                : "Inactive" %>
                        </td>

                        <td>
                            <%= userRecord.created_at %>
                        </td>

                        <td>
                            <a href="/users/edit/<%= userRecord.user_id %>">
                                Edit
                            </a>

                            |

                            <a
                                href="/users/delete/<%= userRecord.user_id %>"
                                onclick="return confirm('Are you sure you want to delete this user?');"
                            >
                                Delete
                            </a>
                        </td>

                    </tr>

                <% }) %>

            </tbody>

        </table>

    <% } %>

</body>
</html>