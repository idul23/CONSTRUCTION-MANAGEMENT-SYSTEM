            padding: 15px 20px;
            border-top: 1px solid #edf1f6;
            color: #8794a6;
            font-size: 11px;
            line-height: 1.6;
            background: #fff;
        }

        .table-footer strong {
            color: var(--navy);
        }

        /* COLLAPSIBLE SIDEBAR */

        .layout.sidebar-collapsed .sidebar {
            width: 74px;
            flex-basis: 74px;
        }

        .layout.sidebar-collapsed .sidebar-heading,
        .layout.sidebar-collapsed .sidebar-divider,
        .layout.sidebar-collapsed .nav-label {
            display: none;
        }

        .layout.sidebar-collapsed .sidebar-nav {
            padding: 17px 9px 22px;
        }

        .layout.sidebar-collapsed .nav-link {
            justify-content: center;
            padding: 12px 8px;
        }

        .layout.sidebar-collapsed .nav-icon {
            width: 26px;
            min-width: 26px;
        }

        .layout.sidebar-collapsed .nav-link::after {
            content: attr(data-title);
            position: absolute;
            z-index: 1200;
            top: 50%;
            left: 64px;
            transform: translateY(-50%);
            padding: 9px 12px;
            color: white;
            background: #0b1729;
            border: 1px solid rgba(255,255,255,.12);
            border-radius: 8px;
            font-size: 11px;
            box-shadow: 0 5px 18px rgba(0,0,0,.18);
            opacity: 0;
            visibility: hidden;
            pointer-events: none;
        }

        .layout.sidebar-collapsed .nav-link:hover::after {
            opacity: 1;
            visibility: visible;
        }

        /* ACCESSIBILITY */

        a:focus-visible,
        button:focus-visible,
        input:focus-visible {
            outline: 3px solid rgba(242,140,40,.65);
            outline-offset: 3px;
        }

        /* TABLET */

        @media (max-width: 1200px) {
            .main-content {
                padding: 24px;
            }

            .stats {
                grid-template-columns: repeat(2, minmax(0, 1fr));
                gap: 14px;
            }

            .stat-card {
                padding: 19px;
            }
        }

        /* MOBILE */

        .mobile-overlay {
            display: none;
        }

        @media (max-width: 768px) {
            .topbar {
                height: 64px;
                padding: 0 14px;
                gap: 8px;
            }

            .topbar-left,
            .topbar-right {
                gap: 9px;
            }

            .brand {
                gap: 8px;
                font-size: 16px;
            }

            .brand-mark {
                width: 32px;
                height: 32px;
                font-size: 16px;
            }

            .menu-toggle {
                width: 38px;
                height: 38px;
            }

            .welcome {
                display: none;
            }

            .logout-btn {
                padding: 9px 11px;
                font-size: 11px;
            }

            .layout {
                min-height: calc(100vh - 64px);
            }

            .sidebar {
                position: fixed;
                top: 64px;
                left: 0;
                bottom: 0;
                width: 270px;
                max-width: 85vw;
                height: calc(100vh - 64px);
                transform: translateX(-105%);
                visibility: hidden;
                box-shadow: none;
            }

            .layout.sidebar-collapsed .sidebar {
                width: 270px;
                flex-basis: 270px;
            }

            .layout.sidebar-collapsed .sidebar-heading,
            .layout.sidebar-collapsed .sidebar-divider {
                display: block;
            }

            .layout.sidebar-collapsed .nav-label {
                display: inline;
            }

            .layout.sidebar-collapsed .nav-link {
                justify-content: flex-start;
                padding: 11px 13px;
            }

            .layout.sidebar-collapsed .nav-link::after {
                display: none;
            }

            .layout.mobile-menu-open .sidebar {
                transform: translateX(0);
                visibility: visible;
                box-shadow: 10px 0 35px rgba(5,15,30,.23);
            }

            .mobile-overlay {
                position: fixed;
                top: 64px;
                left: 0;
                right: 0;
                bottom: 0;
                z-index: 800;
                background: rgba(8,18,34,.52);
                backdrop-filter: blur(3px);
            }

            .layout.mobile-menu-open .mobile-overlay {
                display: block;
            }

            .main-content {
                padding: 23px 16px;
            }

            .page-heading {
                align-items: flex-start;
                flex-direction: column;
                margin-bottom: 23px;
            }

            .heading-actions {
                width: 100%;
            }

            .heading-actions .btn {
                flex: 1;
            }

            .page-heading h1 {
                font-size: 28px;
            }

            .stats {
                gap: 12px;
                margin-bottom: 25px;
            }

            .stat-card {
                padding: 17px;
                border-radius: 14px;
            }

            .stat-top {
                margin-bottom: 15px;
            }

            .stat-icon {
                width: 38px;
                height: 38px;
                font-size: 19px;
                border-radius: 11px;
            }

            .stat-number {
                font-size: 27px;
            }

            .panel {
                border-radius: 14px;
            }

            .panel-header {
                padding: 18px;
            }

            .table-tools {
                padding: 14px 16px;
            }

            .search-box {
                width: 100%;
            }
        }

        @media (max-width: 440px) {
            .stats {
                grid-template-columns: 1fr;
            }

            .main-content {
                padding: 20px 13px;
            }

            .page-heading h1 {
                font-size: 26px;
            }

            .heading-actions {
                flex-direction: column;
            }

            .heading-actions .btn {
                width: 100%;
                flex: auto;
            }

            .stat-card {
                padding: 18px;
            }

            .panel-header {
                align-items: flex-start;
                flex-direction: column;
            }

            .record-count-badge {
                align-self: flex-start;
            }
        }

        /* TOUCHSCREENS AND REDUCED MOTION */

        @media (hover: none) {
            .stat-card:hover {
                transform: none;
            }

            .btn:active,
            .actions a:active,
            .actions button:active {
                transform: scale(.98);
            }
        }

        @media (prefers-reduced-motion: reduce) {
            html {
                scroll-behavior: auto;
            }

            *,
            *::before,
            *::after {
                animation-duration: .01ms !important;
                animation-iteration-count: 1 !important;
                transition-duration: .01ms !important;
            }
        }

        /* PRINT */

        @media print {
            .topbar,
            .sidebar,
            .mobile-overlay,
            .heading-actions,
            .table-tools,
            .actions,
