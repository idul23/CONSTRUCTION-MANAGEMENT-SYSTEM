                    <span class="nav-label">Audit Logs</span>
                </a>
            <% } %>
        </nav>
    </aside>

    <div class="mobile-overlay" id="mobileOverlay"></div>

    <main class="main-content">

        <div class="page-heading">
            <div class="heading-copy">
                <div class="eyebrow">Project Operations</div>
                <h1>Attendance Management</h1>
                <p>Track worker attendance, working hours, and labor costs.</p>
            </div>

            <div class="heading-actions">
                <button type="button" class="btn btn-secondary" id="printButton">
                    <span>▤</span>
                    Print Attendance
                </button>

                <a href="/attendance/add" class="btn btn-primary">
                    <span>＋</span>
                    Record Attendance
                </a>
            </div>
        </div>

        <div class="section-label">Attendance Overview</div>

        <section class="stats">
            <div class="stat-card">
                <div class="stat-top">
                    <div class="stat-label">Attendance Records</div>
                    <div class="stat-icon">▤</div>
                </div>

                <div class="stat-number"><%= attendanceRows.length %></div>
                <div class="stat-note">All recorded attendance entries</div>
            </div>

            <div class="stat-card">
                <div class="stat-top">
                    <div class="stat-label">Total Hours Worked</div>
                    <div class="stat-icon">◷</div>
                </div>

                <div class="stat-number"><%= formatAttendanceHours(attendanceTotalHours) %></div>
                <div class="stat-note">Combined hours from attendance records</div>
            </div>

            <div class="stat-card">
                <div class="stat-top">
                    <div class="stat-label">Total Labor Cost</div>
                    <div class="stat-icon">₱</div>
                </div>

                <div class="stat-number">₱<%= formatAttendanceMoney(attendanceTotalLaborCost) %></div>
                <div class="stat-note">Combined recorded labor costs</div>
            </div>
        </section>

        <div class="section-label">Attendance Records</div>

        <section class="panel">

            <div class="panel-header">
                <div class="panel-title-wrap">
                    <h2>All Attendance Records</h2>
                    <div class="panel-subtitle">
                        View, search, and manage worker attendance records
                    </div>
                </div>

                <span class="record-count-badge">
                    <%= attendanceRows.length %> Total Records
                </span>
            </div>

            <div class="table-tools">
                <span class="table-count" id="visibleCountText">
                    Showing <%= attendanceRows.length %> attendance records
                </span>

                <label class="search-box">
                    <span class="search-icon">⌕</span>
                    <input
                        type="search"
                        id="attendanceSearch"
                        placeholder="Search attendance..."
                        aria-label="Search attendance records"
                    >
                </label>
            </div>

            <div class="table-wrapper">
                <table id="attendanceTable">
                    <thead>
                        <tr>
                            <th>Record</th>
                            <th>Worker</th>
                            <th>Task</th>
                            <th>Work Date</th>
                            <th>Time In</th>
                            <th>Time Out</th>
                            <th>Hours Worked</th>
                            <th>Labor Cost</th>
                            <th>Actions</th>
                        </tr>
                    </thead>

                    <tbody id="attendanceTableBody">
                        <% attendanceRows.forEach(function(record) { %>
                            <%
                                const assignedWorker = record.TaskAssignment && record.TaskAssignment.Worker
                                    ? record.TaskAssignment.Worker
                                    : null;

                                const assignedTask = record.TaskAssignment && record.TaskAssignment.Task
                                    ? record.TaskAssignment.Task
                                    : null;

                                const workerFullName = assignedWorker
                                    ? [assignedWorker.first_name, assignedWorker.last_name].filter(Boolean).join(" ")
                                    : "Assignment #" + (record.assignment_id || "N/A");

                                const taskDisplayName = assignedTask
                                    ? (assignedTask.task_name || "Task #" + assignedTask.task_id)
                                    : "N/A";
                            %>

                            <tr class="attendance-row">
                                <td>
                                    <div class="record-name">#<%= record.attendance_id %></div>
                                    <div class="record-id">Attendance ID</div>
                                </td>

                                <td>
                                    <div class="record-name"><%= workerFullName %></div>
                                    <div class="record-id">
                                        <%= assignedWorker ? "Worker ID: " + assignedWorker.worker_id : "Worker not available" %>
                                    </div>
                                </td>

                                <td>
                                    <div class="record-name"><%= taskDisplayName %></div>
                                </td>

                                <td class="date">
                                    <%= formatAttendanceDate(record.work_date) %>
                                </td>

                                <td class="time">
                                    <%= formatAttendanceTime(record.time_in) %>
                                </td>

                                <td class="time">
                                    <%= formatAttendanceTime(record.time_out) %>
                                </td>

                                <td class="hours">
                                    <%= formatAttendanceHours(record.hours_worked) %> hrs
                                </td>

                                <td class="money">
                                    ₱<%= formatAttendanceMoney(record.labor_cost) %>
                                </td>

                                <td>
                                    <div class="actions">
                                        <a
                                            class="action-link edit-link"
                                            href="/attendance/edit/<%= record.attendance_id %>"
                                            title="Edit attendance record"
                                        >
                                            <span>✎</span>
                                            Edit
                                        </a>

                                        <form
                                            method="POST"
                                            action="/attendance/delete/<%= record.attendance_id %>"
                                            onsubmit="return confirm('Are you sure you want to delete this attendance record?');"
                                        >
                                            <button
                                                type="submit"
                                                class="action-link delete-link"
                                                title="Delete attendance record"
                                            >
                                                <span>⌫</span>
                                                Delete
