                overflow: visible;
            }

            table {
                min-width: 0;
                font-size: 9px;
            }

            th,
            td {
                padding: 8px;
            }

            body {
                background: white;
            }
        }
    </style>
</head>

<body>

<%
    const attendanceRows = typeof attendance !== "undefined" && Array.isArray(attendance)
        ? attendance
        : [];

    const formatAttendanceMoney = function(value) {
        return (Number(value) || 0).toLocaleString("en-PH", {
            minimumFractionDigits: 2,
            maximumFractionDigits: 2
        });
    };

    const formatAttendanceHours = function(value) {
        return (Number(value) || 0).toLocaleString("en-PH", {
            maximumFractionDigits: 2
        });
    };

    const formatAttendanceDate = function(value) {
        if (!value) return "N/A";

        const date = new Date(value);

        if (isNaN(date.getTime())) return "N/A";

        return date.toLocaleDateString("en-PH", {
            year: "numeric",
            month: "short",
            day: "numeric",
            timeZone: "UTC"
        });
    };

    const formatAttendanceTime = function(value) {
        if (!value) return "N/A";

        if (value instanceof Date) {
            return value.toLocaleTimeString("en-PH", {
                hour: "2-digit",
                minute: "2-digit",
                hour12: true
            });
        }

        const timeString = String(value);

        if (/^\d{2}:\d{2}(:\d{2})?$/.test(timeString)) {
            const parts = timeString.split(":");
            const hour = Number(parts[0]);
            const minute = parts[1];
            const suffix = hour >= 12 ? "PM" : "AM";
            const displayHour = hour % 12 || 12;

            return displayHour + ":" + minute + " " + suffix;
        }

        return timeString;
    };

    const attendanceTotalHours = attendanceRows.reduce(function(sum, record) {
        return sum + (Number(record.hours_worked) || 0);
    }, 0);

    const attendanceTotalLaborCost = attendanceRows.reduce(function(sum, record) {
        return sum + (Number(record.labor_cost) || 0);
    }, 0);
%>

