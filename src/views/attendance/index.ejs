</div>

<script>
    const mainLayout = document.getElementById("mainLayout");
    const menuToggle = document.getElementById("menuToggle");
    const mobileOverlay = document.getElementById("mobileOverlay");
    const sidebar = document.getElementById("sidebar");

    function isMobileScreen() {
        return window.matchMedia("(max-width: 768px)").matches;
    }

    function updateMenuAccessibility() {
        const expanded = isMobileScreen()
            ? mainLayout.classList.contains("mobile-menu-open")
            : !mainLayout.classList.contains("sidebar-collapsed");

        menuToggle.setAttribute("aria-expanded", String(expanded));
    }

    function closeMobileMenu() {
        mainLayout.classList.remove("mobile-menu-open");
        updateMenuAccessibility();
    }

    menuToggle.addEventListener("click", function() {
        if (isMobileScreen()) {
            mainLayout.classList.toggle("mobile-menu-open");
        } else {
            mainLayout.classList.toggle("sidebar-collapsed");
        }

        updateMenuAccessibility();
    });

    mobileOverlay.addEventListener("click", closeMobileMenu);

    sidebar.querySelectorAll("a").forEach(function(link) {
        link.addEventListener("click", function() {
            if (isMobileScreen()) {
                closeMobileMenu();
            }
        });
    });

    document.addEventListener("keydown", function(event) {
        if (event.key === "Escape") {
            closeMobileMenu();
        }
    });

    window.addEventListener("resize", function() {
        if (!isMobileScreen()) {
            mainLayout.classList.remove("mobile-menu-open");
        }

        updateMenuAccessibility();
    });

    /* Print attendance */

    const printButton = document.getElementById("printButton");

    if (printButton) {
        printButton.addEventListener("click", function() {
            window.print();
        });
    }

    /* Live attendance search */

    const attendanceSearch = document.getElementById("attendanceSearch");
    const attendanceTable = document.getElementById("attendanceTable");
    const attendanceRows = Array.from(
        document.querySelectorAll("#attendanceTableBody .attendance-row")
    );

    const emptyState = document.getElementById("emptyState");
    const emptyStateHeading = document.getElementById("emptyStateHeading");
    const emptyStateMessage = document.getElementById("emptyStateMessage");
    const emptyAddButton = document.getElementById("emptyAddButton");
    const visibleCount = document.getElementById("visibleCount");
    const visibleCountText = document.getElementById("visibleCountText");

    function filterAttendance() {
        const query = attendanceSearch.value.trim().toLowerCase();
        let count = 0;

        attendanceRows.forEach(function(row) {
            const matches = row.textContent.toLowerCase().includes(query);

            row.style.display = matches ? "" : "none";

            if (matches) {
                count++;
            }
        });

        visibleCount.textContent = count;

        if (visibleCountText) {
            visibleCountText.textContent =
                "Showing " + count + " of " +
                attendanceRows.length + " attendance records";
        }

        attendanceTable.style.display = count > 0 ? "table" : "none";
        emptyState.style.display = count === 0 ? "block" : "none";

        if (count === 0 && attendanceRows.length === 0) {
            emptyStateHeading.textContent = "No attendance records yet";
            emptyStateMessage.textContent =
                "Record worker attendance to start tracking hours and labor costs.";
            emptyAddButton.style.display = "inline-flex";
        } else if (count === 0) {
            emptyStateHeading.textContent = "No attendance records found";
            emptyStateMessage.textContent =
                "Try another search to find the attendance record you need.";
            emptyAddButton.style.display = "none";
        }
    }

    attendanceSearch.addEventListener("input", filterAttendance);

    filterAttendance();
    updateMenuAccessibility();
</script>

</body>
</html>