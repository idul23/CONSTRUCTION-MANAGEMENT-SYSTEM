
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Add Attendance | Construction MS</title>

    <style>
        :root {
            --navy: #142b4a;
            --navy-light: #203e63;
            --orange: #f28c28;
            --white: #ffffff;
            --background: #f3f5f9;
            --border: #e1e6ed;
            --text: #263445;
            --muted: #758195;
            --red: #c93636;
        }

        * {
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background: var(--background);
            color: var(--text);
            font-size: 14px;
        }

        a {
            text-decoration: none;
        }

        .header {
            background: var(--navy);
            color: var(--white);
            padding: 18px 4%;
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 18px;
            box-shadow: 0 3px 12px rgba(20, 43, 74, 0.14);
        }

        .brand {
            font-size: 21px;
            font-weight: 800;
            letter-spacing: 0.5px;
            color: var(--white);
            white-space: nowrap;
        }

        .brand span {
            color: var(--orange);
        }

        .header-nav {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .dashboard-button {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-height: 40px;
            padding: 10px 18px;
            border-radius: 7px;
            background: var(--orange);
            color: var(--white);
            font-weight: 700;
            font-size: 13px;
            transition: background 0.2s ease, transform 0.2s ease,
                box-shadow 0.2s ease;
        }

        .dashboard-button:hover {
            background: #df7618;
            color: var(--white);
            transform: translateY(-2px);
            box-shadow: 0 4px 10px rgba(242, 140, 40, 0.25);
        }

        .dashboard-button:focus-visible,
        .button:focus-visible,
        input:focus-visible,
        select:focus-visible {
            outline: 3px solid #ffad5c;
            outline-offset: 2px;
        }

        .container {
            max-width: 1000px;
            margin: 32px auto;
            padding: 0 24px;
        }

        .breadcrumb {
            display: flex;
            align-items: center;
            flex-wrap: wrap;
            gap: 9px;
            margin-bottom: 22px;
            color: var(--muted);
            font-size: 13px;
        }

        .breadcrumb a {
            color: var(--navy);
            font-weight: 700;
            transition: color 0.2s ease;
        }

        .breadcrumb a:hover {
            color: var(--orange);
        }

        .breadcrumb-separator {
            color: #aab3c0;
        }

        .page-heading {
            margin-bottom: 24px;
        }

        .page-heading h1 {
            margin: 0 0 9px;
            color: var(--navy);
            font-size: 29px;
            line-height: 1.3;
            font-weight: 800;
        }

        .page-heading p {
            margin: 0;
            color: var(--muted);
            font-size: 14px;
            line-height: 1.6;
        }

        .form-box {
            background: var(--white);
            border: 1px solid var(--border);
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 4px 15px rgba(20, 43, 74, 0.07);
        }

        .form-header {
            padding: 22px 28px;
            color: var(--white);
            background: linear-gradient(
                135deg,
                var(--navy),
                var(--navy-light)
            );
            border-bottom: 4px solid var(--orange);
        }

        .form-header h2 {
            margin: 0 0 7px;
            color: var(--white);
            font-size: 20px;
            line-height: 1.4;
        }

        .form-header p {
            margin: 0;
            color: #d9e3ef;
            font-size: 13px;
            line-height: 1.6;
        }

        .form-content {
            padding: 28px;
        }

        .section-title {
            display: flex;
            align-items: center;
            gap: 10px;
            margin: 0 0 22px;
            padding-bottom: 12px;
            border-bottom: 1px solid var(--border);
            color: var(--navy);
            font-size: 15px;
            font-weight: 800;
        }

        .section-title::before {
            content: "";
            display: block;
            width: 4px;
            height: 19px;
            flex-shrink: 0;
            background: var(--orange);
            border-radius: 3px;
        }

        .form-grid {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 20px 22px;
        }

        .form-group {
            min-width: 0;
        }

        .form-group.full-width {
            grid-column: 1 / -1;
        }

        label {
            display: block;
            margin-bottom: 8px;
            color: var(--navy);
            font-size: 13px;
            font-weight: 700;
        }

        .required {
            color: var(--red);
            margin-left: 3px;
        }

        input,
        select {
            display: block;
            width: 100%;
            min-height: 44px;
            padding: 11px 13px;
            margin: 0;
            border: 1px solid #d5dce6;
            border-radius: 7px;
            background: var(--white);
            color: var(--text);
            font-family: Arial, sans-serif;
            font-size: 14px;
            transition: border-color 0.2s ease, box-shadow 0.2s ease,
                background 0.2s ease;
        }

        input:hover,
        select:hover {
            border-color: #aab7c8;
        }

        input:focus,
        select:focus {
            outline: none;
            border-color: var(--orange);
            box-shadow: 0 0 0 3px rgba(242, 140, 40, 0.13);
        }

        input::placeholder {
            color: #9aa4b2;
        }

        .field-hint {
            margin: 7px 0 0;
            color: var(--muted);
            font-size: 12px;
            line-height: 1.5;
        }

        .error {
            margin-bottom: 22px;
            padding: 13px 15px;
            color: #922b35;
            background: #fff0f0;
            border: 1px solid #f1c7ca;
            border-left: 4px solid var(--red);
            border-radius: 7px;
            font-size: 13px;
            line-height: 1.6;
        }

        .notice {
            margin-bottom: 20px;
            padding: 15px 16px;
            color: #80501c;
            background: #fff7ed;
            border: 1px solid #f4d3ad;
            border-radius: 8px;
            line-height: 1.6;
        }

        .notice strong {
            display: block;
            margin-bottom: 5px;
            color: #704314;
        }

        .no-assignments {
            margin: 0;
            color: var(--muted);
            font-weight: 700;
        }

        .form-actions {
            display: flex;
            align-items: center;
            justify-content: flex-end;
            flex-wrap: wrap;
            gap: 12px;
            margin-top: 30px;
            padding-top: 22px;
            border-top: 1px solid var(--border);
        }

        .button {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            min-height: 44px;
            padding: 12px 20px;
            border: 1px solid transparent;
            border-radius: 7px;
            font-family: Arial, sans-serif;
            font-size: 14px;
            font-weight: 700;
            cursor: pointer;
            transition: background 0.2s ease, color 0.2s ease,
                border-color 0.2s ease, transform 0.2s ease,
                box-shadow 0.2s ease;
        }

        .button-primary {
            background: var(--orange);
            color: var(--white);
            border-color: var(--orange);
        }

        .button-primary:hover {
            background: #df7618;
            color: var(--white);
            border-color: #df7618;
            transform: translateY(-2px);
            box-shadow: 0 4px 10px rgba(242, 140, 40, 0.22);
        }

        .button-secondary {
            background: var(--white);
            color: var(--navy);
            border-color: #d5dce6;
        }

        .button-secondary:hover {
            background: var(--navy);
            color: var(--white);
            border-color: var(--navy);
            transform: translateY(-2px);
            box-shadow: 0 4px 10px rgba(20, 43, 74, 0.15);
        }

        .button:disabled {
            opacity: 0.7;
            cursor: not-allowed;
            transform: none;
            box-shadow: none;
        }

        @media (max-width: 900px) {
            .header {
                align-items: flex-start;
            }

            .header-nav {
                width: 100%;
            }
        }

        @media (max-width: 600px) {
            .header {
                padding: 17px 18px;
            }

            .brand {
                font-size: 19px;
            }

            .header-nav {
                width: 100%;
            }

            .dashboard-button {
                width: 100%;
            }

            .container {
                margin: 22px auto;
                padding: 0 14px;
            }

            .breadcrumb {
                margin-bottom: 18px;
            }

            .page-heading {
                margin-bottom: 20px;
            }

            .page-heading h1 {
                font-size: 25px;
            }

            .form-header {
                padding: 20px;
            }

            .form-content {
                padding: 20px;
            }

            .form-grid {
                grid-template-columns: 1fr;
                gap: 18px;
            }

            .form-group.full-width {
                grid-column: auto;
            }

            .form-actions {
                flex-direction: column-reverse;
                align-items: stretch;
            }

            .form-actions .button {
                width: 100%;
            }
        }

        @media (prefers-reduced-motion: reduce) {
            *,
            *::before,
            *::after {
                scroll-behavior: auto !important;
                transition: none !important;
                animation: none !important;
            }
        }
    </style>
</head>

<body>
    <header class="header">
        <a href="/dashboard" class="brand">
            CONSTRUCTION <span>MS</span>
        </a>

        <nav class="header-nav">
            <a href="/dashboard" class="dashboard-button">
                Dashboard
            </a>
        </nav>
    </header>

    <main class="container">
        <nav class="breadcrumb" aria-label="Breadcrumb">
            <a href="/dashboard">Dashboard</a>
            <span class="breadcrumb-separator">/</span>
            <a href="/attendance">Attendance</a>
            <span class="breadcrumb-separator">/</span>
            <span>Add Attendance</span>
        </nav>

        <section class="page-heading">
            <h1>Add Attendance</h1>
            <p>Record a worker's attendance, work date, time in, time out, and hours worked.</p>
        </section>

        <section class="form-box">
            <div class="form-header">
                <h2>Attendance Information</h2>
                <p>Complete the fields below to record attendance for a task assignment.</p>
            </div>

            <div class="form-content">
                <% if (error) { %>
                    <div class="error" role="alert">
                        <%= error %>
                    </div>
                <% } %>

                <% if (assignments.length === 0) { %>
                    <div class="notice">
                        <strong class="no-assignments">No task assignments found.</strong>
                        Assign a worker to a task first before adding attendance.
                    </div>

                    <div class="form-actions">
                        <a href="/attendance" class="button button-secondary">
                            Cancel
                        </a>
                    </div>
                <% } else { %>

                    <form action="/attendance/add" method="POST" id="attendanceForm">
                        <h3 class="section-title">Attendance Details</h3>

                        <div class="form-grid">
                            <div class="form-group full-width">
                                <label for="assignment_id">
                                    Worker and Task <span class="required">*</span>
                                </label>

                                <select
                                    id="assignment_id"
                                    name="assignment_id"
                                    required
                                >
                                    <option value="">Select Worker and Task</option>

                                    <% assignments.forEach(assignment => { %>
                                        <option value="<%= assignment.assignment_id %>">
                                            <% if (assignment.Worker) { %>
                                                <%= assignment.Worker.first_name %>
                                                <%= assignment.Worker.last_name %>
                                            <% } else { %>
                                                No Worker
                                            <% } %>
                                            -
                                            <% if (assignment.Task) { %>
                                                <%= assignment.Task.task_name %>
                                            <% } else { %>
                                                No Task
                                            <% } %>
                                        </option>
                                    <% }) %>
                                </select>

                                <p class="field-hint">Select the worker and task for this attendance record.</p>
                            </div>

                            <div class="form-group">
                                <label for="work_date">
                                    Work Date <span class="required">*</span>
                                </label>

                                <input
                                    type="date"
                                    id="work_date"
                                    name="work_date"
                                    required
                                >

                                <p class="field-hint">Choose the date the worker performed the task.</p>
                            </div>

                            <div class="form-group">
                                <label for="hours_worked">
                                    Hours Worked <span class="required">*</span>
                                </label>

                                <input
                                    type="number"
                                    id="hours_worked"
                                    name="hours_worked"
                                    min="0"
                                    step="0.01"
                                    value="8"
                                    required
                                >

                                <p class="field-hint">Enter the total hours worked.</p>
                            </div>

                            <div class="form-group">
                                <label for="time_in">Time In</label>

                                <input
                                    type="time"
                                    id="time_in"
                                    name="time_in"
                                >

                                <p class="field-hint">Enter the worker's start time, if available.</p>
                            </div>

                            <div class="form-group">
                                <label for="time_out">Time Out</label>

                                <input
                                    type="time"
                                    id="time_out"
                                    name="time_out"
                                >

                                <p class="field-hint">Enter the worker's end time, if available.</p>
                            </div>
                        </div>

                        <div class="form-actions">
                            <a href="/attendance" class="button button-secondary">
                                Cancel
                            </a>

                            <button type="submit" class="button button-primary" id="submitButton">
                                Add Attendance
                            </button>
                        </div>
                    </form>

                <% } %>
            </div>
        </section>
    </main>

    <script>
        const attendanceForm = document.getElementById('attendanceForm');
        const submitButton = document.getElementById('submitButton');

        if (attendanceForm && submitButton) {
            attendanceForm.addEventListener('submit', function (event) {
                if (!attendanceForm.checkValidity()) {
                    event.preventDefault();
                    attendanceForm.reportValidity();
                    return;
                }

                submitButton.disabled = true;
                submitButton.textContent = 'Adding Attendance...';
            });
        }
    </script>
</body>
</html>
