<!DOCTYPE html>
<html>
<head>
    <title>Expenses</title>
</head>
<body>

    <p>
        <a href="/dashboard">← Back to Dashboard</a>
        |
        <a href="/expenses/add">+ Add Expense</a>
    </p>

    <h1>Expenses</h1>

    <% if (expenses.length === 0) { %>

        <p>No expense records found.</p>

    <% } else { %>

        <table border="1" cellpadding="8" cellspacing="0">

            <thead>
                <tr>
                    <th>ID</th>
                    <th>Project</th>
                    <th>Category</th>
                    <th>Amount</th>
                    <th>Description</th>
                    <th>Expense Date</th>
                    <th>Actions</th>
                </tr>
            </thead>

            <tbody>

                <% expenses.forEach(expense => { %>

                    <tr>

                        <td>
                            <%= expense.expense_id %>
                        </td>

                        <td>
                            <%= expense.project
                                ? expense.project.project_name
                                : "Unknown Project" %>
                        </td>

                        <td>
                            <%= expense.category %>
                        </td>

                        <td>
                            ₱<%= Number(expense.amount || 0).toLocaleString(
                                "en-PH",
                                { minimumFractionDigits: 2 }
                            ) %>
                        </td>

                        <td>
                            <%= expense.description || "" %>
                        </td>

                        <td>
                            <%= expense.expense_date %>
                        </td>

                        <td>
                            <a href="/expenses/edit/<%= expense.expense_id %>">
                                Edit
                            </a>

                            |

                            <a
                                href="/expenses/delete/<%= expense.expense_id %>"
                                onclick="return confirm('Are you sure you want to delete this expense?');"
                            >
                                Delete
                            </a>
                        </td>

                    </tr>

                <% }) %>

            </tbody>

        </table>

    <% } %>

</body>
</html>