<!DOCTYPE html>

<html>

<head>
    <title>Equipment</title>
</head>

<body>

<p>
    <a href="/dashboard">← Back to Dashboard</a>

    <% if (
        user.role_name === "Administrator" ||
        user.role_name === "Project Manager"
    ) { %>

        |
        <a href="/equipment/add">+ Add Equipment</a>

    <% } %>
</p>

<h1>Equipment</h1>

<% if (equipment.length === 0) { %>

    <p>No equipment records found.</p>

<% } else { %>

    <table border="1" cellpadding="8" cellspacing="0">

        <thead>
            <tr>
                <th>ID</th>
                <th>Name</th>
                <th>Type</th>
                <th>Serial No.</th>
                <th>Daily Rate</th>
                <th>Condition</th>

                <% if (
                    user.role_name === "Administrator" ||
                    user.role_name === "Project Manager"
                ) { %>

                    <th>Actions</th>

                <% } %>

            </tr>
        </thead>

        <tbody>

            <% equipment.forEach(item => { %>

                <tr>

                    <td>
                        <%= item.equipment_id %>
                    </td>

                    <td>
                        <%= item.name %>
                    </td>

                    <td>
                        <%= item.equip_type %>
                    </td>

                    <td>
                        <%= item.serial_no || "N/A" %>
                    </td>

                    <td>
                        ₱<%= Number(item.daily_rate || 0).toLocaleString("en-PH", {
                            minimumFractionDigits: 2
                        }) %>
                    </td>

                    <td>
                        <%= item.condition || "N/A" %>
                    </td>

                    <% if (
                        user.role_name === "Administrator" ||
                        user.role_name === "Project Manager"
                    ) { %>

                        <td>

                            <a href="/equipment/edit/<%= item.equipment_id %>">
                                Edit
                            </a>

                            |

                            <a
                                href="/equipment/delete/<%= item.equipment_id %>"
                                onclick="return confirm('Are you sure you want to delete this equipment?');"
                            >
                                Delete
                            </a>

                        </td>

                    <% } %>

                </tr>

            <% }) %>

        </tbody>

    </table>

<% } %>

</body>

</html>
