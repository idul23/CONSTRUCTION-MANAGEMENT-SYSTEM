<!DOCTYPE html>

<html>

<head>
    <title>Material Usage</title>
</head>

<body>


<p>
    <a href="/dashboard">← Back to Dashboard</a>

    <% if (user.role_name === "Administrator" || user.role_name === "Site Staff") { %>
        |
        <a href="/material-usage/add">+ Add Material Usage</a>
    <% } %>
</p>

<h1>Material Usage</h1>

<% if (usage.length === 0) { %>

    <p>No material usage records found.</p>

<% } else { %>

    <table border="1" cellpadding="8" cellspacing="0">

        <thead>
            <tr>
                <th>ID</th>
                <th>Task</th>
                <th>Material</th>
                <th>Quantity Used</th>
                <th>Unit Cost</th>
                <th>Total Cost</th>
                <th>Usage Date</th>

                <% if (user.role_name === "Administrator" || user.role_name === "Site Staff") { %>
                    <th>Actions</th>
                <% } %>

            </tr>
        </thead>

        <tbody>

            <% usage.forEach(record => { %>

                <tr>

                    <td>
                        <%= record.usage_id %>
                    </td>

                    <td>
                        <%= record.task ? record.task.task_name : "Unknown Task" %>
                    </td>

                    <td>
                        <%= record.material ? record.material.name : "Unknown Material" %>
                    </td>

                    <td>
                        <%= record.quantity_used %>
                    </td>

                    <td>
                        ₱<%= Number(record.cost_snapshot || 0).toLocaleString("en-PH", {
                            minimumFractionDigits: 2
                        }) %>
                    </td>

                    <td>
                        ₱<%= (
                            Number(record.quantity_used || 0) *
                            Number(record.cost_snapshot || 0)
                        ).toLocaleString("en-PH", {
                            minimumFractionDigits: 2
                        }) %>
                    </td>

                    <td>
                        <%= record.usage_date %>
                    </td>

                    <% if (user.role_name === "Administrator" || user.role_name === "Site Staff") { %>

                        <td>

                            <a href="/material-usage/edit/<%= record.usage_id %>">
                                Edit
                            </a>

                            |

                            <a
                                href="/material-usage/delete/<%= record.usage_id %>"
                                onclick="return confirm('Are you sure you want to delete this record?');"
                            >
                                Delete
                            </a>

                        </td>

                    <% } %>

                </tr>

            <% }) %>

        </tbody>

    </table>

<% } %>


</body>

</html>
