
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Material Usage | Construction MS</title>

    <style>
        :root {
            --navy: #142b4a;
            --navy-light: #203e63;
            --orange: #f28c28;
            --white: #ffffff;
            --background: #f3f5f9;
            --border: #e1e6ed;
            --text: #263445;
            --muted: #758195;
            --red: #c93636;
            --orange-hover: #df7618;
            --shadow: 0 4px 15px rgba(20, 43, 74, 0.07);
        }

        * {
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background: var(--background);
            color: var(--text);
            font-size: 14px;
        }

        a {
            color: inherit;
            text-decoration: none;
        }

        .topbar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 18px;
            padding: 18px 4%;
            background: var(--navy);
            color: var(--white);
            box-shadow: 0 3px 12px rgba(20, 43, 74, 0.14);
        }

        .brand {
            font-size: 21px;
            font-weight: 800;
            letter-spacing: 0.5px;
            white-space: nowrap;
        }

        .brand span {
            color: var(--orange);
        }

        .header-actions {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .dashboard-button {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-height: 40px;
            padding: 10px 18px;
            background: var(--orange);
            color: var(--white);
            border: 1px solid var(--orange);
            border-radius: 7px;
            font-size: 13px;
            font-weight: 700;
            transition: background 0.2s ease, transform 0.2s ease,
                        box-shadow 0.2s ease;
        }

        .dashboard-button:hover {
            background: var(--orange-hover);
            border-color: var(--orange-hover);
            transform: translateY(-2px);
            box-shadow: 0 4px 10px rgba(242, 140, 40, 0.25);
        }

        .dashboard-button:focus-visible,
        .button:focus-visible {
            outline: 3px solid #ffad5c;
            outline-offset: 3px;
        }

        .container {
            width: 100%;
            max-width: 1000px;
            margin: 32px auto;
            padding: 0 24px;
        }

        .breadcrumb {
            display: flex;
            align-items: center;
            flex-wrap: wrap;
            gap: 10px;
            margin-bottom: 22px;
            color: var(--muted);
            font-size: 13px;
        }

        .breadcrumb a {
            color: var(--navy);
            font-weight: 600;
            transition: color 0.2s ease;
        }

        .breadcrumb a:hover {
            color: var(--orange);
        }

        .breadcrumb-separator {
            color: #aab3c0;
        }

        .page-heading {
            margin-bottom: 24px;
        }

        .page-heading h1 {
            margin: 0 0 9px;
            color: var(--navy);
            font-size: 29px;
            font-weight: 800;
            line-height: 1.25;
        }

        .page-heading p {
            margin: 0;
            color: var(--muted);
            font-size: 14px;
            line-height: 1.6;
        }

        .form-box {
            overflow: hidden;
            background: var(--white);
            border: 1px solid var(--border);
            border-radius: 12px;
            box-shadow: var(--shadow);
        }

        .form-header {
            padding: 22px 28px;
            background: linear-gradient(135deg, var(--navy), var(--navy-light));
            color: var(--white);
            border-bottom: 4px solid var(--orange);
        }

        .form-header h2 {
            margin: 0 0 7px;
            font-size: 20px;
            font-weight: 700;
            line-height: 1.35;
        }

        .form-header p {
            margin: 0;
            color: #d9e3f0;
            font-size: 13px;
            line-height: 1.6;
        }

        .form-content {
            padding: 28px;
        }

        .error {
            margin-bottom: 24px;
            padding: 13px 15px;
            color: #9f2525;
            background: #fff0f0;
            border: 1px solid #f0caca;
            border-left: 4px solid var(--red);
            border-radius: 7px;
            font-size: 13px;
            line-height: 1.6;
            overflow-wrap: anywhere;
        }

        .section-title {
            margin: 0 0 20px;
            padding-bottom: 11px;
            color: var(--navy);
            border-bottom: 1px solid var(--border);
            font-size: 15px;
            font-weight: 800;
        }

        .form-grid {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 20px 22px;
        }

        .form-group {
            min-width: 0;
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .form-group label {
            color: var(--navy);
            font-size: 13px;
            font-weight: 700;
            line-height: 1.4;
        }

        .required {
            color: var(--red);
            margin-left: 3px;
        }

        input,
        select {
            width: 100%;
            min-width: 0;
            min-height: 44px;
            padding: 11px 13px;
            background: var(--white);
            color: var(--text);
            border: 1px solid #d5dce6;
            border-radius: 7px;
            font-family: Arial, sans-serif;
            font-size: 14px;
            outline: none;
            transition: border-color 0.2s ease, box-shadow 0.2s ease,
                        background 0.2s ease;
        }

        input:hover,
        select:hover {
            border-color: #aab7c8;
        }

        input:focus,
        select:focus {
            border-color: var(--orange);
            box-shadow: 0 0 0 3px rgba(242, 140, 40, 0.13);
        }

        input::placeholder {
            color: #a0aaba;
        }

        .field-hint {
            color: var(--muted);
            font-size: 12px;
            line-height: 1.5;
        }

        .form-actions {
            display: flex;
            align-items: center;
            justify-content: flex-end;
            flex-wrap: wrap;
            gap: 12px;
            margin-top: 30px;
            padding-top: 22px;
            border-top: 1px solid var(--border);
        }

        .button {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            min-height: 44px;
            padding: 12px 20px;
            border: 1px solid transparent;
            border-radius: 7px;
            font-family: Arial, sans-serif;
            font-size: 14px;
            font-weight: 700;
            text-align: center;
            cursor: pointer;
            transition: background 0.2s ease, color 0.2s ease,
                        border-color 0.2s ease, transform 0.2s ease,
                        box-shadow 0.2s ease;
        }

        .button:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 10px rgba(20, 43, 74, 0.12);
        }

        .button-primary {
            background: var(--orange);
            color: var(--white);
            border-color: var(--orange);
        }

        .button-primary:hover {
            background: var(--orange-hover);
            border-color: var(--orange-hover);
            box-shadow: 0 4px 10px rgba(242, 140, 40, 0.25);
        }

        .button-secondary {
            background: var(--white);
            color: var(--navy);
            border-color: #d5dce6;
        }

        .button-secondary:hover {
            background: var(--navy);
            color: var(--white);
            border-color: var(--navy);
        }

        @media (max-width: 900px) {
            .topbar {
                align-items: flex-start;
            }

            .header-actions {
                width: 100%;
            }
        }

        @media (max-width: 600px) {
            .topbar {
                padding: 17px 18px;
            }

            .brand {
                font-size: 19px;
            }

            .header-actions {
                width: 100%;
            }

            .dashboard-button {
                width: 100%;
            }

            .container {
                margin: 22px auto;
                padding: 0 14px;
            }

            .breadcrumb {
                gap: 7px;
                margin-bottom: 18px;
                font-size: 12px;
            }

            .page-heading {
                margin-bottom: 20px;
            }

            .page-heading h1 {
                font-size: 25px;
            }

            .page-heading p {
                font-size: 13px;
            }

            .form-header {
                padding: 20px;
            }

            .form-header h2 {
                font-size: 18px;
            }

            .form-content {
                padding: 20px;
            }

            .form-grid {
                grid-template-columns: 1fr;
                gap: 18px;
            }

            .form-actions {
                flex-direction: column-reverse;
                align-items: stretch;
            }

            .form-actions .button {
                width: 100%;
            }
        }

        @media (prefers-reduced-motion: reduce) {
            html {
                scroll-behavior: auto;
            }

            *,
            *::before,
            *::after {
                transition-duration: 0.01ms !important;
                animation-duration: 0.01ms !important;
                animation-iteration-count: 1 !important;
            }
        }
    </style>
</head>

<body>
    <header class="topbar">
        <div class="brand">CONSTRUCTION <span>MS</span></div>

        <div class="header-actions">
            <a href="/dashboard" class="dashboard-button">Dashboard</a>
        </div>
    </header>

    <main class="container">
        <nav class="breadcrumb" aria-label="Breadcrumb">
            <a href="/dashboard">Dashboard</a>
            <span class="breadcrumb-separator">/</span>
            <a href="/material-usage">Material Usage</a>
            <span class="breadcrumb-separator">/</span>
            <span>Edit Material Usage</span>
        </nav>

        <section class="page-heading">
            <h1>Edit Material Usage</h1>
            <p>Update the task, material, quantity, and date for this material usage record.</p>
        </section>

        <section class="form-box">
            <div class="form-header">
                <h2>Material Usage Information</h2>
                <p>Update the details below and save your changes.</p>
            </div>

            <div class="form-content">
                <% if (error) { %>
                    <div class="error"><%= error %></div>
                <% } %>

                <form action="/material-usage/edit/<%= usageRecord.usage_id %>" method="POST">
                    <h3 class="section-title">Task and Material Details</h3>

                    <div class="form-grid">
                        <div class="form-group">
                            <label for="task_id">Task<span class="required">*</span></label>

                            <select id="task_id" name="task_id" required>
                                <% tasks.forEach(task => { %>
                                    <option
                                        value="<%= task.task_id %>"
                                        <%= Number(task.task_id) === Number(usageRecord.task_id) ? "selected" : "" %>
                                    >
                                        <%= task.task_name %>
                                    </option>
                                <% }) %>
                            </select>

                            <span class="field-hint">Select the task associated with this material usage.</span>
                        </div>

                        <div class="form-group">
                            <label for="material_id">Material<span class="required">*</span></label>

                            <select id="material_id" name="material_id" required>
                                <% materials.forEach(material => { %>
                                    <option
                                        value="<%= material.material_id %>"
                                        <%= Number(material.material_id) === Number(usageRecord.material_id) ? "selected" : "" %>
                                    >
                                        <%= material.name %>
                                    </option>
                                <% }) %>
                            </select>

                            <span class="field-hint">Select the material used for this task.</span>
                        </div>
                    </div>

                    <h3 class="section-title" style="margin-top: 30px;">Usage Details</h3>

                    <div class="form-grid">
                        <div class="form-group">
                            <label for="quantity_used">Quantity Used<span class="required">*</span></label>

                            <input
                                type="number"
                                id="quantity_used"
                                name="quantity_used"
                                step="0.01"
                                min="0"
                                value="<%= usageRecord.quantity_used %>"
                                required
                            >

                            <span class="field-hint">Update the quantity of material used.</span>
                        </div>

                        <div class="form-group">
                            <label for="usage_date">Usage Date<span class="required">*</span></label>

                            <input
                                type="date"
                                id="usage_date"
                                name="usage_date"
                                value="<%= usageRecord.usage_date %>"
                                required
                            >

                            <span class="field-hint">Update the date the material was used.</span>
                        </div>
                    </div>

                    <div class="form-actions">
                        <a href="/material-usage" class="button button-secondary">Cancel</a>
                        <button type="submit" class="button button-primary">Update Material Usage</button>
                    </div>
                </form>
            </div>
        </section>
    </main>
</body>
</html>
