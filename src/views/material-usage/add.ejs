<!DOCTYPE html>
<html>
<head>
    <title>Add Material Usage</title>
</head>
<body>

    <p>
        <a href="/material-usage">← Back to Material Usage</a>
    </p>

    <h1>Add Material Usage</h1>

    <% if (error) { %>
        <p><%= error %></p>
    <% } %>

    <% if (tasks.length === 0) { %>
        <p>No tasks found. Please create a task first.</p>
    <% } %>

    <% if (materials.length === 0) { %>
        <p>No materials found. Please create a material first.</p>
    <% } %>

    <form action="/material-usage/add" method="POST">

        <p>
            <label>Task:</label><br>

            <select name="task_id" required>
                <option value="">Select Task</option>

                <% tasks.forEach(task => { %>
                    <option value="<%= task.task_id %>">
                        <%= task.task_name %>
                    </option>
                <% }) %>
            </select>
        </p>

        <p>
            <label>Material:</label><br>

            <select name="material_id" required>
                <option value="">Select Material</option>

                <% materials.forEach(material => { %>
                    <option value="<%= material.material_id %>">
                        <%= material.name %>
                    </option>
                <% }) %>
            </select>
        </p>

        <p>
            <label>Quantity Used:</label><br>
            <input
                type="number"
                name="quantity_used"
                step="0.01"
                min="0"
                required
            >
        </p>

        <p>
            <label>Usage Date:</label><br>
            <input
                type="date"
                name="usage_date"
                required
            >
        </p>

        <button type="submit">Save Material Usage</button>

    </form>

</body>
</html>