<!DOCTYPE html>
<html>
<head>
    <title>Project Phases</title>

    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 30px;
        }

        h1 {
            margin-bottom: 20px;
        }

        a {
            text-decoration: none;
        }

        .top-links {
            margin-bottom: 20px;
        }

        .add-button {
            display: inline-block;
            padding: 10px 15px;
            background: #222;
            color: white;
            margin-left: 15px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 20px;
        }

        th,
        td {
            border: 1px solid #ccc;
            padding: 10px;
            text-align: left;
        }

        th {
            background: #f2f2f2;
        }

        .edit {
            color: blue;
            margin-right: 10px;
        }

        .delete {
            color: red;
        }
    </style>
</head>

<body>

    <div class="top-links">

        <a href="/dashboard">
            ← Back to Dashboard
        </a>

        <a
            class="add-button"
            href="/phases/add"
        >
            + Add Project Phase
        </a>

    </div>


    <h1>Project Phases</h1>


    <% if (phases.length === 0) { %>

        <p>No project phases found.</p>

    <% } else { %>

        <table>

            <thead>

                <tr>
                    <th>ID</th>
                    <th>Project</th>
                    <th>Phase Name</th>
                    <th>Start Date</th>
                    <th>End Date</th>
                    <th>Planned Cost</th>
                    <th>Actions</th>
                </tr>

            </thead>


            <tbody>

                <% phases.forEach(phase => { %>

                    <tr>

                        <td>
                            <%= phase.phase_id %>
                        </td>

                        <td>
                            <%= phase.Project
                                ? phase.Project.project_name
                                : "No Project"
                            %>
                        </td>

                        <td>
                            <%= phase.phase_name %>
                        </td>

                        <td>
                            <%= phase.start_date || "-" %>
                        </td>

                        <td>
                            <%= phase.end_date || "-" %>
                        </td>

                        <td>
                            ₱<%= Number(
                                phase.planned_cost || 0
                            ).toLocaleString(
                                "en-PH",
                                {
                                    minimumFractionDigits: 2
                                }
                            ) %>
                        </td>

                        <td>

                            <a
                                class="edit"
                                href="/phases/edit/<%= phase.phase_id %>"
                            >
                                Edit
                            </a>

                            <a
                                class="delete"
                                href="/phases/delete/<%= phase.phase_id %>"
                                onclick="return confirm('Are you sure you want to delete this project phase?');"
                            >
                                Delete
                            </a>

                        </td>

                    </tr>

                <% }) %>

            </tbody>

        </table>

    <% } %>

</body>
</html>