<!DOCTYPE html>
<html>
<head>
    <title>User Profiles</title>
</head>
<body>

    <p>
        <a href="/dashboard">← Back to Dashboard</a>
        |
        <a href="/user-profiles/add">+ Add User Profile</a>
    </p>

    <h1>User Profiles</h1>

    <% if (profiles.length === 0) { %>

        <p>No user profiles found.</p>

    <% } else { %>

        <table border="1" cellpadding="8" cellspacing="0">

            <thead>
                <tr>
                    <th>ID</th>
                    <th>Username</th>
                    <th>Email</th>
                    <th>First Name</th>
                    <th>Last Name</th>
                    <th>Phone</th>
                    <th>Actions</th>
                </tr>
            </thead>

            <tbody>

                <% profiles.forEach(profile => { %>

                    <tr>

                        <td>
                            <%= profile.profile_id %>
                        </td>

                        <td>
                            <%= profile.User
                                ? profile.User.username
                                : "Unknown" %>
                        </td>

                        <td>
                            <%= profile.User
                                ? profile.User.email
                                : "Unknown" %>
                        </td>

                        <td>
                            <%= profile.first_name %>
                        </td>

                        <td>
                            <%= profile.last_name %>
                        </td>

                        <td>
                            <%= profile.phone || "" %>
                        </td>

                        <td>

                            <a href="/user-profiles/edit/<%= profile.profile_id %>">
                                Edit
                            </a>

                            |

                            <a
                                href="/user-profiles/delete/<%= profile.profile_id %>"
                                onclick="return confirm('Are you sure you want to delete this user profile?');"
                            >
                                Delete
                            </a>

                        </td>

                    </tr>

                <% }) %>

            </tbody>

        </table>

    <% } %>

</body>
</html>