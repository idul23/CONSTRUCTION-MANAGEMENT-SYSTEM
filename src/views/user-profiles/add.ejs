<!DOCTYPE html>
<html>
<head>
    <title>Add User Profile</title>
</head>
<body>

    <p>
        <a href="/user-profiles">← Back to User Profiles</a>
    </p>

    <h1>Add User Profile</h1>

    <% if (error) { %>
        <p><%= error %></p>
    <% } %>

    <form action="/user-profiles/add" method="POST">

        <p>
            <label>User:</label><br>

            <select name="user_id" required>

                <option value="">
                    Select User
                </option>

                <% users.forEach(userRecord => { %>

                    <option value="<%= userRecord.user_id %>">
                        <%= userRecord.username %>
                    </option>

                <% }) %>

            </select>
        </p>

        <p>
            <label>First Name:</label><br>

            <input
                type="text"
                name="first_name"
                maxlength="80"
                required
            >
        </p>

        <p>
            <label>Last Name:</label><br>

            <input
                type="text"
                name="last_name"
                maxlength="80"
                required
            >
        </p>

        <p>
            <label>Phone:</label><br>

            <input
                type="text"
                name="phone"
                maxlength="30"
            >
        </p>

        <button type="submit">
            Save User Profile
        </button>

    </form>

</body>
</html>