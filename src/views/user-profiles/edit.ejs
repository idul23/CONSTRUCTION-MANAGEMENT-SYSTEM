
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit User Profile | Construction MS</title>

    <style>
        :root {
            --navy: #142b4a;
            --navy-light: #203e63;
            --orange: #f28c28;
            --orange-hover: #d97515;
            --white: #ffffff;
            --background: #f3f5f9;
            --border: #e1e6ed;
            --text: #263445;
            --muted: #758195;
            --red: #c93636;
            --shadow: 0 5px 18px rgba(20, 43, 74, 0.08);
        }

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: Arial, Helvetica, sans-serif;
            background: var(--background);
            color: var(--text);
        }

        .topbar {
            background: var(--navy);
            min-height: 68px;
            padding: 0 6%;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 20px;
            box-shadow: 0 3px 12px rgba(20, 43, 74, 0.15);
        }

        .brand {
            color: var(--white);
            font-size: 20px;
            font-weight: 800;
            letter-spacing: 0.5px;
        }

        .brand span {
            color: var(--orange);
        }

        .dashboard-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 11px 22px;
            background: var(--orange);
            color: var(--white);
            text-decoration: none;
            font-size: 14px;
            font-weight: 700;
            border: 2px solid var(--orange);
            border-radius: 8px;
            transition: all 0.2s ease;
        }

        .dashboard-btn:hover {
            background: var(--orange-hover);
            border-color: var(--orange-hover);
            transform: translateY(-2px);
            box-shadow: 0 5px 12px rgba(242, 140, 40, 0.25);
        }

        .container {
            width: 100%;
            max-width: 900px;
            margin: 35px auto;
            padding: 0 22px;
        }

        .breadcrumb {
            margin-bottom: 20px;
            font-size: 14px;
            color: var(--muted);
        }

        .breadcrumb a {
            color: var(--navy-light);
            text-decoration: none;
            font-weight: 600;
        }

        .breadcrumb a:hover {
            color: var(--orange-hover);
            text-decoration: underline;
        }

        .page-heading {
            margin-bottom: 25px;
        }

        .page-heading h1 {
            margin: 0 0 9px;
            color: var(--navy);
            font-size: 29px;
            font-weight: 800;
        }

        .page-heading p {
            margin: 0;
            color: var(--muted);
            font-size: 15px;
            line-height: 1.6;
        }

        .form-card {
            background: var(--white);
            border: 1px solid var(--border);
            border-radius: 13px;
            overflow: hidden;
            box-shadow: var(--shadow);
        }

        .form-header {
            padding: 22px 28px;
            background: linear-gradient(135deg, var(--navy), var(--navy-light));
            border-bottom: 4px solid var(--orange);
        }

        .form-header h2 {
            margin: 0 0 7px;
            color: var(--white);
            font-size: 20px;
        }

        .form-header p {
            margin: 0;
            color: #dce5f0;
            font-size: 13px;
            line-height: 1.5;
        }

        form {
            padding: 28px;
        }

        .form-grid {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 23px 24px;
        }

        .form-group {
            display: flex;
            flex-direction: column;
            min-width: 0;
        }

        .form-group.full-width {
            grid-column: 1 / -1;
        }

        label {
            margin-bottom: 9px;
            color: var(--navy);
            font-size: 14px;
            font-weight: 700;
        }

        .required {
            color: var(--red);
        }

        input[type="text"],
        select {
            width: 100%;
            min-height: 45px;
            padding: 11px 13px;
            background: var(--white);
            color: var(--text);
            font-family: inherit;
            font-size: 14px;
            border: 1px solid var(--border);
            border-radius: 7px;
            outline: none;
            transition: border-color 0.2s ease, box-shadow 0.2s ease;
        }

        input::placeholder {
            color: #9aa4b2;
        }

        input[type="text"]:hover,
        select:hover {
            border-color: var(--orange);
        }

        input[type="text"]:focus,
        select:focus {
            border: 2px solid var(--orange-hover);
            box-shadow: 0 0 0 4px rgba(242, 140, 40, 0.18);
        }

        .field-help {
            margin-top: 7px;
            color: var(--muted);
            font-size: 12px;
            line-height: 1.5;
        }

        .error-message {
            margin-bottom: 23px;
            padding: 13px 15px;
            color: var(--red);
            background: #fff1f1;
            border: 1px solid #f3caca;
            border-left: 4px solid var(--red);
            border-radius: 7px;
            font-size: 14px;
            line-height: 1.5;
        }

        .form-actions {
            display: flex;
            justify-content: flex-end;
            align-items: center;
            gap: 12px;
            margin-top: 30px;
            padding-top: 23px;
            border-top: 1px solid var(--border);
        }

        .btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-height: 43px;
            padding: 11px 21px;
            border-radius: 7px;
            font-family: inherit;
            font-size: 14px;
            font-weight: 700;
            text-decoration: none;
            cursor: pointer;
            transition: all 0.2s ease;
        }

        .btn-primary {
            color: var(--white);
            background: var(--orange);
            border: 1px solid var(--orange);
        }

        .btn-primary:hover {
            background: var(--orange-hover);
            border-color: var(--orange-hover);
            transform: translateY(-1px);
            box-shadow: 0 4px 10px rgba(242, 140, 40, 0.22);
        }

        .btn-secondary {
            color: var(--navy);
            background: var(--white);
            border: 1px solid var(--border);
        }

        .btn-secondary:hover {
            color: var(--white);
            background: var(--navy);
            border-color: var(--navy);
        }

        @media (max-width: 600px) {
            .topbar {
                min-height: 62px;
                padding: 12px 16px;
            }

            .brand {
                font-size: 17px;
            }

            .dashboard-btn {
                padding: 10px 14px;
                font-size: 13px;
            }

            .container {
                margin: 25px auto;
                padding: 0 16px;
            }

            .page-heading h1 {
                font-size: 25px;
            }

            .form-header {
                padding: 20px;
            }

            form {
                padding: 21px 18px;
            }

            .form-grid {
                grid-template-columns: 1fr;
                gap: 20px;
            }

            .form-group.full-width {
                grid-column: auto;
            }

            .form-actions {
                flex-direction: column-reverse;
                align-items: stretch;
            }

            .btn {
                width: 100%;
            }
        }

        @media (prefers-reduced-motion: reduce) {
            *,
            *::before,
            *::after {
                transition: none !important;
                scroll-behavior: auto !important;
            }
        }
    </style>
</head>
<body>

    <header class="topbar">
        <div class="brand">CONSTRUCTION <span>MS</span></div>
        <a href="/dashboard" class="dashboard-btn">Dashboard</a>
    </header>

    <main class="container">

        <div class="breadcrumb">
            <a href="/user-profiles">User Profiles</a>
            <span> / Edit User Profile</span>
        </div>

        <div class="page-heading">
            <h1>Edit User Profile</h1>
            <p>Update the user's personal and contact information.</p>
        </div>

        <section class="form-card">

            <div class="form-header">
                <h2>User Profile Information</h2>
                <p>Review the current details and save your changes.</p>
            </div>

            <form
                action="/user-profiles/edit/<%= profile.profile_id %>"
                method="POST"
            >

                <% if (typeof error !== "undefined" && error) { %>
                    <div class="error-message">
                        <%= error %>
                    </div>
                <% } %>

                <div class="form-grid">

                    <div class="form-group full-width">
                        <label for="user_id">
                            User <span class="required">*</span>
                        </label>

                        <select id="user_id" name="user_id" required>
                            <% users.forEach(userRecord => { %>
                                <option
                                    value="<%= userRecord.user_id %>"
                                    <%= Number(userRecord.user_id) === Number(profile.user_id) ? "selected" : "" %>
                                >
                                    <%= userRecord.username %>
                                </option>
                            <% }) %>
                        </select>

                        <span class="field-help">Choose the account linked to this profile.</span>
                    </div>

                    <div class="form-group">
                        <label for="first_name">
                            First Name <span class="required">*</span>
                        </label>

                        <input
                            type="text"
                            id="first_name"
                            name="first_name"
                            maxlength="80"
                            value="<%= profile.first_name || '' %>"
                            placeholder="Enter first name"
                            required
                        >
                    </div>

                    <div class="form-group">
                        <label for="last_name">
                            Last Name <span class="required">*</span>
                        </label>

                        <input
                            type="text"
                            id="last_name"
                            name="last_name"
                            maxlength="80"
                            value="<%= profile.last_name || '' %>"
                            placeholder="Enter last name"
                            required
                        >
                    </div>

                    <div class="form-group full-width">
                        <label for="phone">Phone Number</label>

                        <input
                            type="text"
                            id="phone"
                            name="phone"
                            maxlength="30"
                            value="<%= profile.phone || '' %>"
                            placeholder="Enter phone number"
                        >

                        <span class="field-help">Optional contact number for the user.</span>
                    </div>

                </div>

                <div class="form-actions">
                    <a href="/user-profiles" class="btn btn-secondary">Cancel</a>
                    <button type="submit" class="btn btn-primary">Update User Profile</button>
                </div>

            </form>
        </section>

    </main>

</body>
</html>
