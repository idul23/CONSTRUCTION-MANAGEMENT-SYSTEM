<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#101e35">
    <title>Dashboard | Construction MS</title>

    <style>
        :root {
            --navy: #142b4a;
            --navy-light: #203e63;
            --navy-dark: #0b1729;
            --orange: #f28c28;
            --orange-light: #ffb45f;
            --bg: #f3f6fb;
            --white: #ffffff;
            --text: #263445;
            --muted: #718096;
            --border: #e4eaf2;
            --green: #167344;
            --red: #b42332;
            --shadow: 0 8px 30px rgba(20,43,74,.065);
            --shadow-hover: 0 18px 40px rgba(20,43,74,.13);
            --radius: 18px;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            font-family: Inter, "Segoe UI", Arial, sans-serif;
            color: var(--text);
            background:
                radial-gradient(ellipse at 95% 0%, rgba(242,140,40,.07), transparent 28%),
                var(--bg);
            min-height: 100vh;
            -webkit-font-smoothing: antialiased;
        }

        a {
            color: inherit;
            text-decoration: none;
        }

        button, input {
            font: inherit;
        }

        button, a {
            -webkit-tap-highlight-color: transparent;
        }

        ::selection {
            background: rgba(242,140,40,.25);
            color: var(--navy);
        }

        /* TOP NAVIGATION */

        .topbar {
            height: 72px;
            padding: 0 28px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 18px;
            position: sticky;
            top: 0;
            z-index: 1000;
            color: white;
            background:
                radial-gradient(circle at 90% -100%, rgba(242,140,40,.23), transparent 40%),
                linear-gradient(110deg, #101e35, #142b4a 60%, #203e63);
            border-bottom: 1px solid rgba(255,255,255,.08);
            box-shadow: 0 5px 24px rgba(8,22,42,.17);
        }

        .topbar::after {
            content: "";
            position: absolute;
            bottom: 0;
            left: 0;
            width: 100%;
            height: 2px;
            background: linear-gradient(90deg, transparent, var(--orange), transparent);
            opacity: .8;
        }

        .topbar-left, .topbar-right {
            display: flex;
            align-items: center;
            gap: 16px;
            min-width: 0;
        }

        .menu-toggle {
            width: 42px;
            height: 42px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            gap: 5px;
            flex-shrink: 0;
            border: 1px solid rgba(255,255,255,.12);
            border-radius: 12px;
            color: white;
            background: rgba(255,255,255,.055);
            cursor: pointer;
            transition: background .25s, border-color .25s, transform .25s;
        }

        .menu-toggle:hover {
            background: rgba(242,140,40,.18);
            border-color: rgba(242,140,40,.6);
            transform: translateY(-2px);
        }

        .menu-toggle:active {
            transform: scale(.94);
        }

        .menu-toggle span {
            width: 19px;
            height: 2px;
            display: block;
            border-radius: 5px;
            background: white;
            transition: transform .25s, width .25s;
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 11px;
            font-size: 19px;
            font-weight: 850;
            letter-spacing: -.5px;
            white-space: nowrap;
        }

        .brand-mark {
            width: 37px;
            height: 37px;
            display: grid;
            place-items: center;
            flex-shrink: 0;
            color: white;
            font-size: 18px;
            border-radius: 11px;
            background: linear-gradient(145deg, var(--orange-light), var(--orange));
            box-shadow: 0 5px 15px rgba(242,140,40,.3);
            transition: transform .3s, box-shadow .3s;
        }

        .brand:hover .brand-mark {
            transform: rotate(-8deg) scale(1.08);
            box-shadow: 0 8px 22px rgba(242,140,40,.4);
        }

        .brand span span {
            color: var(--orange-light);
        }

        .welcome {
            text-align: right;
            font-size: 12px;
            line-height: 1.55;
            color: #c8d3e2;
        }

        .welcome strong {
            display: block;
            color: white;
            font-size: 13px;
            font-weight: 750;
        }

        .role-badge {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            margin-top: 3px;
            padding: 3px 9px;
            border: 1px solid rgba(242,140,40,.25);
            border-radius: 30px;
            background: rgba(242,140,40,.12);
            color: #ffc184;
            font-size: 10px;
            font-weight: 700;
        }

        .role-badge::before {
            content: "";
            width: 5px;
            height: 5px;
            border-radius: 50%;
            background: var(--orange);
            box-shadow: 0 0 8px var(--orange);
        }

        .logout-btn {
            padding: 10px 15px;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            color: white;
            background: rgba(255,255,255,.055);
            border: 1px solid rgba(255,255,255,.17);
            border-radius: 10px;
            font-size: 12px;
            font-weight: 750;
            white-space: nowrap;
            transition: background .25s, border-color .25s, transform .25s, box-shadow .25s;
        }

        .logout-btn:hover {
            background: var(--orange);
            border-color: var(--orange);
            box-shadow: 0 5px 20px rgba(242,140,40,.28);
            transform: translateY(-2px);
        }

        .logout-btn:active {
            transform: scale(.96);
        }

        /* PAGE STRUCTURE */

        .layout {
            display: flex;
            min-height: calc(100vh - 72px);
        }

        .sidebar {
            width: 252px;
            flex: 0 0 252px;
            height: calc(100vh - 72px);
            position: sticky;
            top: 72px;
            overflow-x: hidden;
            overflow-y: auto;
            z-index: 900;
            color: #d7e1ee;
            background:
                radial-gradient(ellipse at 0% 0%, rgba(45,78,119,.4), transparent 42%),
                linear-gradient(180deg, #142b4a, #101e35);
            border-right: 1px solid rgba(255,255,255,.06);
            transition: width .28s ease, flex-basis .28s ease, transform .28s ease;
            scrollbar-width: thin;
            scrollbar-color: #405777 transparent;
        }

        .sidebar-heading {
            padding: 24px 20px 11px;
            color: #8fa5c1;
            font-size: 10px;
            font-weight: 800;
            letter-spacing: 1.6px;
            text-transform: uppercase;
            white-space: nowrap;
        }

        .sidebar-divider {
            height: 1px;
            margin: 13px 16px;
            background: linear-gradient(90deg, rgba(255,255,255,.13), transparent);
        }

        .sidebar-nav {
            padding: 0 11px 24px;
        }

        .nav-link {
            min-height: 45px;
            position: relative;
            display: flex;
            align-items: center;
            gap: 13px;
            padding: 11px 13px;
            margin-bottom: 4px;
            overflow: hidden;
            color: #c8d5e6;
            border: 1px solid transparent;
            border-radius: 11px;
            font-size: 12px;
            font-weight: 600;
            white-space: nowrap;
            transition: background .22s, color .22s, border-color .22s, transform .22s;
        }

        .nav-link:hover {
            color: white;
            background: rgba(255,255,255,.075);
            border-color: rgba(255,255,255,.07);
            transform: translateX(4px);
        }

        .nav-link:active {
            transform: translateX(2px) scale(.99);
        }

        .nav-link.active {
            color: white;
            font-weight: 750;
            background: linear-gradient(105deg, #f28c28, #e77b18);
            border-color: rgba(255,255,255,.13);
            box-shadow: 0 6px 18px rgba(242,140,40,.2);
        }

        .nav-link.active::before {
            content: "";
            position: absolute;
            left: 0;
            top: 10px;
            bottom: 10px;
            width: 3px;
            background: white;
            border-radius: 0 5px 5px 0;
        }

        .nav-icon {
            width: 24px;
            min-width: 24px;
            display: grid;
            place-items: center;
            font-size: 17px;
            line-height: 1;
            transition: transform .25s;
        }

        .nav-link:hover .nav-icon {
            transform: scale(1.15);
        }

        .nav-label {
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .main-content {
            flex: 1;
            min-width: 0;
            padding: 30px;
            animation: contentEnter .45s ease both;
        }

        @keyframes contentEnter {
            from { opacity: 0; transform: translateY(8px); }
            to { opacity: 1; transform: translateY(0); }
        }

        /* PAGE TITLE */

        .page-heading {
            display: flex;
            align-items: flex-end;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 16px;
            margin-bottom: 25px;
        }

        .eyebrow {
            display: flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 9px;
            color: #b96b1b;
            font-size: 10px;
            font-weight: 850;
            letter-spacing: 1.8px;
            text-transform: uppercase;
        }

        .eyebrow::before {
            content: "";
            width: 19px;
            height: 2px;
            border-radius: 3px;
            background: var(--orange);
        }

        .page-heading h1 {
            color: var(--navy);
            font-size: clamp(25px, 3vw, 33px);
            font-weight: 850;
            letter-spacing: -1.1px;
        }

        .page-heading p {
            max-width: 600px;
            margin-top: 8px;
            color: var(--muted);
            font-size: 13px;
            line-height: 1.7;
        }

        .date-label {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            padding: 12px 15px;
            border: 1px solid #e2e8f0;
            border-radius: 12px;
            background: rgba(255,255,255,.88);
            color: #52647a;
            font-size: 12px;
            font-weight: 750;
            box-shadow: 0 5px 18px rgba(20,43,74,.04);
            backdrop-filter: blur(10px);
            transition: transform .3s, box-shadow .3s, border-color .3s;
        }

        .date-label::before {
            content: "▦";
            width: 30px;
            height: 30px;
            display: grid;
            place-items: center;
            border-radius: 9px;
            background: #fff0df;
            color: var(--orange);
            font-size: 17px;
        }

        .date-label:hover {
            transform: translateY(-4px);
            border-color: var(--orange);
            box-shadow: 0 8px 22px rgba(242,140,40,.13);
        }

        /* HERO */

        .dashboard-hero {
            min-height: 220px;
            position: relative;
            isolation: isolate;
            display: flex;
            align-items: center;
            overflow: hidden;
            padding: 35px;
            margin-bottom: 28px;
            color: white;
            border: 1px solid rgba(255,255,255,.15);
            border-radius: 20px;
            background:
                linear-gradient(
                    100deg,
                    rgba(10,24,44,.97) 0%,
                    rgba(20,43,74,.88) 43%,
                    rgba(20,43,74,.48) 100%
                ),
                url("https://images.unsplash.com/photo-1503387762-592deb58ef4e?auto=format&fit=crop&w=1800&q=85")
                center 55% / cover no-repeat;
            box-shadow: 0 15px 35px rgba(20,43,74,.17);
            animation: heroEnter .65s ease both;
            transition: box-shadow .3s, border-color .3s;
        }

        .dashboard-hero:hover {
            border-color: rgba(242,140,40,.45);
            box-shadow: 0 20px 45px rgba(20,43,74,.2);
        }

        @keyframes heroEnter {
            from { opacity: 0; transform: translateY(12px) scale(.99); }
            to { opacity: 1; transform: translateY(0) scale(1); }
        }

        .dashboard-hero::before {
            content: "";
            position: absolute;
            z-index: -1;
            inset: 0;
            background: linear-gradient(90deg, transparent 45%, rgba(255,255,255,.035));
            pointer-events: none;
        }

        .dashboard-hero::after {
            content: "";
            position: absolute;
            z-index: -1;
            right: -85px;
            bottom: -155px;
            width: 330px;
            height: 330px;
            border: 1px solid rgba(255,255,255,.13);
            border-radius: 50%;
            box-shadow:
                0 0 0 25px rgba(255,255,255,.025),
                0 0 0 55px rgba(255,255,255,.02);
            pointer-events: none;
            transition: transform .5s ease;
        }

        .dashboard-hero:hover::after {
            transform: scale(1.08);
        }

        .hero-content {
            max-width: 600px;
        }

        .hero-eyebrow {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 15px;
            padding: 7px 11px;
            color: #ffc184;
            background: rgba(242,140,40,.13);
            border: 1px solid rgba(242,140,40,.27);
            border-radius: 30px;
            font-size: 10px;
            font-weight: 850;
            letter-spacing: 1.2px;
            text-transform: uppercase;
        }

        .hero-eyebrow::before {
            content: "";
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background: var(--orange-light);
            box-shadow: 0 0 10px var(--orange);
            animation: pulseDot 2s infinite;
        }

        @keyframes pulseDot {
            0%, 100% { box-shadow: 0 0 0 0 rgba(242,140,40,.45); }
            50% { box-shadow: 0 0 0 6px rgba(242,140,40,0); }
        }

        .hero-content h2 {
            margin-bottom: 12px;
            color: white;
            font-size: clamp(26px, 3.3vw, 39px);
            line-height: 1.18;
            font-weight: 850;
            letter-spacing: -1.1px;
        }

        .hero-content h2 span {
            color: var(--orange-light);
        }

        .hero-content p {
            max-width: 500px;
            color: #d9e3f0;
            font-size: 13px;
            line-height: 1.85;
        }

        .hero-highlight {
            color: #ffc184;
            font-weight: 800;
        }

        /* SECTION LABELS */

        .section-label {
            display: flex;
            align-items: center;
            gap: 11px;
            margin-bottom: 16px;
            color: var(--navy);
            font-size: 15px;
            font-weight: 850;
        }

        .section-label::before {
            content: "";
            width: 4px;
            height: 19px;
            border-radius: 5px;
            background: var(--orange);
            transition: height .25s;
        }

        .section-label:hover::before {
            height: 25px;
        }

        /* KPI CARDS */

        .stats {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 18px;
            margin-bottom: 32px;
        }

        .stat-card {
            position: relative;
            isolation: isolate;
            min-width: 0;
            overflow: hidden;
            padding: 22px;
            background: linear-gradient(145deg, #ffffff 0%, #fbfcff 100%);
            border: 1px solid rgba(226,234,244,.95);
            border-radius: 17px;
            box-shadow: 0 5px 18px rgba(20,43,74,.045);
            transition:
                transform .3s cubic-bezier(.2,.8,.2,1),
                border-color .3s,
                box-shadow .3s;
            animation: cardEnter .5s ease both;
        }

        .stat-card:nth-child(2) { animation-delay: .04s; }
        .stat-card:nth-child(3) { animation-delay: .08s; }
        .stat-card:nth-child(4) { animation-delay: .12s; }
        .stat-card:nth-child(5) { animation-delay: .16s; }
        .stat-card:nth-child(6) { animation-delay: .20s; }

        @keyframes cardEnter {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .stat-card::before {
            content: "";
            position: absolute;
            z-index: -1;
            left: 0;
            top: 0;
            width: 100%;
            height: 3px;
            background: linear-gradient(90deg, var(--orange), #ffd09d, transparent);
            opacity: .75;
            transition: height .25s, opacity .25s;
        }

        .stat-card::after {
            content: "";
            position: absolute;
            z-index: -1;
            right: -50px;
            bottom: -65px;
            width: 145px;
            height: 145px;
            border-radius: 50%;
            background: radial-gradient(circle, rgba(242,140,40,.09), transparent 70%);
            transition: transform .35s;
        }

        .stat-card:hover {
            transform: translateY(-10px) scale(1.015);
            border-color: var(--orange);
            box-shadow:
                0 12px 25px rgba(20,43,74,.10),
                0 20px 40px rgba(242,140,40,.17);
            z-index: 2;
        }

        .stat-card:hover::before {
            height: 4px;
            opacity: 1;
        }

        .stat-card:hover::after {
            transform: scale(1.35);
        }

        .stat-card:active {
            transform: translateY(-3px) scale(1.005);
        }

        .stat-top {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            margin-bottom: 20px;
        }

        .stat-label {
            color: #687a91;
            font-size: 12px;
            font-weight: 750;
            line-height: 1.5;
        }

        .stat-icon {
            width: 45px;
            height: 45px;
            flex-shrink: 0;
            display: grid;
            place-items: center;
            color: var(--orange);
            background: linear-gradient(145deg, #fff5e9, #ffe7ce);
            border: 1px solid #ffead5;
            border-radius: 13px;
            font-size: 22px;
            box-shadow: 0 5px 13px rgba(242,140,40,.08);
            transition: transform .3s, background .3s, color .3s, box-shadow .3s;
        }

        .stat-card:hover .stat-icon {
            color: white;
            background: linear-gradient(145deg, #ffad56, #e77b18);
            box-shadow: 0 7px 18px rgba(242,140,40,.25);
            transform: rotate(-7deg) scale(1.12);
        }

        .stat-card h2 {
            overflow-wrap: anywhere;
            color: var(--navy);
            font-size: clamp(25px, 2.3vw, 32px);
            font-weight: 850;
            letter-spacing: -1px;
            line-height: 1.2;
        }

        .stat-note {
            margin-top: 9px;
            color: #8794a6;
            font-size: 11px;
            line-height: 1.6;
        }

        .stat-note::before {
            content: "";
            display: inline-block;
            width: 5px;
            height: 5px;
            margin-right: 7px;
            vertical-align: 2px;
            border-radius: 50%;
            background: #cbd5e1;
        }

        /* PANELS */

        .section-grid {
            display: grid;
            grid-template-columns: minmax(0, 1fr);
            gap: 24px;
        }

        .panel {
            min-width: 0;
            overflow: hidden;
            background: rgba(255,255,255,.96);
            border: 1px solid #e3eaf3;
            border-radius: 17px;
            box-shadow: 0 6px 23px rgba(20,43,74,.045);
            transition:
                transform .3s cubic-bezier(.2,.8,.2,1),
                box-shadow .3s,
                border-color .3s;
        }

        .panel:hover {
            transform: translateY(-6px);
            border-color: rgba(242,140,40,.5);
            box-shadow:
                0 14px 30px rgba(20,43,74,.10),
                0 18px 35px rgba(242,140,40,.08);
        }

        .panel-header {
            position: relative;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            padding: 21px 23px;
            border-bottom: 1px solid #eaf0f6;
            background: linear-gradient(120deg, #fff, #f9fbfe);
        }

        .panel-header::before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            width: 4px;
            height: 100%;
            background: linear-gradient(180deg, var(--orange), #ffc184);
        }

        .panel-title-wrap {
            min-width: 0;
        }

        .panel-header h2 {
            color: var(--navy);
            font-size: 15px;
            font-weight: 850;
            letter-spacing: -.2px;
        }

        .panel-subtitle {
            margin-top: 5px;
            color: #8794a6;
            font-size: 11px;
        }

        .view-all {
            flex-shrink: 0;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 9px 12px;
            border: 1px solid #e1e8f1;
            border-radius: 9px;
            color: var(--navy);
            background: white;
            font-size: 11px;
            font-weight: 800;
            transition: all .25s;
        }

        .view-all::after {
            content: "→";
            color: var(--orange);
            font-size: 15px;
            transition: transform .22s;
        }

        .view-all:hover {
            color: white;
            background: var(--navy);
            border-color: var(--navy);
            box-shadow: 0 5px 14px rgba(20,43,74,.16);
            transform: translateY(-3px);
        }

        .view-all:hover::after {
            color: var(--orange-light);
            transform: translateX(4px);
        }

        .view-all:active {
            transform: scale(.96);
        }

        /* SEARCHABLE TABLES */

        .table-tools {
            padding: 14px 20px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 10px;
            border-bottom: 1px solid #edf1f6;
            background: #fff;
        }

        .table-count {
            color: #8794a6;
            font-size: 11px;
        }

        .table-search {
            width: min(100%, 225px);
            padding: 9px 12px;
            outline: none;
            color: var(--text);
            background: #f8fafc;
            border: 1px solid #e4eaf2;
            border-radius: 9px;
            font-size: 12px;
            transition: border-color .2s, box-shadow .2s, background .2s;
        }

        .table-search:focus {
            background: white;
            border-color: var(--orange);
            box-shadow: 0 0 0 4px rgba(242,140,40,.13);
        }

        .table-wrapper {
            width: 100%;
            overflow-x: auto;
            -webkit-overflow-scrolling: touch;
        }

        table {
            width: 100%;
            min-width: 590px;
            border-collapse: separate;
            border-spacing: 0;
            text-align: left;
            font-size: 12px;
        }

        th {
            padding: 15px 20px;
            color: #728198;
            background: #f5f8fc;
            border-bottom: 1px solid #e7edf5;
            font-size: 10px;
            font-weight: 850;
            letter-spacing: .7px;
            text-transform: uppercase;
            white-space: nowrap;
        }

        td {
            padding: 16px 20px;
            color: #53647a;
            border-bottom: 1px solid #edf1f6;
            vertical-align: middle;
            transition: background .18s;
        }

        tbody tr {
            transition: background .18s, box-shadow .18s;
        }

        tbody tr:last-child td {
            border-bottom: none;
        }

        tbody tr:hover td {
            background: #fff7ed;
        }

        .project-name, .task-name {
            color: var(--navy);
            font-weight: 800;
            transition: color .2s;
        }

        tbody tr:hover .project-name,
        tbody tr:hover .task-name {
            color: #c66b13;
        }

        .empty-state {
            padding: 45px 20px;
            text-align: center;
            color: #8290a4;
            background: radial-gradient(ellipse at center, #fff7ed, #fff 70%);
            font-size: 12px;
            line-height: 1.8;
        }

        .empty-state::before {
            content: "◇";
            display: block;
            margin-bottom: 10px;
            color: var(--orange);
            font-size: 30px;
        }

        .search-empty {
            display: none;
            padding: 25px 20px;
            color: #8290a4;
            text-align: center;
            font-size: 12px;
            background: #fffaf4;
        }

        /* STATUS PILLS */

        .status {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 6px 10px;
            border: 1px solid #e2e8f0;
            border-radius: 30px;
            color: #52647a;
            background: #f3f6fa;
            font-size: 10px;
            font-weight: 800;
            white-space: nowrap;
        }

        .status::before {
            content: "";
            width: 5px;
            height: 5px;
            flex-shrink: 0;
            border-radius: 50%;
            background: currentColor;
        }

        .status.ongoing,
        .status.active,
        .status.in-progress,
        .status.in_progress {
            color: #a95a0c;
            background: #fff3e5;
            border-color: #ffe0bd;
        }

        .status.completed,
        .status.done {
            color: #167344;
            background: #e9f8ef;
            border-color: #ccefd9;
        }

        .status.planned,
        .status.pending,
        .status.not-started,
        .status.not_started {
            color: #3f5f85;
            background: #edf4fc;
            border-color: #d9e7f8;
        }

        .status.cancelled,
        .status.canceled,
        .status.overdue {
            color: #b42332;
            background: #fff0f1;
            border-color: #f8d4d8;
        }

        /* TASK PROGRESS */

        .progress-cell {
            min-width: 135px;
        }

        .progress-top {
            display: flex;
            justify-content: space-between;
            gap: 10px;
            font-size: 11px;
            font-weight: 800;
            color: var(--navy);
        }

        .progress-bar {
            width: 100%;
            height: 6px;
            margin-top: 9px;
            overflow: hidden;
            border-radius: 20px;
            background: #e8edf4;
            box-shadow: inset 0 1px 2px rgba(20,43,74,.05);
        }

        .progress-fill {
            width: 0;
            height: 100%;
            border-radius: 20px;
            background: linear-gradient(90deg, #e77b18, #f28c28, #ffc184);
            box-shadow: 0 0 8px rgba(242,140,40,.22);
            transition: width 1s cubic-bezier(.2,.7,.2,1);
        }

        tr:hover .progress-fill {
            filter: brightness(1.08);
        }

        /* QUICK ACTIONS */

        .quick-section {
            margin-top: 30px;
        }

        .quick-links {
            display: grid;
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: 15px;
        }

        .quick-link {
            position: relative;
            display: flex;
            align-items: center;
            gap: 13px;
            min-height: 82px;
            padding: 17px;
            overflow: hidden;
            border: 1px solid #e3eaf3;
            border-radius: 15px;
            color: var(--navy);
            background: linear-gradient(145deg, #fff, #fafcff);
            box-shadow: 0 5px 17px rgba(20,43,74,.045);
            transition:
                transform .3s cubic-bezier(.2,.8,.2,1),
                background .3s, color .3s, box-shadow .3s, border-color .3s;
        }

        .quick-link::before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 3px;
            background: linear-gradient(90deg, var(--orange), transparent);
            opacity: .55;
            transition: opacity .25s;
        }

        .quick-link::after {
            content: "↗";
            position: absolute;
            right: 14px;
            top: 13px;
            color: #a3afbf;
            font-size: 13px;
            transition: color .25s, transform .25s;
        }

        .quick-link:hover {
            color: white;
            background: linear-gradient(125deg, #203e63, #101e35);
            border-color: var(--orange);
            box-shadow:
                0 12px 25px rgba(20,43,74,.16),
                0 18px 35px rgba(242,140,40,.16);
            transform: translateY(-9px) scale(1.02);
        }

        .quick-link:active {
            transform: translateY(-2px) scale(.99);
        }

        .quick-link:hover::before {
            opacity: 1;
        }

        .quick-link:hover::after {
            color: var(--orange-light);
            transform: translate(3px, -3px);
        }

        .quick-link-icon {
            width: 43px;
            height: 43px;
            flex-shrink: 0;
            display: grid;
            place-items: center;
            border: 1px solid #ffe8d1;
            border-radius: 13px;
            color: var(--orange);
            background: linear-gradient(145deg, #fff5e9, #ffe6ca);
            font-size: 21px;
            transition: transform .3s, background .3s, color .3s;
        }

        .quick-link:hover .quick-link-icon {
            color: #ffc184;
            background: rgba(242,140,40,.17);
            border-color: rgba(242,140,40,.25);
            transform: scale(1.12) rotate(-6deg);
        }

        .quick-link-text {
            padding-right: 8px;
            font-size: 12px;
            font-weight: 850;
            line-height: 1.5;
        }

        /* FOOTER */

        .footer {
            margin-top: 32px;
            padding: 21px 10px 8px;
            border-top: 1px solid #e2e8f0;
            color: #8a97a8;
            text-align: center;
            font-size: 10px;
            letter-spacing: .3px;
        }

        .footer span {
            color: #c06c19;
            font-weight: 800;
        }

        /* COLLAPSIBLE SIDEBAR */

        .layout.sidebar-collapsed .sidebar {
            width: 74px;
            flex-basis: 74px;
        }

        .layout.sidebar-collapsed .sidebar-heading,
        .layout.sidebar-collapsed .sidebar-divider,
        .layout.sidebar-collapsed .nav-label {
            display: none;
        }

        .layout.sidebar-collapsed .sidebar-nav {
            padding: 17px 9px 22px;
        }

        .layout.sidebar-collapsed .nav-link {
            justify-content: center;
            padding: 12px 8px;
        }

        .layout.sidebar-collapsed .nav-icon {
            width: 26px;
            min-width: 26px;
        }

        .layout.sidebar-collapsed .nav-link::after {
            content: attr(data-title);
            position: absolute;
            z-index: 1200;
            top: 50%;
            left: 64px;
            transform: translateY(-50%);
            padding: 9px 12px;
            color: white;
            background: #0b1729;
            border: 1px solid rgba(255,255,255,.12);
            border-radius: 8px;
            font-size: 11px;
            box-shadow: 0 5px 18px rgba(0,0,0,.18);
            opacity: 0;
            visibility: hidden;
            pointer-events: none;
        }

        .layout.sidebar-collapsed .nav-link:hover::after {
            opacity: 1;
            visibility: visible;
        }

        /* ACCESSIBILITY */

        a:focus-visible,
        button:focus-visible,
        input:focus-visible {
            outline: 3px solid rgba(242,140,40,.65);
            outline-offset: 3px;
        }

        /* TABLET */

        @media (min-width: 769px) {
            .section-grid {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }
        }

        @media (max-width: 1200px) {
            .main-content {
                padding: 24px;
            }

            .stats {
                gap: 14px;
            }

            .stat-card {
                padding: 19px;
            }

            .quick-links {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }
        }

        /* MOBILE NAVIGATION */

        .mobile-overlay {
            display: none;
        }

        @media (max-width: 768px) {
            .topbar {
                height: 64px;
                padding: 0 14px;
                gap: 8px;
            }

            .topbar-left, .topbar-right {
                gap: 9px;
            }

            .brand {
                gap: 8px;
                font-size: 16px;
            }

            .brand-mark {
                width: 32px;
                height: 32px;
                font-size: 16px;
            }

            .menu-toggle {
                width: 38px;
                height: 38px;
            }

            .welcome {
                display: none;
            }

            .logout-btn {
                padding: 9px 11px;
                font-size: 11px;
            }

            .layout {
                min-height: calc(100vh - 64px);
            }

            .sidebar {
                position: fixed;
                top: 64px;
                left: 0;
                bottom: 0;
                width: 270px;
                max-width: 85vw;
                height: calc(100vh - 64px);
                transform: translateX(-105%);
                visibility: hidden;
                box-shadow: none;
            }

            .layout.sidebar-collapsed .sidebar {
                width: 270px;
                flex-basis: 270px;
            }

            .layout.sidebar-collapsed .sidebar-heading,
            .layout.sidebar-collapsed .sidebar-divider {
                display: block;
            }

            .layout.sidebar-collapsed .nav-label {
                display: inline;
            }

            .layout.sidebar-collapsed .nav-link {
                justify-content: flex-start;
                padding: 11px 13px;
            }

            .layout.sidebar-collapsed .nav-link::after {
                display: none;
            }

            .layout.mobile-menu-open .sidebar {
                transform: translateX(0);
                visibility: visible;
                box-shadow: 10px 0 35px rgba(5,15,30,.23);
            }

            .mobile-overlay {
                position: fixed;
                top: 64px;
                left: 0;
                right: 0;
                bottom: 0;
                z-index: 800;
                background: rgba(8,18,34,.52);
                backdrop-filter: blur(3px);
            }

            .layout.mobile-menu-open .mobile-overlay {
                display: block;
            }

            .main-content {
                padding: 23px 16px;
            }

            .page-heading {
                align-items: flex-start;
                flex-direction: column;
                margin-bottom: 21px;
            }

            .page-heading h1 {
                font-size: 27px;
            }

            .dashboard-hero {
                min-height: 195px;
                padding: 25px 21px;
                margin-bottom: 23px;
                border-radius: 16px;
                background-position: center;
            }

            .hero-content h2 {
                font-size: 28px;
            }

            .stats {
                gap: 12px;
                margin-bottom: 25px;
            }

            .stat-card {
                padding: 17px;
                border-radius: 14px;
            }

            .stat-top {
                margin-bottom: 15px;
            }

            .stat-icon {
                width: 38px;
                height: 38px;
                font-size: 19px;
                border-radius: 11px;
            }

            .stat-card h2 {
                font-size: 25px;
            }

            .panel {
                border-radius: 14px;
            }

            .panel-header {
                padding: 18px;
            }

            .quick-links {
                gap: 12px;
            }

            .quick-link {
                min-height: 73px;
                padding: 14px;
            }

            .quick-link-icon {
                width: 38px;
                height: 38px;
            }
        }

        @media (max-width: 440px) {
            .stats, .quick-links {
                grid-template-columns: 1fr;
            }

            .main-content {
                padding: 20px 13px;
            }

            .page-heading h1 {
                font-size: 25px;
            }

            .date-label {
                width: 100%;
            }

            .dashboard-hero {
                min-height: 185px;
                padding: 21px 17px;
            }

            .hero-content h2 {
                font-size: 25px;
            }

            .hero-content p {
                font-size: 12px;
            }

            .panel-header h2 {
                font-size: 14px;
            }

            .quick-link {
                min-height: 67px;
            }
        }

        /* TOUCHSCREENS AND REDUCED MOTION */

        @media (hover: none) {
            .stat-card:hover,
            .panel:hover,
            .quick-link:hover,
            .date-label:hover {
                transform: none;
            }

            .stat-card:active,
            .quick-link:active {
                transform: scale(.98);
            }
        }

        @media (prefers-reduced-motion: reduce) {
            html {
                scroll-behavior: auto;
            }

            *, *::before, *::after {
                animation-duration: .01ms !important;
                animation-iteration-count: 1 !important;
                transition-duration: .01ms !important;
            }
        }
    </style>
</head>

<body>

<header class="topbar">
    <div class="topbar-left">
        <button
            type="button"
            class="menu-toggle"
            id="menuToggle"
            aria-label="Toggle navigation menu"
            aria-controls="sidebar"
            aria-expanded="true"
        >
            <span></span>
            <span></span>
            <span></span>
        </button>

        <a href="/dashboard" class="brand">
            <span class="brand-mark">⌂</span>
            <span>Construction <span>MS</span></span>
        </a>
    </div>

    <div class="topbar-right">
        <div class="welcome">
            Welcome back,
            <strong><%= user.username %></strong>
            <span class="role-badge"><%= user.role_name %></span>
        </div>

        <a href="/logout" class="logout-btn">
            <span>↪</span>
            Logout
        </a>
    </div>
</header>

<div class="layout" id="mainLayout">

    <aside class="sidebar" id="sidebar">
        <div class="sidebar-heading">Workspace</div>

        <nav class="sidebar-nav">
            <a href="/dashboard" class="nav-link active" data-title="Dashboard" aria-current="page">
                <span class="nav-icon">⌂</span>
                <span class="nav-label">Dashboard</span>
            </a>

            <a href="/projects" class="nav-link" data-title="Projects">
                <span class="nav-icon">▣</span>
                <span class="nav-label">Projects</span>
            </a>

            <a href="/workers" class="nav-link" data-title="Workers">
                <span class="nav-icon">♟</span>
                <span class="nav-label">Workers</span>
            </a>

            <a href="/worker-skills" class="nav-link" data-title="Worker Skills">
                <span class="nav-icon">✦</span>
                <span class="nav-label">Worker Skills</span>
            </a>

            <a href="/project-members" class="nav-link" data-title="Project Members">
                <span class="nav-icon">♧</span>
                <span class="nav-label">Project Members</span>
            </a>

            <a href="/user-profiles" class="nav-link" data-title="User Profiles">
                <span class="nav-icon">♙</span>
                <span class="nav-label">User Profiles</span>
            </a>

            <div class="sidebar-divider"></div>
            <div class="sidebar-heading">Project Management</div>

            <a href="/tasks" class="nav-link" data-title="Tasks">
                <span class="nav-icon">☑</span>
                <span class="nav-label">Tasks</span>
            </a>

            <a href="/phases" class="nav-link" data-title="Project Phases">
                <span class="nav-icon">▤</span>
                <span class="nav-label">Project Phases</span>
            </a>

            <a href="/assignments" class="nav-link" data-title="Task Assignments">
                <span class="nav-icon">↗</span>
                <span class="nav-label">Task Assignments</span>
            </a>

            <a href="/attendance" class="nav-link" data-title="Attendance">
                <span class="nav-icon">◷</span>
                <span class="nav-label">Attendance</span>
            </a>

            <div class="sidebar-divider"></div>
            <div class="sidebar-heading">Inventory & Resources</div>

            <a href="/materials" class="nav-link" data-title="Materials">
                <span class="nav-icon">▤</span>
                <span class="nav-label">Materials</span>
            </a>

            <a href="/material-usage" class="nav-link" data-title="Material Usage">
                <span class="nav-icon">↗</span>
                <span class="nav-label">Material Usage</span>
            </a>

            <a href="/suppliers" class="nav-link" data-title="Suppliers">
                <span class="nav-icon">♧</span>
                <span class="nav-label">Suppliers</span>
            </a>

            <a href="/equipment" class="nav-link" data-title="Equipment">
                <span class="nav-icon">⚒</span>
                <span class="nav-label">Equipment</span>
            </a>

            <a href="/equipment-usage" class="nav-link" data-title="Equipment Usage">
                <span class="nav-icon">↗</span>
                <span class="nav-label">Equipment Usage</span>
            </a>

            <div class="sidebar-divider"></div>
            <div class="sidebar-heading">Finance & Reports</div>

            <a href="/expenses" class="nav-link" data-title="Expenses">
                <span class="nav-icon">₱</span>
                <span class="nav-label">Expenses</span>
            </a>

            <a href="/reports" class="nav-link" data-title="Reports">
                <span class="nav-icon">▥</span>
                <span class="nav-label">Reports</span>
            </a>

            <% if (user && user.role_name === "Administrator") { %>
                <div class="sidebar-divider"></div>
                <div class="sidebar-heading">Administration</div>

                <a href="/users" class="nav-link" data-title="User Management">
                    <span class="nav-icon">♙</span>
                    <span class="nav-label">User Management</span>
                </a>

                <a href="/audit-logs" class="nav-link" data-title="Audit Logs">
                    <span class="nav-icon">▤</span>
                    <span class="nav-label">Audit Logs</span>
                </a>
            <% } %>
        </nav>
    </aside>

    <div class="mobile-overlay" id="mobileOverlay"></div>

    <main class="main-content">

        <div class="page-heading">
            <div>
                <div class="eyebrow">Management Overview</div>
                <h1>Dashboard</h1>
                <p>
                    Your construction operations, workforce, inventory,
                    and expenses — all in one place.
                </p>
            </div>

            <div class="date-label" id="currentDate"></div>
        </div>

        <section class="dashboard-hero">
            <div class="hero-content">
                <div class="hero-eyebrow">Construction Management System</div>

                <h2>Build Better.<br><span>Manage Smarter.</span></h2>

                <p>
                    Welcome back,
                    <span class="hero-highlight"><%= user.username %></span>.
                    Stay on top of your projects, coordinate your team,
                    and keep your construction operations moving forward.
                </p>
            </div>
        </section>

        <div class="section-label">Project Overview</div>

        <section class="stats">
            <div class="stat-card">
                <div class="stat-top">
                    <div class="stat-label">Total Projects</div>
                    <div class="stat-icon">▣</div>
                </div>
                <h2 class="stat-number" data-value="<%= Number(totalProjects || 0) %>"><%= totalProjects %></h2>
                <div class="stat-note">Projects in the system</div>
            </div>

            <div class="stat-card">
                <div class="stat-top">
                    <div class="stat-label">Active Workers</div>
                    <div class="stat-icon">♟</div>
                </div>
                <h2 class="stat-number" data-value="<%= Number(activeWorkers || 0) %>"><%= activeWorkers %></h2>
                <div class="stat-note">Workers currently active</div>
            </div>

            <div class="stat-card">
                <div class="stat-top">
                    <div class="stat-label">Total Tasks</div>
                    <div class="stat-icon">☑</div>
                </div>
                <h2 class="stat-number" data-value="<%= Number(totalTasks || 0) %>"><%= totalTasks %></h2>
                <div class="stat-note">Tasks recorded in the system</div>
            </div>

            <div class="stat-card">
                <div class="stat-top">
                    <div class="stat-label">Total Materials</div>
                    <div class="stat-icon">▤</div>
                </div>
                <h2 class="stat-number" data-value="<%= Number(totalMaterials || 0) %>"><%= totalMaterials %></h2>
                <div class="stat-note">Materials in inventory</div>
            </div>

            <div class="stat-card">
                <div class="stat-top">
                    <div class="stat-label">Today's Attendance</div>
                    <div class="stat-icon">◷</div>
                </div>
                <h2 class="stat-number" data-value="<%= Number(todayAttendance || 0) %>"><%= todayAttendance %></h2>
                <div class="stat-note">Attendance records for today</div>
            </div>

            <div class="stat-card">
                <div class="stat-top">
                    <div class="stat-label">Total Expenses</div>
                    <div class="stat-icon">₱</div>
                </div>
                <h2 class="stat-number"
                    data-value="<%= Number(totalExpenses || 0) %>"
                    data-format="currency">₱<%= Number(totalExpenses || 0).toLocaleString("en-PH", { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></h2>
                <div class="stat-note">Recorded project expenses</div>
            </div>
        </section>

        <div class="section-label">Recent Activity</div>

        <section class="section-grid">

            <div class="panel">
                <div class="panel-header">
                    <div class="panel-title-wrap">
                        <h2>Recent Projects</h2>
                        <div class="panel-subtitle">Your latest project records</div>
                    </div>
                    <a href="/projects" class="view-all">View All</a>
                </div>

                <div class="table-tools">
                    <span class="table-count" data-count-for="projectsTable">
                        <%= recentProjects ? recentProjects.length : 0 %> project records
                    </span>
                    <input
                        type="search"
                        class="table-search"
                        data-table-search="projectsTable"
                        placeholder="Search projects..."
                        aria-label="Search recent projects"
                    >
                </div>

                <% if (recentProjects && recentProjects.length > 0) { %>
                    <div class="table-wrapper">
                        <table id="projectsTable">
                            <thead>
                                <tr>
                                    <th>Project Name</th>
                                    <th>Location</th>
                                    <th>Budget</th>
                                    <th>Status</th>
                                </tr>
                            </thead>

                            <tbody>
                                <% recentProjects.forEach(project => { %>
                                    <tr>
                                        <td class="project-name"><%= project.project_name %></td>
                                        <td><%= project.location || "Not specified" %></td>
                                        <td>
                                            ₱<%= Number(project.total_budget || 0).toLocaleString("en-PH", { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %>
                                        </td>
                                        <td>
                                            <span class="status <%= String(project.status || "").toLowerCase().replace(/\s+/g, "-") %>">
                                                <%= project.status || "Unknown" %>
                                            </span>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                    <div class="search-empty" data-empty-for="projectsTable">No matching projects found.</div>
                <% } else { %>
                    <div class="empty-state">No projects available yet.</div>
                <% } %>
            </div>

            <div class="panel">
                <div class="panel-header">
                    <div class="panel-title-wrap">
                        <h2>Recent Tasks</h2>
                        <div class="panel-subtitle">Monitor your latest task progress</div>
                    </div>
                    <a href="/tasks" class="view-all">View All</a>
                </div>

                <div class="table-tools">
                    <span class="table-count" data-count-for="tasksTable">
                        <%= recentTasks ? recentTasks.length : 0 %> task records
                    </span>
                    <input
                        type="search"
                        class="table-search"
                        data-table-search="tasksTable"
                        placeholder="Search tasks..."
                        aria-label="Search recent tasks"
                    >
                </div>

                <% if (recentTasks && recentTasks.length > 0) { %>
                    <div class="table-wrapper">
                        <table id="tasksTable">
                            <thead>
                                <tr>
                                    <th>Task Name</th>
                                    <th>Start Date</th>
                                    <th>Due Date</th>
                                    <th>Progress</th>
                                    <th>Status</th>
                                </tr>
                            </thead>

                            <tbody>
                                <% recentTasks.forEach(task => { %>
                                    <tr>
                                        <td class="task-name"><%= task.task_name %></td>

                                        <td>
                                            <%= task.start_date ? new Date(task.start_date).toLocaleDateString("en-PH") : "—" %>
                                        </td>

                                        <td>
                                            <%= task.due_date ? new Date(task.due_date).toLocaleDateString("en-PH") : "—" %>
                                        </td>

                                        <td class="progress-cell">
                                            <div class="progress-top">
                                                <span>Progress</span>
                                                <span><%= Math.min(100, Math.max(0, Number(task.progress_pct || 0))) %>%</span>
                                            </div>

                                            <div class="progress-bar">
                                                <div
                                                    class="progress-fill"
                                                    data-progress="<%= Math.min(100, Math.max(0, Number(task.progress_pct || 0))) %>"
                                                ></div>
                                            </div>
                                        </td>

                                        <td>
                                            <span class="status <%= String(task.status || "").toLowerCase().replace(/\s+/g, "-") %>">
                                                <%= task.status || "Unknown" %>
                                            </span>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                    <div class="search-empty" data-empty-for="tasksTable">No matching tasks found.</div>
                <% } else { %>
                    <div class="empty-state">No tasks available yet.</div>
                <% } %>
            </div>

        </section>

        <section class="quick-section">
            <div class="section-label">Quick Actions</div>

            <div class="quick-links">
                <a href="/projects" class="quick-link">
                    <span class="quick-link-icon">▣</span>
                    <span class="quick-link-text">Manage Projects</span>
                </a>

                <a href="/workers" class="quick-link">
                    <span class="quick-link-icon">♟</span>
                    <span class="quick-link-text">Manage Workers</span>
                </a>

                <a href="/tasks" class="quick-link">
                    <span class="quick-link-icon">☑</span>
                    <span class="quick-link-text">Manage Tasks</span>
                </a>

                <a href="/reports" class="quick-link">
                    <span class="quick-link-icon">▥</span>
                    <span class="quick-link-text">View Reports</span>
                </a>
            </div>
        </section>

        <footer class="footer">
            <span>CONSTRUCTION MS</span>
            &nbsp;·&nbsp; Construction Project and Labor Management System
        </footer>

    </main>
</div>

<script>
    const menuToggle = document.getElementById("menuToggle");
    const mainLayout = document.getElementById("mainLayout");
    const mobileOverlay = document.getElementById("mobileOverlay");
    const sidebar = document.getElementById("sidebar");

    function isMobileScreen() {
        return window.matchMedia("(max-width: 768px)").matches;
    }

    function updateMenuAccessibility() {
        const expanded = isMobileScreen()
            ? mainLayout.classList.contains("mobile-menu-open")
            : !mainLayout.classList.contains("sidebar-collapsed");

        menuToggle.setAttribute("aria-expanded", String(expanded));
    }

    function closeMobileMenu() {
        mainLayout.classList.remove("mobile-menu-open");
        updateMenuAccessibility();
    }

    menuToggle.addEventListener("click", function () {
        if (isMobileScreen()) {
            mainLayout.classList.toggle("mobile-menu-open");
        } else {
            mainLayout.classList.toggle("sidebar-collapsed");
        }

        updateMenuAccessibility();
    });

    mobileOverlay.addEventListener("click", closeMobileMenu);

    sidebar.querySelectorAll("a").forEach(function (link) {
        link.addEventListener("click", function () {
            if (isMobileScreen()) {
                closeMobileMenu();
            }
        });
    });

    document.addEventListener("keydown", function (event) {
        if (event.key === "Escape") {
            closeMobileMenu();
        }
    });

    window.addEventListener("resize", function () {
        if (!isMobileScreen()) {
            mainLayout.classList.remove("mobile-menu-open");
        }

        updateMenuAccessibility();
    });

    /* Animate KPI numbers on initial load */
    document.querySelectorAll(".stat-number[data-value]").forEach(function (element) {
        const target = Number(element.dataset.value);

        if (!Number.isFinite(target)) return;

        const isCurrency = element.dataset.format === "currency";
        const duration = 850;
        const startTime = performance.now();

        function animateNumber(now) {
            const elapsed = Math.min((now - startTime) / duration, 1);
            const eased = 1 - Math.pow(1 - elapsed, 3);
            const current = target * eased;

            if (isCurrency) {
                element.textContent = "₱" + current.toLocaleString("en-PH", {
                    minimumFractionDigits: 2,
                    maximumFractionDigits: 2
                });
            } else {
                element.textContent = Math.round(current).toLocaleString("en-PH");
            }

            if (elapsed < 1) {
                requestAnimationFrame(animateNumber);
            }
        }

        requestAnimationFrame(animateNumber);
    });

    /* Animate task progress bars */
    document.querySelectorAll(".progress-fill[data-progress]").forEach(function (bar) {
        const progress = Math.min(100, Math.max(0, Number(bar.dataset.progress) || 0));

        requestAnimationFrame(function () {
            bar.style.width = progress + "%";
        });
    });

    /* Display today's date */
    const dateElement = document.getElementById("currentDate");

    dateElement.textContent = new Date().toLocaleDateString("en-PH", {
        weekday: "short",
        year: "numeric",
        month: "long",
        day: "numeric"
    });

    /* Search projects and tasks with live counts */
    document.querySelectorAll("[data-table-search]").forEach(function (input) {
        input.addEventListener("input", function () {
            const tableId = input.dataset.tableSearch;
            const table = document.getElementById(tableId);

            if (!table) return;

            const query = input.value.trim().toLowerCase();
            const rows = Array.from(table.querySelectorAll("tbody tr"));
            let visibleCount = 0;

            rows.forEach(function (row) {
                const matches = row.textContent.toLowerCase().includes(query);

                row.style.display = matches ? "" : "none";

                if (matches) visibleCount++;
            });

            const countElement = document.querySelector(
                '[data-count-for="' + tableId + '"]'
            );

            if (countElement) {
                const label = tableId === "projectsTable" ? "project" : "task";
                countElement.textContent =
                    visibleCount + " of " + rows.length + " " + label + " records";
            }

            const emptyElement = document.querySelector(
                '[data-empty-for="' + tableId + '"]'
            );

            if (emptyElement) {
                emptyElement.style.display =
                    rows.length > 0 && visibleCount === 0 ? "block" : "none";
            }
        });
    });

    updateMenuAccessibility();
</script>

</body>
</html>