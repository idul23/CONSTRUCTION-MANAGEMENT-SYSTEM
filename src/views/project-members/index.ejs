<!DOCTYPE html>
<html>
<head>
    <title>Project Members</title>
</head>
<body>

    <p>
        <a href="/dashboard">← Back to Dashboard</a>
        |
        <a href="/project-members/add">+ Add Project Member</a>
    </p>

    <h1>Project Members</h1>

    <% if (projectMembers.length === 0) { %>

        <p>No project members found.</p>

    <% } else { %>

        <table border="1" cellpadding="8" cellspacing="0">

            <thead>
                <tr>
                    <th>Project</th>
                    <th>User</th>
                    <th>Project Role</th>
                    <th>Assigned Date</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>

            <tbody>

                <% projectMembers.forEach(projectMember => { %>

                    <tr>

                        <td>
                            <%= projectMember.Project
                                ? projectMember.Project.project_name
                                : "Unknown" %>
                        </td>

                        <td>
                            <%= projectMember.User
                                ? projectMember.User.username
                                : "Unknown" %>
                        </td>

                        <td>
                            <%= projectMember.project_role %>
                        </td>

                        <td>
                            <%= projectMember.assigned_date %>
                        </td>

                        <td>
                            <%= projectMember.is_active
                                ? "Active"
                                : "Inactive" %>
                        </td>

                        <td>

                            <a href="/project-members/edit/<%= projectMember.project_id %>/<%= projectMember.user_id %>">
                                Edit
                            </a>

                            |

                            <a
                                href="/project-members/delete/<%= projectMember.project_id %>/<%= projectMember.user_id %>"
                                onclick="return confirm('Are you sure you want to delete this project member?');"
                            >
                                Delete
                            </a>

                        </td>

                    </tr>

                <% }) %>

            </tbody>

        </table>

    <% } %>

</body>
</html>