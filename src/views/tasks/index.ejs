            color: #8a97a8;
            text-align: center;
            font-size: 10px;
            letter-spacing: .3px;
        }

        .footer span {
            color: #c06c19;
            font-weight: 800;
        }

        .layout.sidebar-collapsed .sidebar {
            width: 74px;
            flex-basis: 74px;
        }

        .layout.sidebar-collapsed .sidebar-heading,
        .layout.sidebar-collapsed .sidebar-divider,
        .layout.sidebar-collapsed .nav-label {
            display: none;
        }

        .layout.sidebar-collapsed .sidebar-nav {
            padding: 17px 9px 22px;
        }

        .layout.sidebar-collapsed .nav-link {
            justify-content: center;
            padding: 12px 8px;
        }

        .layout.sidebar-collapsed .nav-icon {
            width: 26px;
            min-width: 26px;
        }

        .layout.sidebar-collapsed .nav-link::after {
            content: attr(data-title);
            position: absolute;
            z-index: 1200;
            top: 50%;
            left: 64px;
            transform: translateY(-50%);
            padding: 9px 12px;
            color: white;
            background: #0b1729;
            border: 1px solid rgba(255,255,255,.12);
            border-radius: 8px;
            font-size: 11px;
            box-shadow: 0 5px 18px rgba(0,0,0,.18);
            opacity: 0;
            visibility: hidden;
            pointer-events: none;
        }

        .layout.sidebar-collapsed .nav-link:hover::after {
            opacity: 1;
            visibility: visible;
        }

        .mobile-overlay {
            display: none;
        }

        a:focus-visible,
        button:focus-visible,
        input:focus-visible {
            outline: 3px solid rgba(242,140,40,.65);
            outline-offset: 3px;
        }

        @media (max-width: 1200px) {
            .main-content {
                padding: 24px;
            }

            .stats {
                grid-template-columns: repeat(2, minmax(0, 1fr));
                gap: 14px;
            }

            .stat-card {
                padding: 19px;
            }
        }

        @media (max-width: 768px) {
            .topbar {
                height: 64px;
                padding: 0 14px;
                gap: 8px;
            }

            .topbar-left,
            .topbar-right {
                gap: 9px;
            }

            .brand {
                gap: 8px;
                font-size: 16px;
            }

            .brand-mark {
                width: 32px;
                height: 32px;
                font-size: 16px;
            }

            .menu-toggle {
                width: 38px;
                height: 38px;
            }

            .welcome {
                display: none;
            }

            .logout-btn {
                padding: 9px 11px;
                font-size: 11px;
            }

            .layout {
                min-height: calc(100vh - 64px);
            }

            .sidebar {
                position: fixed;
                top: 64px;
                left: 0;
                bottom: 0;
                width: 270px;
                max-width: 85vw;
                height: calc(100vh - 64px);
                transform: translateX(-105%);
                visibility: hidden;
                box-shadow: none;
            }

            .layout.sidebar-collapsed .sidebar {
                width: 270px;
                flex-basis: 270px;
            }

            .layout.sidebar-collapsed .sidebar-heading,
            .layout.sidebar-collapsed .sidebar-divider {
                display: block;
            }

            .layout.sidebar-collapsed .nav-label {
                display: inline;
            }

            .layout.sidebar-collapsed .nav-link {
                justify-content: flex-start;
                padding: 11px 13px;
            }

            .layout.sidebar-collapsed .nav-link::after {
                display: none;
            }

            .layout.mobile-menu-open .sidebar {
                transform: translateX(0);
                visibility: visible;
                box-shadow: 10px 0 35px rgba(5,15,30,.23);
            }

            .mobile-overlay {
                position: fixed;
                top: 64px;
                left: 0;
                right: 0;
                bottom: 0;
                z-index: 800;
                background: rgba(8,18,34,.52);
                backdrop-filter: blur(3px);
            }

            .layout.mobile-menu-open .mobile-overlay {
                display: block;
            }

            .main-content {
                padding: 23px 16px;
            }

            .page-heading {
                align-items: flex-start;
                flex-direction: column;
                margin-bottom: 23px;
            }

            .heading-actions {
                width: 100%;
            }

            .heading-actions .btn {
                flex: 1;
            }

            .page-heading h1 {
                font-size: 28px;
            }

            .stats {
                gap: 12px;
                margin-bottom: 25px;
            }

            .stat-card {
                padding: 17px;
                border-radius: 14px;
            }

            .stat-top {
                margin-bottom: 15px;
            }

            .stat-icon {
                width: 38px;
                height: 38px;
                font-size: 19px;
                border-radius: 11px;
            }

            .stat-number {
                font-size: 27px;
            }

            .panel {
                border-radius: 14px;
            }

            .panel-header {
                padding: 18px;
            }

            .table-tools {
                padding: 14px 16px;
            }

            .search-box {
                width: 100%;
            }
        }

        @media (max-width: 440px) {
            .stats {
                grid-template-columns: 1fr;
            }

            .main-content {
                padding: 20px 13px;
            }

            .page-heading h1 {
                font-size: 26px;
            }

            .heading-actions {
                flex-direction: column;
            }

            .heading-actions .btn {
                width: 100%;
                flex: auto;
            }

            .stat-card {
                padding: 18px;
            }

            .panel-header {
                align-items: flex-start;
                flex-direction: column;
            }

            .record-count-badge {
                align-self: flex-start;
            }
        }

        @media (hover: none) {
            .stat-card:hover {
                transform: none;
            }

            .btn:active,
            .action-link:active {
                transform: scale(.98);
            }
        }

        @media (prefers-reduced-motion: reduce) {
            html {
                scroll-behavior: auto;
            }

            *,
            *::before,
            *::after {
                animation-duration: .01ms !important;
                animation-iteration-count: 1 !important;
                transition-duration: .01ms !important;
            }
        }

        @media print {
            .topbar,
            .sidebar,
            .mobile-overlay,
            .heading-actions,
            .table-tools,
            .actions,
            .footer {
                display: none !important;
            }

            .layout {
                display: block;
            }

            .main-content {
                padding: 0;
            }

            .panel,
            .stat-card {
                box-shadow: none;
                break-inside: avoid;
            }

            .table-wrapper {
                overflow: visible;
            }

            table {
                min-width: 0;
                font-size: 9px;
            }

            th,
            td {
                padding: 8px;
            }

            body {
                background: white;
            }
        }
    </style>
</head>

<body>

<%
    const taskRows = typeof tasks !== "undefined" && Array.isArray(tasks)
        ? tasks
        : [];

    const getTaskStatus = function(task) {
        return String(task.status || "Pending").trim().toLowerCase().replace(/[_-]+/g, " ");
    };

    const taskCompletedCount = taskRows.filter(function(task) {
        return getTaskStatus(task) === "completed";
    }).length;

    const taskProgressCount = taskRows.filter(function(task) {
        return ["in progress", "ongoing"].includes(getTaskStatus(task));
    }).length;

    const taskPendingCount = taskRows.filter(function(task) {
        return ["pending", "planned", "not started"].includes(getTaskStatus(task));
    }).length;

    const formatTaskDate = function(value) {
        if (!value) return "N/A";

        const date = new Date(value);

        if (isNaN(date.getTime())) return "N/A";

        return date.toLocaleDateString("en-PH", {
            year: "numeric",
            month: "short",
            day: "numeric",
            timeZone: "UTC"
        });
    };

    const getTaskProgress = function(task) {
        const value = Number(task.progress_pct);
        return Math.max(0, Math.min(100, Number.isFinite(value) ? value : 0));
    };

    const getTaskStatusClass = function(task) {
        const status = getTaskStatus(task);

        if (status === "completed") return "badge-completed";

        if (["in progress", "ongoing"].includes(status)) {
            return "badge-progress";
        }

        if (["cancelled", "canceled"].includes(status)) {
            return "badge-cancelled";
        }

        return "badge-pending";
    };
%>

<header class="topbar">
    <div class="topbar-left">
        <button
            type="button"
            class="menu-toggle"
            id="menuToggle"
            aria-label="Toggle navigation menu"
            aria-controls="sidebar"
            aria-expanded="true"
        >
            <span></span>
            <span></span>
            <span></span>
        </button>

        <a href="/dashboard" class="brand">
            <span class="brand-mark">⌂</span>
            <span>Construction <span>MS</span></span>
        </a>
    </div>

    <div class="topbar-right">
        <div class="welcome">
            Welcome back,
            <strong><%= typeof user !== "undefined" && user ? user.username : "User" %></strong>
            <span class="role-badge"><%= typeof user !== "undefined" && user ? user.role_name : "" %></span>
        </div>

        <a href="/logout" class="logout-btn">
            <span>↪</span>
            Logout
        </a>
    </div>
</header>

<div class="layout" id="mainLayout">

    <aside class="sidebar" id="sidebar">
        <div class="sidebar-heading">Workspace</div>

        <nav class="sidebar-nav">
            <a href="/dashboard" class="nav-link" data-title="Dashboard">
                <span class="nav-icon">⌂</span>
                <span class="nav-label">Dashboard</span>
            </a>

            <a href="/projects" class="nav-link" data-title="Projects">
                <span class="nav-icon">▣</span>
                <span class="nav-label">Projects</span>
            </a>

            <a href="/workers" class="nav-link" data-title="Workers">
                <span class="nav-icon">♟</span>
                <span class="nav-label">Workers</span>
            </a>

            <a href="/worker-skills" class="nav-link" data-title="Worker Skills">
                <span class="nav-icon">✦</span>
                <span class="nav-label">Worker Skills</span>
            </a>

            <a href="/project-members" class="nav-link" data-title="Project Members">
                <span class="nav-icon">♧</span>
                <span class="nav-label">Project Members</span>
            </a>

            <a href="/user-profiles" class="nav-link" data-title="User Profiles">
                <span class="nav-icon">♙</span>
                <span class="nav-label">User Profiles</span>
            </a>

            <div class="sidebar-divider"></div>
            <div class="sidebar-heading">Project Operations</div>

            <a href="/tasks" class="nav-link active" data-title="Tasks" aria-current="page">
                <span class="nav-icon">☑</span>
                <span class="nav-label">Tasks</span>
            </a>

            <a href="/project-phases" class="nav-link" data-title="Project Phases">
                <span class="nav-icon">▤</span>
                <span class="nav-label">Project Phases</span>
            </a>

            <a href="/assignments" class="nav-link" data-title="Assignments">
                <span class="nav-icon">↗</span>
                <span class="nav-label">Assignments</span>
            </a>

            <a href="/attendance" class="nav-link" data-title="Attendance">
                <span class="nav-icon">◷</span>
                <span class="nav-label">Attendance</span>
            </a>

            <div class="sidebar-divider"></div>
            <div class="sidebar-heading">Inventory & Resources</div>

            <a href="/materials" class="nav-link" data-title="Materials">
                <span class="nav-icon">▤</span>
                <span class="nav-label">Materials</span>
            </a>

            <a href="/material-usage" class="nav-link" data-title="Material Usage">
                <span class="nav-icon">↗</span>
                <span class="nav-label">Material Usage</span>
            </a>

            <a href="/suppliers" class="nav-link" data-title="Suppliers">
                <span class="nav-icon">♧</span>
                <span class="nav-label">Suppliers</span>
            </a>

            <a href="/equipment" class="nav-link" data-title="Equipment">
                <span class="nav-icon">⚒</span>
                <span class="nav-label">Equipment</span>
            </a>

            <a href="/equipment-usage" class="nav-link" data-title="Equipment Usage">
                <span class="nav-icon">↗</span>
                <span class="nav-label">Equipment Usage</span>
            </a>

            <div class="sidebar-divider"></div>
            <div class="sidebar-heading">Finance & Reports</div>

            <a href="/expenses" class="nav-link" data-title="Expenses">
                <span class="nav-icon">₱</span>
                <span class="nav-label">Expenses</span>
            </a>

            <a href="/reports" class="nav-link" data-title="Reports">
                <span class="nav-icon">▥</span>
                <span class="nav-label">Reports</span>
            </a>

            <% if (typeof user !== "undefined" && user && user.role_name === "Administrator") { %>
                <div class="sidebar-divider"></div>
                <div class="sidebar-heading">Administration</div>

                <a href="/users" class="nav-link" data-title="Users">
                    <span class="nav-icon">♙</span>
                    <span class="nav-label">Users</span>
                </a>

                <a href="/audit-logs" class="nav-link" data-title="Audit Logs">
                    <span class="nav-icon">▤</span>
                    <span class="nav-label">Audit Logs</span>
                </a>
            <% } %>
        </nav>
    </aside>

    <div class="mobile-overlay" id="mobileOverlay"></div>

    <main class="main-content">

        <div class="page-heading">
            <div class="heading-copy">
                <div class="eyebrow">Project Operations</div>
                <h1>Task Management</h1>
                <p>Manage project tasks, deadlines, statuses, and progress.</p>
            </div>

            <div class="heading-actions">
                <button type="button" class="btn btn-secondary" id="printButton">
                    <span>▤</span>
                    Print Tasks
                </button>

                <a href="/tasks/add" class="btn btn-primary">
                    <span>＋</span>
                    Add Task
                </a>
            </div>
        </div>

        <div class="section-label">Task Overview</div>

        <section class="stats">
            <div class="stat-card">
                <div class="stat-top">
                    <div class="stat-label">Total Tasks</div>
                    <div class="stat-icon">☑</div>
                </div>
                <h2 class="stat-number"><%= taskRows.length %></h2>
                <div class="stat-note">All registered tasks</div>
            </div>

            <div class="stat-card">
                <div class="stat-top">
                    <div class="stat-label">Completed Tasks</div>
                    <div class="stat-icon">✓</div>
                </div>
                <h2 class="stat-number"><%= taskCompletedCount %></h2>
                <div class="stat-note">Successfully completed</div>
            </div>

            <div class="stat-card">
                <div class="stat-top">
                    <div class="stat-label">In Progress</div>
                    <div class="stat-icon">◷</div>
                </div>
                <h2 class="stat-number"><%= taskProgressCount %></h2>
                <div class="stat-note">Tasks currently underway</div>
            </div>

            <div class="stat-card">
                <div class="stat-top">
                    <div class="stat-label">Pending Tasks</div>
                    <div class="stat-icon">▤</div>
                </div>
                <h2 class="stat-number"><%= taskPendingCount %></h2>
                <div class="stat-note">Tasks waiting to start</div>
            </div>
        </section>

        <div class="section-label">Task Records</div>

        <section class="panel">

            <div class="panel-header">
                <div class="panel-title-wrap">
                    <h2>All Tasks</h2>
                    <div class="panel-subtitle">
                        View, search, and manage your construction project tasks
                    </div>
                </div>

                <span class="record-count-badge">
                    <%= taskRows.length %> Total Records
                </span>
            </div>

            <div class="table-tools">
                <span class="table-count" id="tableCount">
                    Showing <%= taskRows.length %> task records
                </span>

                <label class="search-box">
                    <span class="search-icon">⌕</span>
                    <input
                        type="search"
                        id="taskSearch"
                        placeholder="Search tasks..."
                        aria-label="Search tasks"
                    >
                </label>
            </div>

            <div class="table-wrapper">
                <table id="tasksTable">
                    <thead>
                        <tr>
                            <th>Task ID</th>
                            <th>Task Name</th>
                            <th>Project</th>
                            <th>Phase</th>
                            <th>Start Date</th>
                            <th>Due Date</th>
                            <th>Progress</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>

                    <tbody id="tasksTableBody">
                        <% taskRows.forEach(function(task) {
                            const phaseRecord = task.ProjectPhase || task.projectPhase || {};
                            const projectRecord = phaseRecord.Project || phaseRecord.project || {};

                            const projectName = task.project_name ||
                                projectRecord.project_name ||
                                "No Project";

                            const phaseName = phaseRecord.phase_name ||
                                task.phase_name ||
                                "No Phase";

                            const progress = getTaskProgress(task);
                            const statusText = task.status || "Pending";
                        %>
                            <tr class="task-row">
                                <td>
                                    <span class="record-id">#<%= task.task_id %></span>
                                </td>

                                <td>
                                    <div class="record-name">
                                        <%= task.task_name || "Unnamed Task" %>
                                    </div>
                                </td>

                                <td>
                                    <div class="record-name"><%= projectName %></div>
                                </td>

                                <td><%= phaseName %></td>

                                <td class="date">
                                    <%= formatTaskDate(task.start_date) %>
                                </td>

                                <td class="date">
                                    <%= formatTaskDate(task.due_date) %>
                                </td>

                                <td>
                                    <div class="progress-label"><%= progress %>%</div>
                                    <div class="progress-track">
                                        <div
                                            class="progress-fill"
                                            style="width: <%= progress %>%"
                                        ></div>
                                    </div>
                                </td>

                                <td>
                                    <span class="badge <%= getTaskStatusClass(task) %>">
                                        <%= statusText %>
                                    </span>
                                </td>

                                <td>
                                    <div class="actions">
                                        <a
                                            class="action-link edit-link"
                                            href="/tasks/edit/<%= task.task_id %>"
                                            title="Edit task"
                                            aria-label="Edit task <%= task.task_name || task.task_id %>"
                                        >
                                            <span>✎</span>
                                            Edit
                                        </a>

                                        <a
                                            class="action-link delete-link"
                                            href="/tasks/delete/<%= task.task_id %>"
                                            title="Delete task"
                                            aria-label="Delete task <%= task.task_name || task.task_id %>"
                                            onclick="return confirm('Are you sure you want to delete this task?');"
                                        >
                                            <span>×</span>
                                            Delete
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>

            <div class="empty-state" id="emptyState">
                <div class="empty-icon">☑</div>
                <h3 id="emptyStateHeading">No tasks found</h3>
                <p id="emptyStateMessage">Try another search or add a new task.</p>

                <a href="/tasks/add" class="btn btn-primary" id="emptyAddButton">
                    <span>＋</span>
                    Add Task
                </a>
            </div>

            <div class="table-footer">
                Showing <strong id="visibleCount"><%= taskRows.length %></strong>
                of <strong><%= taskRows.length %></strong> task record(s)
            </div>

        </section>

        <footer class="footer">
            <span>CONSTRUCTION MS</span>
            &nbsp;·&nbsp; Construction Project and Labor Management System
        </footer>

    </main>
</div>

<script>
    const mainLayout = document.getElementById("mainLayout");
    const menuToggle = document.getElementById("menuToggle");
    const mobileOverlay = document.getElementById("mobileOverlay");
    const sidebar = document.getElementById("sidebar");

    function isMobileScreen() {
        return window.matchMedia("(max-width: 768px)").matches;
    }

    function updateMenuAccessibility() {
        const expanded = isMobileScreen()
            ? mainLayout.classList.contains("mobile-menu-open")
            : !mainLayout.classList.contains("sidebar-collapsed");

        menuToggle.setAttribute("aria-expanded", String(expanded));
    }

    function closeMobileMenu() {
        mainLayout.classList.remove("mobile-menu-open");
        updateMenuAccessibility();
    }

    menuToggle.addEventListener("click", function() {
        if (isMobileScreen()) {
            mainLayout.classList.toggle("mobile-menu-open");
        } else {
            mainLayout.classList.toggle("sidebar-collapsed");
        }

        updateMenuAccessibility();
    });

    mobileOverlay.addEventListener("click", closeMobileMenu);

    sidebar.querySelectorAll("a").forEach(function(link) {
        link.addEventListener("click", function() {
            if (isMobileScreen()) {
                closeMobileMenu();
            }
        });
    });

    document.addEventListener("keydown", function(event) {
        if (event.key === "Escape") {
            closeMobileMenu();
        }
    });

    window.addEventListener("resize", function() {
        if (!isMobileScreen()) {
            mainLayout.classList.remove("mobile-menu-open");
        }

        updateMenuAccessibility();
    });

    const printButton = document.getElementById("printButton");

    if (printButton) {
        printButton.addEventListener("click", function() {
            window.print();
        });
    }

    const taskSearch = document.getElementById("taskSearch");
    const tasksTable = document.getElementById("tasksTable");
    const taskRowsForSearch = Array.from(
        document.querySelectorAll("#tasksTableBody .task-row")
    );

    const emptyState = document.getElementById("emptyState");
    const emptyStateHeading = document.getElementById("emptyStateHeading");
    const emptyStateMessage = document.getElementById("emptyStateMessage");
    const emptyAddButton = document.getElementById("emptyAddButton");
    const visibleCount = document.getElementById("visibleCount");
    const tableCount = document.getElementById("tableCount");

    function filterTasks() {
        const query = taskSearch.value.trim().toLowerCase();
        let count = 0;

        taskRowsForSearch.forEach(function(row) {
            const matches = row.textContent.toLowerCase().includes(query);

            row.style.display = matches ? "" : "none";

            if (matches) {
                count++;
            }
        });

        visibleCount.textContent = count;

        if (tableCount) {
            tableCount.textContent =
                "Showing " + count + " of " +
                taskRowsForSearch.length + " task records";
        }

        tasksTable.style.display = count > 0 ? "" : "none";
        emptyState.style.display = count === 0 ? "block" : "none";

        if (count === 0 && taskRowsForSearch.length === 0) {
            emptyStateHeading.textContent = "No tasks registered";
            emptyStateMessage.textContent =
                "Add a task to start organizing your construction project work.";
            emptyAddButton.style.display = "inline-flex";
        } else if (count === 0) {
            emptyStateHeading.textContent = "No matching tasks found";
            emptyStateMessage.textContent =
                "Try a different task name, project, phase, date, or status.";
            emptyAddButton.style.display = "none";
        }
    }

    taskSearch.addEventListener("input", filterTasks);

    filterTasks();
    updateMenuAccessibility();
</script>

</body>
</html>
