
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#101e35">
    <title>Tasks | Construction MS</title>

    <style>
        :root {
            --navy: #142b4a;
            --navy-light: #203e63;
            --navy-dark: #0b1729;
            --orange: #f28c28;
            --orange-light: #ffb45f;
            --orange-hover: #df7618;
            --background: #f3f6fb;
            --white: #ffffff;
            --text: #263445;
            --muted: #718096;
            --border: #e4eaf2;
            --green: #167344;
            --red: #b42332;
            --shadow: 0 4px 15px rgba(20, 43, 74, 0.07);
            --shadow-hover: 0 18px 40px rgba(20,43,74,.13);
            --radius: 18px;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            font-family: Inter, "Segoe UI", Arial, sans-serif;
            color: var(--text);
            background:
                radial-gradient(ellipse at 95% 0%, rgba(242,140,40,.07), transparent 28%),
                var(--background);
            min-height: 100vh;
            -webkit-font-smoothing: antialiased;
        }

        a {
            color: inherit;
            text-decoration: none;
        }

        button, input {
            font: inherit;
        }

        button, a {
            -webkit-tap-highlight-color: transparent;
        }

        ::selection {
            background: rgba(242,140,40,.25);
            color: var(--navy);
        }

        .topbar {
            height: 72px;
            padding: 0 28px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 18px;
            position: sticky;
            top: 0;
            z-index: 1000;
            color: white;
            background:
                radial-gradient(circle at 90% -100%, rgba(242,140,40,.23), transparent 40%),
                linear-gradient(110deg, #101e35, #142b4a 60%, #203e63);
            border-bottom: 1px solid rgba(255,255,255,.08);
            box-shadow: 0 5px 24px rgba(8,22,42,.17);
        }

        .topbar::after {
            content: "";
            position: absolute;
            bottom: 0;
            left: 0;
            width: 100%;
            height: 2px;
            background: linear-gradient(90deg, transparent, var(--orange), transparent);
            opacity: .8;
        }

        .topbar-left,
        .topbar-right {
            display: flex;
            align-items: center;
            gap: 16px;
            min-width: 0;
        }

        .menu-toggle {
            width: 42px;
            height: 42px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            gap: 5px;
            flex-shrink: 0;
            border: 1px solid rgba(255,255,255,.12);
            border-radius: 12px;
            color: white;
            background: rgba(255,255,255,.055);
            cursor: pointer;
            transition: background .25s, border-color .25s, transform .25s;
        }

        .menu-toggle:hover {
            background: rgba(242,140,40,.18);
            border-color: rgba(242,140,40,.6);
            transform: translateY(-2px);
        }

        .menu-toggle:active {
            transform: scale(.94);
        }

        .menu-toggle span {
            width: 19px;
            height: 2px;
            display: block;
            border-radius: 5px;
            background: white;
            transition: transform .25s, width .25s;
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 11px;
            font-size: 19px;
            font-weight: 850;
            letter-spacing: -.5px;
            white-space: nowrap;
        }

        .brand-mark {
            width: 37px;
            height: 37px;
            display: grid;
            place-items: center;
            flex-shrink: 0;
            color: white;
            font-size: 18px;
            border-radius: 11px;
            background: linear-gradient(145deg, var(--orange-light), var(--orange));
            box-shadow: 0 5px 15px rgba(242,140,40,.3);
            transition: transform .3s, box-shadow .3s;
        }

        .brand:hover .brand-mark {
            transform: rotate(-8deg) scale(1.08);
            box-shadow: 0 8px 22px rgba(242,140,40,.4);
        }

        .brand span span {
            color: var(--orange-light);
        }

        .welcome {
            text-align: right;
            font-size: 12px;
            line-height: 1.55;
            color: #c8d3e2;
        }

        .welcome strong {
            display: block;
            color: white;
            font-size: 13px;
            font-weight: 750;
        }

        .role-badge {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            margin-top: 3px;
            padding: 3px 9px;
            border: 1px solid rgba(242,140,40,.25);
            border-radius: 30px;
            background: rgba(242,140,40,.12);
            color: #ffc184;
            font-size: 10px;
            font-weight: 700;
        }

        .role-badge::before {
            content: "";
            width: 5px;
            height: 5px;
            border-radius: 50%;
            background: var(--orange);
            box-shadow: 0 0 8px var(--orange);
        }

        .logout-btn {
            padding: 10px 15px;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            color: white;
            background: rgba(255,255,255,.055);
            border: 1px solid rgba(255,255,255,.17);
            border-radius: 10px;
            font-size: 12px;
            font-weight: 750;
            white-space: nowrap;
            transition: background .25s, border-color .25s, transform .25s, box-shadow .25s;
        }

        .logout-btn:hover {
            background: var(--orange);
            border-color: var(--orange);
            box-shadow: 0 5px 20px rgba(242,140,40,.28);
            transform: translateY(-2px);
        }

        .layout {
            display: flex;
            min-height: calc(100vh - 72px);
        }

        .sidebar {
            width: 252px;
            flex: 0 0 252px;
            height: calc(100vh - 72px);
            position: sticky;
            top: 72px;
            overflow-x: hidden;
            overflow-y: auto;
            z-index: 900;
            color: #d7e1ee;
            background:
                radial-gradient(ellipse at 0% 0%, rgba(45,78,119,.4), transparent 42%),
                linear-gradient(180deg, #142b4a, #101e35);
            border-right: 1px solid rgba(255,255,255,.06);
            transition: width .28s ease, flex-basis .28s ease, transform .28s ease;
            scrollbar-width: thin;
            scrollbar-color: #405777 transparent;
        }

        .sidebar-heading {
            padding: 24px 20px 11px;
            color: #8fa5c1;
            font-size: 10px;
            font-weight: 800;
            letter-spacing: 1.6px;
            text-transform: uppercase;
            white-space: nowrap;
        }

        .sidebar-divider {
            height: 1px;
            margin: 13px 16px;
            background: linear-gradient(90deg, rgba(255,255,255,.13), transparent);
        }

        .sidebar-nav {
            padding: 0 11px 24px;
        }

        .nav-link {
            min-height: 45px;
            position: relative;
            display: flex;
            align-items: center;
            gap: 13px;
            padding: 11px 13px;
            margin-bottom: 4px;
            overflow: hidden;
            color: #c8d5e6;
            border: 1px solid transparent;
            border-radius: 11px;
            font-size: 12px;
            font-weight: 600;
            white-space: nowrap;
            transition: background .22s, color .22s, border-color .22s, transform .22s;
        }

        .nav-link:hover {
            color: white;
            background: rgba(255,255,255,.075);
            border-color: rgba(255,255,255,.07);
            transform: translateX(4px);
        }

        .nav-link:active {
            transform: translateX(2px) scale(.99);
        }

        .nav-link.active {
            color: white;
            font-weight: 750;
            background: linear-gradient(105deg, #f28c28, #e77b18);
            border-color: rgba(255,255,255,.13);
            box-shadow: 0 6px 18px rgba(242,140,40,.2);
        }

        .nav-link.active::before {
            content: "";
            position: absolute;
            left: 0;
            top: 10px;
            bottom: 10px;
            width: 3px;
            background: white;
            border-radius: 0 5px 5px 0;
        }

        .nav-icon {
            width: 24px;
            min-width: 24px;
            display: grid;
            place-items: center;
            font-size: 17px;
            line-height: 1;
            transition: transform .25s;
        }

        .nav-link:hover .nav-icon {
            transform: scale(1.15);
        }

        .nav-label {
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .main-content {
            flex: 1;
            min-width: 0;
            padding: 30px;
            animation: contentEnter .45s ease both;
        }

        @keyframes contentEnter {
            from { opacity: 0; transform: translateY(8px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .page-heading {
            display: flex;
            align-items: flex-end;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 18px;
            margin-bottom: 27px;
        }

        .heading-copy {
            min-width: 0;
        }

        .eyebrow {
            display: flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 9px;
            color: #b96b1b;
            font-size: 10px;
            font-weight: 850;
            letter-spacing: 1.8px;
            text-transform: uppercase;
        }

        .eyebrow::before {
            content: "";
            width: 19px;
            height: 2px;
            border-radius: 3px;
            background: var(--orange);
        }

        .page-heading h1 {
            color: var(--navy);
            font-size: clamp(27px, 3vw, 34px);
            font-weight: 850;
            letter-spacing: -1.1px;
        }

        .page-heading p {
            max-width: 620px;
            margin-top: 8px;
            color: var(--muted);
            font-size: 13px;
            line-height: 1.8;
        }

        .heading-actions {
            display: flex;
            align-items: center;
            flex-wrap: wrap;
            gap: 10px;
        }

        .btn {
            min-height: 42px;
            padding: 11px 16px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            border: 1px solid transparent;
            border-radius: 10px;
            font-size: 12px;
            font-weight: 800;
            white-space: nowrap;
            cursor: pointer;
            transition: transform .23s, box-shadow .23s, background .23s, border-color .23s;
        }

        .btn:hover {
            transform: translateY(-3px);
        }

        .btn:active {
            transform: scale(.97);
        }

        .btn-primary {
            color: white;
            background: linear-gradient(110deg, #f28c28, #e77b18);
            border-color: #e77b18;
            box-shadow: 0 6px 16px rgba(242,140,40,.2);
        }

        .btn-primary:hover {
            background: linear-gradient(110deg, #ff9d3e, #df7618);
            box-shadow: 0 9px 22px rgba(242,140,40,.3);
        }

        .btn-secondary {
            color: var(--navy);
            background: rgba(255,255,255,.9);
            border-color: #dfe7f0;
            box-shadow: 0 4px 13px rgba(20,43,74,.035);
        }

        .btn-secondary:hover {
            border-color: var(--orange);
            box-shadow: 0 7px 18px rgba(20,43,74,.08);
        }

        .section-label {
            display: flex;
            align-items: center;
            gap: 11px;
            margin-bottom: 16px;
            color: var(--navy);
            font-size: 15px;
            font-weight: 850;
        }

        .section-label::before {
            content: "";
            width: 4px;
            height: 19px;
            border-radius: 5px;
            background: var(--orange);
            transition: height .25s;
        }

        .section-label:hover::before {
            height: 25px;
        }

        .stats {
            display: grid;
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: 17px;
            margin-bottom: 30px;
        }

        .stat-card {
            position: relative;
            isolation: isolate;
            min-width: 0;
            overflow: hidden;
            padding: 21px;
            background: linear-gradient(145deg, #ffffff, #fbfcff);
            border: 1px solid rgba(226,234,244,.95);
            border-radius: 17px;
            box-shadow: var(--shadow);
            transition: transform .3s cubic-bezier(.2,.8,.2,1), border-color .3s, box-shadow .3s;
            animation: cardEnter .5s ease both;
        }

        .stat-card:nth-child(2) { animation-delay: .05s; }
        .stat-card:nth-child(3) { animation-delay: .1s; }
        .stat-card:nth-child(4) { animation-delay: .15s; }

        @keyframes cardEnter {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .stat-card::before {
            content: "";
            position: absolute;
            z-index: -1;
            top: 0;
            left: 0;
            width: 100%;
            height: 3px;
            background: linear-gradient(90deg, var(--orange), #ffd09d, transparent);
            opacity: .8;
            transition: height .25s, opacity .25s;
        }

        .stat-card::after {
            content: "";
            position: absolute;
            z-index: -1;
            right: -48px;
            bottom: -62px;
            width: 140px;
            height: 140px;
            border-radius: 50%;
            background: radial-gradient(circle, rgba(242,140,40,.09), transparent 70%);
            transition: transform .35s;
        }

        .stat-card:hover {
            transform: translateY(-8px);
            border-color: var(--orange);
            box-shadow: 0 12px 25px rgba(20,43,74,.09), 0 16px 32px rgba(242,140,40,.12);
            z-index: 2;
        }

        .stat-card:hover::before {
            height: 4px;
            opacity: 1;
        }

        .stat-card:hover::after {
            transform: scale(1.35);
        }

        .stat-top {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 10px;
            margin-bottom: 18px;
        }

        .stat-label {
            color: #687a91;
            font-size: 12px;
            font-weight: 750;
            line-height: 1.5;
        }

        .stat-icon {
            width: 43px;
            height: 43px;
            flex-shrink: 0;
            display: grid;
            place-items: center;
            color: var(--orange);
            background: linear-gradient(145deg, #fff5e9, #ffe7ce);
            border: 1px solid #ffead5;
            border-radius: 13px;
            font-size: 21px;
            transition: transform .3s, background .3s, color .3s;
        }

        .stat-card:hover .stat-icon {
            color: white;
            background: linear-gradient(145deg, #ffad56, #e77b18);
            transform: rotate(-7deg) scale(1.1);
        }

        .stat-number {
            overflow-wrap: anywhere;
            color: var(--navy);
            font-size: 31px;
            font-weight: 850;
            letter-spacing: -1px;
            line-height: 1.2;
        }

        .stat-note {
            margin-top: 9px;
            color: #8794a6;
            font-size: 11px;
            line-height: 1.6;
        }

        .stat-note::before {
            content: "";
            display: inline-block;
            width: 5px;
            height: 5px;
            margin-right: 7px;
            vertical-align: 2px;
            border-radius: 50%;
            background: #cbd5e1;
        }

        .panel {
            min-width: 0;
            overflow: hidden;
            background: rgba(255,255,255,.96);
            border: 1px solid #e3eaf3;
            border-radius: 17px;
            box-shadow: var(--shadow);
            transition: box-shadow .3s, border-color .3s;
            animation: panelEnter .5s ease both;
        }

        @keyframes panelEnter {
            from { opacity: 0; transform: translateY(9px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .panel:hover {
            border-color: rgba(242,140,40,.42);
            box-shadow: 0 12px 28px rgba(20,43,74,.075);
        }

        .panel-header {
            position: relative;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 15px;
            padding: 21px 23px;
            border-bottom: 1px solid #eaf0f6;
            background: linear-gradient(120deg, #fff, #f9fbfe);
        }

        .panel-header::before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            width: 4px;
            height: 100%;
            background: linear-gradient(180deg, var(--orange), #ffc184);
        }

        .panel-title-wrap {
            min-width: 0;
        }

        .panel-header h2 {
            color: var(--navy);
            font-size: 15px;
            font-weight: 850;
            letter-spacing: -.2px;
        }

        .panel-subtitle {
            margin-top: 5px;
            color: #8794a6;
            font-size: 11px;
            line-height: 1.6;
        }

        .record-count-badge {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            padding: 8px 11px;
            color: #a95a0c;
            background: #fff3e5;
            border: 1px solid #ffe0bd;
            border-radius: 30px;
            font-size: 11px;
            font-weight: 800;
            white-space: nowrap;
        }

        .record-count-badge::before {
            content: "";
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background: var(--orange);
        }

        .table-tools {
            padding: 15px 20px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 13px;
            border-bottom: 1px solid #edf1f6;
            background: #fff;
        }

        .table-count {
            color: #8794a6;
            font-size: 11px;
            line-height: 1.6;
        }

        .search-box {
            position: relative;
            width: min(100%, 290px);
        }

        .search-icon {
            position: absolute;
            left: 13px;
            top: 50%;
            transform: translateY(-50%);
            color: #8492a6;
            font-size: 15px;
            pointer-events: none;
            transition: color .2s;
        }

        .search-box input {
            width: 100%;
            min-height: 40px;
            padding: 10px 13px 10px 36px;
            outline: none;
            color: var(--text);
            background: #f8fafc;
            border: 1px solid #e4eaf2;
            border-radius: 10px;
            font-size: 12px;
            transition: border-color .2s, box-shadow .2s, background .2s;
        }

        .search-box input:hover,
        .search-box input:focus {
            background: white;
            border-color: var(--orange);
            box-shadow: 0 0 0 4px rgba(242,140,40,.13);
        }

        .search-box:focus-within .search-icon,
        .search-box:hover .search-icon {
            color: var(--orange-hover);
        }

        .search-box input::placeholder {
            color: #9aa6b6;
        }

        .table-wrapper {
            width: 100%;
            overflow-x: auto;
            -webkit-overflow-scrolling: touch;
        }

        table {
            width: 100%;
            min-width: 1100px;
            border-collapse: separate;
            border-spacing: 0;
            text-align: left;
            font-size: 12px;
        }

        th {
            padding: 15px 17px;
            color: #728198;
            background: #f5f8fc;
            border-bottom: 1px solid #e7edf5;
            font-size: 10px;
            font-weight: 850;
            letter-spacing: .65px;
            text-transform: uppercase;
            white-space: nowrap;
        }

        td {
            padding: 16px 17px;
            color: #53647a;
            border-bottom: 1px solid #edf1f6;
            vertical-align: middle;
            line-height: 1.65;
            transition: background .18s;
        }

        tbody tr {
            transition: background .18s;
        }

        tbody tr:last-child td {
            border-bottom: none;
        }

        tbody tr:hover td {
            background: #fff7ed;
        }

        .record-name {
            min-width: 140px;
            color: var(--navy);
            font-weight: 800;
            transition: color .2s;
        }

        tbody tr:hover .record-name {
            color: #c66b13;
        }

        .record-id {
            display: inline-block;
            margin-top: 4px;
            color: #8b98aa;
            font-size: 10px;
            font-weight: 600;
        }

        .date {
            min-width: 120px;
            white-space: nowrap;
        }

        .progress-label {
            color: var(--navy);
            font-size: 11px;
            font-weight: 850;
        }

        .progress-track {
            width: 110px;
            height: 7px;
            margin-top: 7px;
            overflow: hidden;
            background: #e9edf3;
            border-radius: 10px;
        }

        .progress-fill {
            height: 100%;
            background: linear-gradient(90deg, var(--orange), #ffb45f);
            border-radius: 10px;
            transition: width .3s ease;
        }

        .badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 6px 10px;
            border: 1px solid #e2e8f0;
            border-radius: 30px;
            color: #52647a;
            background: #f3f6fa;
            font-size: 10px;
            font-weight: 800;
            white-space: nowrap;
        }

        .badge-completed {
            color: #167344;
            background: #e9f8ef;
            border-color: #ccefd9;
        }

        .badge-progress {
            color: #a95a0c;
            background: #fff3e5;
            border-color: #ffe0bd;
        }

        .badge-pending {
            color: #3f5f85;
            background: #edf4fc;
            border-color: #d9e7f8;
        }

        .badge-cancelled {
            color: #b42332;
            background: #fff0f1;
            border-color: #f8d4d8;
        }

        .actions {
            display: flex;
            align-items: center;
            gap: 7px;
            white-space: nowrap;
        }

        .action-link {
            min-height: 32px;
            padding: 7px 10px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 5px;
            border: 1px solid transparent;
            border-radius: 8px;
            font-size: 11px;
            font-weight: 800;
            transition: transform .2s, background .2s, border-color .2s, box-shadow .2s;
        }

        .action-link:hover {
            transform: translateY(-2px);
        }

        .action-link:active {
            transform: scale(.96);
        }

        .edit-link {
            color: #a95a0c;
            background: #fff3e5;
            border-color: #ffe0bd;
        }

        .edit-link:hover {
            background: #ffe7ce;
            border-color: var(--orange);
            box-shadow: 0 4px 10px rgba(242,140,40,.12);
        }

        .delete-link {
            color: #b42332;
            background: #fff0f1;
            border-color: #f8d4d8;
        }

        .delete-link:hover {
            color: white;
            background: #b42332;
            border-color: #b42332;
            box-shadow: 0 4px 10px rgba(180,35,50,.15);
        }

        .empty-state {
            display: none;
            padding: 52px 20px;
            text-align: center;
            color: #8290a4;
            background: radial-gradient(ellipse at center, #fff7ed, #fff 70%);
            font-size: 12px;
