<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Workers - Construction Management System</title>

    <style>
        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background: #f4f6f8;
            color: #222;
        }

        .header {
            background: #222;
            color: white;
            padding: 18px 30px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .header h1 {
            margin: 0;
            font-size: 24px;
        }

        .header a {
            color: white;
            text-decoration: none;
        }

        .container {
            padding: 30px;
        }

        .back {
            display: inline-block;
            margin-bottom: 20px;
            color: #222;
            text-decoration: none;
        }

        .top {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
        }

        .top h2 {
            margin: 0;
        }

        .button {
            background: #222;
            color: white;
            text-decoration: none;
            padding: 11px 18px;
            border-radius: 5px;
        }

        .button:hover {
            background: #444;
        }

        .table-container {
            background: white;
            padding: 20px;
            border-radius: 8px;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
            overflow-x: auto;
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        th,
        td {
            padding: 12px;
            border-bottom: 1px solid #ddd;
            text-align: left;
            white-space: nowrap;
        }

        th {
            background: #f1f1f1;
        }

        .active {
            color: #2e7d32;
            font-weight: bold;
        }

        .inactive {
            color: #c62828;
            font-weight: bold;
        }

        .edit {
            color: #1565c0;
            text-decoration: none;
            margin-right: 10px;
        }

        .delete {
            color: #c62828;
            text-decoration: none;
        }

        .edit:hover,
        .delete:hover {
            text-decoration: underline;
        }

        .empty {
            text-align: center;
            color: #777;
            padding: 30px;
        }

        @media (max-width: 700px) {
            .header {
                display: block;
            }

            .header div {
                margin-top: 10px;
            }

            .container {
                padding: 15px;
            }

            .top {
                display: block;
            }

            .button {
                display: inline-block;
                margin-top: 15px;
            }
        }
    </style>
</head>

<body>

    <div class="header">

        <h1>Construction MS</h1>

        <div>
            <a href="/dashboard">Dashboard</a>
            &nbsp; | &nbsp;
            <a href="/logout">Logout</a>
        </div>

    </div>


    <div class="container">

        <a href="/dashboard" class="back">
            ← Back to Dashboard
        </a>


        <div class="top">

            <h2>Workers</h2>

            <a href="/workers/add" class="button">
                + Add Worker
            </a>

        </div>


        <div class="table-container">

            <% if (workers.length === 0) { %>

                <div class="empty">
                    No workers found.
                </div>

            <% } else { %>

                <table>

                    <thead>

                        <tr>
                            <th>ID</th>
                            <th>First Name</th>
                            <th>Last Name</th>
                            <th>Contact No.</th>
                            <th>Hourly Rate</th>
                            <th>Hire Date</th>
                            <th>Status</th>
                            <th>Action</th>
                        </tr>

                    </thead>

                    <tbody>

                        <% workers.forEach(worker => { %>

                            <tr>

                                <td>
                                    <%= worker.worker_id %>
                                </td>

                                <td>
                                    <%= worker.first_name %>
                                </td>

                                <td>
                                    <%= worker.last_name %>
                                </td>

                                <td>
                                    <%= worker.contact_no || "-" %>
                                </td>

                                <td>
                                    ₱<%= Number(worker.hourly_rate).toLocaleString("en-PH", {
                                        minimumFractionDigits: 2,
                                        maximumFractionDigits: 2
                                    }) %>
                                </td>

                                <td>
                                    <%= worker.hire_date %>
                                </td>

                                <td>

                                    <% if (worker.is_active) { %>

                                        <span class="active">
                                            Active
                                        </span>

                                    <% } else { %>

                                        <span class="inactive">
                                            Inactive
                                        </span>

                                    <% } %>

                                </td>

                                <td>

                                    <a
                                        href="/workers/edit/<%= worker.worker_id %>"
                                        class="edit"
                                    >
                                        Edit
                                    </a>

                                    <a
                                        href="/workers/delete/<%= worker.worker_id %>"
                                        class="delete"
                                        onclick="return confirm('Are you sure you want to delete this worker?');"
                                    >
                                        Delete
                                    </a>

                                </td>

                            </tr>

                        <% }) %>

                    </tbody>

                </table>

            <% } %>

        </div>

    </div>

</body>
</html>