<!DOCTYPE html>
<html>

<head>

    <title>Edit Task Assignment</title>

    <style>

        body {
            font-family: Arial, sans-serif;
            margin: 30px;
        }

        h1 {
            margin-bottom: 20px;
        }

        .form-container {
            width: 500px;
        }

        label {
            display: block;
            margin-top: 15px;
            margin-bottom: 5px;
        }

        input,
        select {
            width: 100%;
            padding: 10px;
            box-sizing: border-box;
        }

        button {
            margin-top: 20px;
            padding: 10px 20px;
            cursor: pointer;
        }

        .back {
            display: inline-block;
            margin-bottom: 20px;
        }

        .error {
            color: red;
            margin-bottom: 15px;
        }

    </style>

</head>

<body>


    <a
        class="back"
        href="/assignments"
    >
        ← Back to Assignments
    </a>


    <h1>Edit Task Assignment</h1>


    <% if (error) { %>

        <div class="error">
            <%= error %>
        </div>

    <% } %>


    <div class="form-container">

        <form
            action="/assignments/edit/<%= assignment.assignment_id %>"
            method="POST"
        >


            <label for="task_id">
                Task
            </label>


            <select
                id="task_id"
                name="task_id"
                required
            >

                <% tasks.forEach(task => { %>

                    <option
                        value="<%= task.task_id %>"
                        <%= Number(assignment.task_id) === Number(task.task_id) ? "selected" : "" %>
                    >

                        <%= task.task_name %>

                    </option>

                <% }) %>

            </select>


            <label for="worker_id">
                Worker
            </label>


            <select
                id="worker_id"
                name="worker_id"
                required
            >

                <% workers.forEach(worker => { %>

                    <option
                        value="<%= worker.worker_id %>"
                        <%= Number(assignment.worker_id) === Number(worker.worker_id) ? "selected" : "" %>
                    >

                        <%= worker.first_name %>
                        <%= worker.last_name %>

                    </option>

                <% }) %>

            </select>


            <label for="assigned_role">
                Assigned Role
            </label>


            <input
                type="text"
                id="assigned_role"
                name="assigned_role"
                value="<%= assignment.assigned_role || '' %>"
                placeholder="Example: Carpenter"
            >


            <label for="progress_pct">
                Progress (%)
            </label>


            <input
                type="number"
                id="progress_pct"
                name="progress_pct"
                min="0"
                max="100"
                value="<%= assignment.progress_pct || 0 %>"
                required
            >


            <label for="status">
                Status
            </label>


            <select
                id="status"
                name="status"
                required
            >

                <option
                    value="assigned"
                    <%= assignment.status === "assigned" ? "selected" : "" %>
                >
                    Assigned
                </option>


                <option
                    value="in_progress"
                    <%= assignment.status === "in_progress" ? "selected" : "" %>
                >
                    In Progress
                </option>


                <option
                    value="completed"
                    <%= assignment.status === "completed" ? "selected" : "" %>
                >
                    Completed
                </option>


                <option
                    value="on_hold"
                    <%= assignment.status === "on_hold" ? "selected" : "" %>
                >
                    On Hold
                </option>

            </select>


            <button type="submit">
                Update Assignment
            </button>


        </form>

    </div>


</body>

</html>