
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Task Assignment | Construction MS</title>

    <style>
        :root {
            --navy: #142b4a;
            --navy-light: #203e63;
            --orange: #f28c28;
            --white: #ffffff;
            --background: #f3f5f9;
            --border: #e1e6ed;
            --text: #263445;
            --muted: #758195;
            --red: #c93636;
        }

        * {
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background: var(--background);
            color: var(--text);
            font-size: 14px;
        }

        a {
            text-decoration: none;
        }

        .header {
            background: var(--navy);
            color: var(--white);
            padding: 18px 4%;
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 18px;
            box-shadow: 0 3px 12px rgba(20, 43, 74, 0.14);
        }

        .brand {
            font-size: 21px;
            font-weight: 800;
            letter-spacing: 0.5px;
            color: var(--white);
            white-space: nowrap;
        }

        .brand span {
            color: var(--orange);
        }

        .header-nav {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .dashboard-button {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-height: 40px;
            padding: 10px 18px;
            border-radius: 7px;
            background: var(--orange);
            color: var(--white);
            font-weight: 700;
            font-size: 13px;
            transition: background 0.2s ease, transform 0.2s ease,
                box-shadow 0.2s ease;
        }

        .dashboard-button:hover {
            background: #df7618;
            transform: translateY(-2px);
            box-shadow: 0 4px 10px rgba(242, 140, 40, 0.25);
        }

        .dashboard-button:focus-visible,
        .button:focus-visible,
        input:focus-visible,
        select:focus-visible {
            outline: 3px solid #ffad5c;
            outline-offset: 2px;
        }

        .container {
            max-width: 1000px;
            margin: 32px auto;
            padding: 0 24px;
        }

        .breadcrumb {
            display: flex;
            align-items: center;
            flex-wrap: wrap;
            gap: 9px;
            margin-bottom: 22px;
            color: var(--muted);
            font-size: 13px;
        }

        .breadcrumb a {
            color: var(--navy);
            font-weight: 700;
            transition: color 0.2s ease;
        }

        .breadcrumb a:hover {
            color: var(--orange);
        }

        .breadcrumb-separator {
            color: #aab3c0;
        }

        .page-heading {
            margin-bottom: 24px;
        }

        .page-heading h1 {
            margin: 0 0 9px;
            color: var(--navy);
            font-size: 29px;
            line-height: 1.3;
            font-weight: 800;
        }

        .page-heading p {
            margin: 0;
            color: var(--muted);
            font-size: 14px;
            line-height: 1.6;
        }

        .form-box {
            background: var(--white);
            border: 1px solid var(--border);
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 4px 15px rgba(20, 43, 74, 0.07);
        }

        .form-header {
            padding: 22px 28px;
            color: var(--white);
            background: linear-gradient(
                135deg,
                var(--navy),
                var(--navy-light)
            );
            border-bottom: 4px solid var(--orange);
        }

        .form-header h2 {
            margin: 0 0 7px;
            font-size: 20px;
            line-height: 1.4;
        }

        .form-header p {
            margin: 0;
            color: #d9e3ef;
            font-size: 13px;
            line-height: 1.6;
        }

        .form-content {
            padding: 28px;
        }

        .section-title {
            display: flex;
            align-items: center;
            gap: 10px;
            margin: 0 0 22px;
            padding-bottom: 12px;
            border-bottom: 1px solid var(--border);
            color: var(--navy);
            font-size: 15px;
            font-weight: 800;
        }

        .section-title::before {
            content: "";
            display: block;
            width: 4px;
            height: 19px;
            flex-shrink: 0;
            background: var(--orange);
            border-radius: 3px;
        }

        .form-grid {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 20px 22px;
        }

        .form-group {
            min-width: 0;
        }

        .form-group.full-width {
            grid-column: 1 / -1;
        }

        label {
            display: block;
            margin-bottom: 8px;
            color: var(--navy);
            font-size: 13px;
            font-weight: 700;
        }

        .required {
            color: var(--red);
            margin-left: 3px;
        }

        input,
        select {
            display: block;
            width: 100%;
            min-height: 44px;
            padding: 11px 13px;
            border: 1px solid #d5dce6;
            border-radius: 7px;
            background: var(--white);
            color: var(--text);
            font-family: Arial, sans-serif;
            font-size: 14px;
            transition: border-color 0.2s ease, box-shadow 0.2s ease,
                background 0.2s ease;
        }

        input:hover,
        select:hover {
            border-color: #aab7c8;
        }

        input:focus,
        select:focus {
            outline: none;
            border-color: var(--orange);
            box-shadow: 0 0 0 3px rgba(242, 140, 40, 0.13);
        }

        input::placeholder {
            color: #9aa4b2;
        }

        .field-hint {
            margin: 7px 0 0;
            color: var(--muted);
            font-size: 12px;
            line-height: 1.5;
        }

        .error {
            margin-bottom: 22px;
            padding: 13px 15px;
            color: #922b35;
            background: #fff0f0;
            border: 1px solid #f1c7ca;
            border-left: 4px solid var(--red);
            border-radius: 7px;
            font-size: 13px;
            line-height: 1.6;
        }

        .form-actions {
            display: flex;
            align-items: center;
            justify-content: flex-end;
            flex-wrap: wrap;
            gap: 12px;
            margin-top: 30px;
            padding-top: 22px;
            border-top: 1px solid var(--border);
        }

        .button {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            min-height: 44px;
            padding: 12px 20px;
            border: 1px solid transparent;
            border-radius: 7px;
            font-family: Arial, sans-serif;
            font-size: 14px;
            font-weight: 700;
            cursor: pointer;
            transition: background 0.2s ease, color 0.2s ease,
                border-color 0.2s ease, transform 0.2s ease,
                box-shadow 0.2s ease;
        }

        .button-primary {
            background: var(--orange);
            color: var(--white);
            border-color: var(--orange);
        }

        .button-primary:hover {
            background: #df7618;
            border-color: #df7618;
            transform: translateY(-2px);
            box-shadow: 0 4px 10px rgba(242, 140, 40, 0.22);
        }

        .button-secondary {
            background: var(--white);
            color: var(--navy);
            border-color: #d5dce6;
        }

        .button-secondary:hover {
            background: var(--navy);
            color: var(--white);
            border-color: var(--navy);
            transform: translateY(-2px);
            box-shadow: 0 4px 10px rgba(20, 43, 74, 0.15);
        }

        .button:disabled {
            opacity: 0.7;
            cursor: not-allowed;
            transform: none;
            box-shadow: none;
        }

        @media (max-width: 900px) {
            .header {
                align-items: flex-start;
            }

            .header-nav {
                width: 100%;
            }
        }

        @media (max-width: 600px) {
            .header {
                padding: 17px 18px;
            }

            .brand {
                font-size: 19px;
            }

            .header-nav {
                width: 100%;
            }

            .dashboard-button {
                width: 100%;
            }

            .container {
                margin: 22px auto;
                padding: 0 14px;
            }

            .breadcrumb {
                margin-bottom: 18px;
            }

            .page-heading {
                margin-bottom: 20px;
            }

            .page-heading h1 {
                font-size: 25px;
            }

            .form-header {
                padding: 20px;
            }

            .form-content {
                padding: 20px;
            }

            .form-grid {
                grid-template-columns: 1fr;
                gap: 18px;
            }

            .form-group.full-width {
                grid-column: auto;
            }

            .form-actions {
                flex-direction: column-reverse;
                align-items: stretch;
            }

            .form-actions .button {
                width: 100%;
            }
        }

        @media (prefers-reduced-motion: reduce) {
            *,
            *::before,
            *::after {
                scroll-behavior: auto !important;
                transition: none !important;
                animation: none !important;
            }
        }
    </style>
</head>

<body>
    <header class="header">
        <a href="/dashboard" class="brand">
            CONSTRUCTION <span>MS</span>
        </a>

        <nav class="header-nav">
            <a href="/dashboard" class="dashboard-button">
                Dashboard
            </a>
        </nav>
    </header>

    <main class="container">
        <nav class="breadcrumb" aria-label="Breadcrumb">
            <a href="/dashboard">Dashboard</a>
            <span class="breadcrumb-separator">/</span>
            <a href="/assignments">Assignments</a>
            <span class="breadcrumb-separator">/</span>
            <span>Edit Task Assignment</span>
        </nav>

        <section class="page-heading">
            <h1>Edit Task Assignment</h1>
            <p>Update the assigned task, worker, role, progress, and current assignment status.</p>
        </section>

        <section class="form-box">
            <div class="form-header">
                <h2>Task Assignment Information</h2>
                <p>Review and update the details below, then save your changes.</p>
            </div>

            <div class="form-content">
                <% if (error) { %>
                    <div class="error" role="alert">
                        <%= error %>
                    </div>
                <% } %>

                <form
                    action="/assignments/edit/<%= assignment.assignment_id %>"
                    method="POST"
                    id="assignmentForm"
                >
                    <h3 class="section-title">Assignment Details</h3>

                    <div class="form-grid">
                        <div class="form-group">
                            <label for="task_id">
                                Task <span class="required">*</span>
                            </label>

                            <select
                                id="task_id"
                                name="task_id"
                                required
                            >
                                <% tasks.forEach(task => { %>
                                    <option
                                        value="<%= task.task_id %>"
                                        <%= Number(assignment.task_id) === Number(task.task_id) ? "selected" : "" %>
                                    >
                                        <%= task.task_name %>
                                    </option>
                                <% }) %>
                            </select>

                            <p class="field-hint">Choose the task assigned to this worker.</p>
                        </div>

                        <div class="form-group">
                            <label for="worker_id">
                                Worker <span class="required">*</span>
                            </label>

                            <select
                                id="worker_id"
                                name="worker_id"
                                required
                            >
                                <% workers.forEach(worker => { %>
                                    <option
                                        value="<%= worker.worker_id %>"
                                        <%= Number(assignment.worker_id) === Number(worker.worker_id) ? "selected" : "" %>
                                    >
                                        <%= worker.first_name %>
                                        <%= worker.last_name %>
                                    </option>
                                <% }) %>
                            </select>

                            <p class="field-hint">Select the worker responsible for this assignment.</p>
                        </div>

                        <div class="form-group full-width">
                            <label for="assigned_role">Assigned Role</label>

                            <input
                                type="text"
                                id="assigned_role"
                                name="assigned_role"
                                value="<%= assignment.assigned_role || '' %>"
                                placeholder="Example: Carpenter"
                            >

                            <p class="field-hint">Enter the worker's role for this task, if applicable.</p>
                        </div>

                        <div class="form-group">
                            <label for="progress_pct">
                                Progress (%) <span class="required">*</span>
                            </label>

                            <input
                                type="number"
                                id="progress_pct"
                                name="progress_pct"
                                min="0"
                                max="100"
                                value="<%= assignment.progress_pct || 0 %>"
                                required
                            >

                            <p class="field-hint">Enter a progress value from 0 to 100.</p>
                        </div>

                        <div class="form-group">
                            <label for="status">
                                Status <span class="required">*</span>
                            </label>

                            <select
                                id="status"
                                name="status"
                                required
                            >
                                <option
                                    value="assigned"
                                    <%= assignment.status === "assigned" ? "selected" : "" %>
                                >
                                    Assigned
                                </option>

                                <option
                                    value="in_progress"
                                    <%= assignment.status === "in_progress" ? "selected" : "" %>
                                >
                                    In Progress
                                </option>

                                <option
                                    value="completed"
                                    <%= assignment.status === "completed" ? "selected" : "" %>
                                >
                                    Completed
                                </option>

                                <option
                                    value="on_hold"
                                    <%= assignment.status === "on_hold" ? "selected" : "" %>
                                >
                                    On Hold
                                </option>
                            </select>

                            <p class="field-hint">Choose the current status of the assignment.</p>
                        </div>
                    </div>

                    <div class="form-actions">
                        <a href="/assignments" class="button button-secondary">
                            Cancel
                        </a>

                        <button
                            type="submit"
                            class="button button-primary"
                            id="submitButton"
                        >
                            Update Assignment
                        </button>
                    </div>
                </form>
            </div>
        </section>
    </main>

    <script>
        const assignmentForm = document.getElementById('assignmentForm');
        const submitButton = document.getElementById('submitButton');

        if (assignmentForm && submitButton) {
            assignmentForm.addEventListener('submit', function (event) {
                if (!assignmentForm.checkValidity()) {
                    event.preventDefault();
                    assignmentForm.reportValidity();
                    return;
                }

                submitButton.disabled = true;
                submitButton.textContent = 'Updating Assignment...';
            });
        }
    </script>
</body>
</html>
