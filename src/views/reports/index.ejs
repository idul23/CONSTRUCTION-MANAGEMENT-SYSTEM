<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Reports - Construction Management System</title>

    <style>

        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background: #f4f6f8;
            color: #222;
        }

        .header {
            background: #222;
            color: white;
            padding: 18px 30px;
        }

        .header h1 {
            margin: 0;
        }

        .container {
            padding: 30px;
        }

        .back {
            margin-bottom: 20px;
        }

        .back a {
            color: #222;
            text-decoration: none;
        }

        .summary {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 20px;
            margin-bottom: 30px;
        }

        .card {
            background: white;
            padding: 20px;
            border-radius: 8px;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
        }

        .card h3 {
            margin-top: 0;
            color: #666;
            font-size: 15px;
        }

        .number {
            font-size: 28px;
            font-weight: bold;
        }

        .section {
            background: white;
            padding: 20px;
            border-radius: 8px;
            margin-bottom: 30px;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
        }

        .section h2 {
            margin-top: 0;
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        th,
        td {
            padding: 10px;
            border-bottom: 1px solid #ddd;
            text-align: left;
        }

        th {
            background: #f1f1f1;
        }

        .empty {
            color: #777;
        }

        @media (max-width: 900px) {

            .summary {
                grid-template-columns: repeat(2, 1fr);
            }

        }

        @media (max-width: 600px) {

            .summary {
                grid-template-columns: 1fr;
            }

            .container {
                padding: 15px;
            }

        }

    </style>

</head>

<body>

    <div class="header">

        <h1>Construction Management System - Reports</h1>

    </div>


    <div class="container">

        <div class="back">

            <a href="/dashboard">
                ← Back to Dashboard
            </a>

        </div>


        <h2>System Reports</h2>


        <div class="summary">

            <div class="card">

                <h3>Total Projects</h3>

                <div class="number">
                    <%= projects.length %>
                </div>

            </div>


            <div class="card">

                <h3>Total Workers</h3>

                <div class="number">
                    <%= workers.length %>
                </div>

            </div>


            <div class="card">

                <h3>Total Tasks</h3>

                <div class="number">
                    <%= tasks.length %>
                </div>

            </div>


            <div class="card">

                <h3>Total Materials</h3>

                <div class="number">
                    <%= materials.length %>
                </div>

            </div>


            <div class="card">

                <h3>Total Expenses</h3>

                <div class="number">
                    ₱<%= Number(totalExpenses).toLocaleString("en-PH", {
                        minimumFractionDigits: 2,
                        maximumFractionDigits: 2
                    }) %>
                </div>

            </div>


            <div class="card">

                <h3>Total Labor Cost</h3>

                <div class="number">
                    ₱<%= Number(totalLaborCost).toLocaleString("en-PH", {
                        minimumFractionDigits: 2,
                        maximumFractionDigits: 2
                    }) %>
                </div>

            </div>


            <div class="card">

                <h3>Attendance Records</h3>

                <div class="number">
                    <%= attendance.length %>
                </div>

            </div>

        </div>


        <div class="section">

            <h2>Project Report</h2>

            <% if (projects.length === 0) { %>

                <p class="empty">
                    No projects found.
                </p>

            <% } else { %>

                <table>

                    <thead>

                        <tr>

                            <th>ID</th>
                            <th>Project Name</th>
                            <th>Location</th>
                            <th>Start Date</th>
                            <th>End Date</th>
                            <th>Budget</th>
                            <th>Remaining Budget</th>
                            <th>Status</th>

                        </tr>

                    </thead>

                    <tbody>

                        <% projects.forEach(project => { %>

                            <tr>

                                <td>
                                    <%= project.project_id %>
                                </td>

                                <td>
                                    <%= project.project_name %>
                                </td>

                                <td>
                                    <%= project.location %>
                                </td>

                                <td>
                                    <%= project.start_date %>
                                </td>

                                <td>
                                    <%= project.end_date %>
                                </td>

                                <td>
                                    ₱<%= Number(project.total_budget || 0).toLocaleString("en-PH", {
                                        minimumFractionDigits: 2
                                    }) %>
                                </td>

                                <td>
                                    ₱<%= Number(project.remaining_budget || 0).toLocaleString("en-PH", {
                                        minimumFractionDigits: 2
                                    }) %>
                                </td>

                                <td>
                                    <%= project.status %>
                                </td>

                            </tr>

                        <% }) %>

                    </tbody>

                </table>

            <% } %>

        </div>


        <div class="section">

            <h2>Worker Report</h2>

            <% if (workers.length === 0) { %>

                <p class="empty">
                    No workers found.
                </p>

            <% } else { %>

                <table>

                    <thead>

                        <tr>

                            <th>ID</th>
                            <th>First Name</th>
                            <th>Last Name</th>
                            <th>Contact</th>
                            <th>Hourly Rate</th>
                            <th>Status</th>

                        </tr>

                    </thead>

                    <tbody>

                        <% workers.forEach(worker => { %>

                            <tr>

                                <td>
                                    <%= worker.worker_id %>
                                </td>

                                <td>
                                    <%= worker.first_name %>
                                </td>

                                <td>
                                    <%= worker.last_name %>
                                </td>

                                <td>
                                    <%= worker.contact_no || "-" %>
                                </td>

                                <td>
                                    ₱<%= Number(worker.hourly_rate || 0).toLocaleString("en-PH", {
                                        minimumFractionDigits: 2
                                    }) %>
                                </td>

                                <td>
                                    <%= worker.is_active ? "Active" : "Inactive" %>
                                </td>

                            </tr>

                        <% }) %>

                    </tbody>

                </table>

            <% } %>

        </div>


        <div class="section">

            <h2>Task Report</h2>

            <% if (tasks.length === 0) { %>

                <p class="empty">
                    No tasks found.
                </p>

            <% } else { %>

                <table>

                    <thead>

                        <tr>

                            <th>ID</th>
                            <th>Task Name</th>
                            <th>Start Date</th>
                            <th>Due Date</th>
                            <th>Progress</th>
                            <th>Status</th>

                        </tr>

                    </thead>

                    <tbody>

                        <% tasks.forEach(task => { %>

                            <tr>

                                <td>
                                    <%= task.task_id %>
                                </td>

                                <td>
                                    <%= task.task_name %>
                                </td>

                                <td>
                                    <%= task.start_date || "-" %>
                                </td>

                                <td>
                                    <%= task.due_date || "-" %>
                                </td>

                                <td>
                                    <%= task.progress_pct || 0 %>%
                                </td>

                                <td>
                                    <%= task.status %>
                                </td>

                            </tr>

                        <% }) %>

                    </tbody>

                </table>

            <% } %>

        </div>


        <div class="section">

            <h2>Expense Report</h2>

            <% if (expenses.length === 0) { %>

                <p class="empty">
                    No expenses found.
                </p>

            <% } else { %>

                <table>

                    <thead>

                        <tr>

                            <th>ID</th>
                            <th>Project ID</th>
                            <th>Category</th>
                            <th>Amount</th>
                            <th>Description</th>
                            <th>Date</th>

                        </tr>

                    </thead>

                    <tbody>

                        <% expenses.forEach(expense => { %>

                            <tr>

                                <td>
                                    <%= expense.expense_id %>
                                </td>

                                <td>
                                    <%= expense.project_id %>
                                </td>

                                <td>
                                    <%= expense.category %>
                                </td>

                                <td>
                                    ₱<%= Number(expense.amount || 0).toLocaleString("en-PH", {
                                        minimumFractionDigits: 2
                                    }) %>
                                </td>

                                <td>
                                    <%= expense.description || "-" %>
                                </td>

                                <td>
                                    <%= expense.expense_date %>
                                </td>

                            </tr>

                        <% }) %>

                    </tbody>

                </table>

            <% } %>

        </div>


        <div class="section">

            <h2>Attendance Report</h2>

            <% if (attendance.length === 0) { %>

                <p class="empty">
                    No attendance records found.
                </p>

            <% } else { %>

                <table>

                    <thead>

                        <tr>

                            <th>ID</th>
                            <th>Assignment ID</th>
                            <th>Work Date</th>
                            <th>Time In</th>
                            <th>Time Out</th>
                            <th>Hours Worked</th>
                            <th>Labor Cost</th>

                        </tr>

                    </thead>

                    <tbody>

                        <% attendance.forEach(record => { %>

                            <tr>

                                <td>
                                    <%= record.attendance_id %>
                                </td>

                                <td>
                                    <%= record.assignment_id %>
                                </td>

                                <td>
                                    <%= record.work_date %>
                                </td>

                                <td>
                                    <%= record.time_in || "-" %>
                                </td>

                                <td>
                                    <%= record.time_out || "-" %>
                                </td>

                                <td>
                                    <%= record.hours_worked || 0 %>
                                </td>

                                <td>
                                    ₱<%= Number(record.labor_cost || 0).toLocaleString("en-PH", {
                                        minimumFractionDigits: 2
                                    }) %>
                                </td>

                            </tr>

                        <% }) %>

                    </tbody>

                </table>

            <% } %>

        </div>

    </div>

</body>

</html>
