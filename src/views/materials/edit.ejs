<!DOCTYPE html>
<html>

<head>

    <title>Edit Material</title>

    <style>

        body {
            font-family: Arial, sans-serif;
            margin: 30px;
        }

        .form-container {
            width: 500px;
        }

        label {
            display: block;
            margin-top: 15px;
            margin-bottom: 5px;
        }

        input,
        select {
            width: 100%;
            padding: 10px;
            box-sizing: border-box;
        }

        button {
            margin-top: 20px;
            padding: 10px 20px;
            cursor: pointer;
        }

        .back {
            display: inline-block;
            margin-bottom: 20px;
        }

        .error {
            color: red;
            margin-bottom: 15px;
        }

    </style>

</head>

<body>

    <a
        class="back"
        href="/materials"
    >
        ← Back to Materials
    </a>

    <h1>Edit Material</h1>

    <% if (error) { %>

        <div class="error">
            <%= error %>
        </div>

    <% } %>

    <div class="form-container">

        <form
            action="/materials/edit/<%= material.material_id %>"
            method="POST"
        >

            <label for="supplier_id">
                Supplier
            </label>

            <select
                id="supplier_id"
                name="supplier_id"
                required
            >

                <option value="">
                    Select Supplier
                </option>

                <% suppliers.forEach(supplier => { %>

                    <option
                        value="<%= supplier.supplier_id %>"
                        <%= Number(material.supplier_id) === Number(supplier.supplier_id) ? "selected" : "" %>
                    >

                        <%= supplier.name %>

                    </option>

                <% }) %>

            </select>


            <label for="name">
                Material Name
            </label>

            <input
                type="text"
                id="name"
                name="name"
                value="<%= material.name %>"
                required
            >


            <label for="category">
                Category
            </label>

            <input
                type="text"
                id="category"
                name="category"
                value="<%= material.category %>"
                required
            >


            <label for="unit">
                Unit
            </label>

            <input
                type="text"
                id="unit"
                name="unit"
                value="<%= material.unit %>"
                required
            >


            <label for="unit_cost">
                Unit Cost
            </label>

            <input
                type="number"
                id="unit_cost"
                name="unit_cost"
                min="0"
                step="0.01"
                value="<%= material.unit_cost %>"
                required
            >


            <label for="stock_qty">
                Stock Quantity
            </label>

            <input
                type="number"
                id="stock_qty"
                name="stock_qty"
                min="0"
                step="0.01"
                value="<%= material.stock_qty %>"
                required
            >


            <label for="reorder_level">
                Reorder Level
            </label>

            <input
                type="number"
                id="reorder_level"
                name="reorder_level"
                min="0"
                step="0.01"
                value="<%= material.reorder_level %>"
                required
            >


            <button type="submit">
                Update Material
            </button>

        </form>

    </div>

</body>

</html>