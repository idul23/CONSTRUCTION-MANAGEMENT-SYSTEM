<!DOCTYPE html>

<html>
<head>
    <title>Materials</title>
</head>

<body>

<p>
    <a href="/dashboard">← Back to Dashboard</a>

    <% if (user.role_name === "Administrator" || user.role_name === "Project Manager") { %>
        |
        <a href="/materials/add">+ Add Material</a>
    <% } %>
</p>

<h1>Materials</h1>

<% if (materials.length === 0) { %>

    <p>No materials found.</p>

<% } else { %>

    <table border="1" cellpadding="8" cellspacing="0">

        <thead>
            <tr>
                <th>ID</th>
                <th>Material Name</th>
                <th>Category</th>
                <th>Unit</th>
                <th>Unit Cost</th>
                <th>Stock Quantity</th>
                <th>Reorder Level</th>
                <th>Supplier</th>

                <% if (user.role_name === "Administrator" || user.role_name === "Project Manager") { %>
                    <th>Actions</th>
                <% } %>

            </tr>
        </thead>

        <tbody>

            <% materials.forEach(material => { %>

                <tr>

                    <td>
                        <%= material.material_id %>
                    </td>

                    <td>
                        <%= material.name %>
                    </td>

                    <td>
                        <%= material.category %>
                    </td>

                    <td>
                        <%= material.unit %>
                    </td>

                    <td>
                        ₱<%= Number(material.unit_cost || 0).toLocaleString("en-PH", {
                            minimumFractionDigits: 2
                        }) %>
                    </td>

                    <td>
                        <%= material.stock_qty %>
                    </td>

                    <td>
                        <%= material.reorder_level %>
                    </td>

                    <td>
                        <% if (material.Supplier) { %>
                            <%= material.Supplier.name %>
                        <% } else { %>
                            No Supplier
                        <% } %>
                    </td>

                    <% if (user.role_name === "Administrator" || user.role_name === "Project Manager") { %>

                        <td>

                            <a href="/materials/edit/<%= material.material_id %>">
                                Edit
                            </a>

                            |

                            <a
                                href="/materials/delete/<%= material.material_id %>"
                                onclick="return confirm('Are you sure you want to delete this material?');"
                            >
                                Delete
                            </a>

                        </td>

                    <% } %>

                </tr>

            <% }) %>

        </tbody>

    </table>

<% } %>

</body>
</html>
