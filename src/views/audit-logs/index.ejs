        .table-footer {
            padding: 16px 22px;
            border-top: 1px solid #edf1f6;
            color: #8794a6;
            background: #fff;
            font-size: 11px;
            line-height: 1.6;
        }

        .table-footer strong {
            color: var(--navy);
            font-weight: 850;
        }

        /* PAGE FOOTER */

