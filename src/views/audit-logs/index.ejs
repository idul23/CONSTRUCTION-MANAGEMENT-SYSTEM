<script>
    const mainLayout = document.getElementById("mainLayout");
    const menuToggle = document.getElementById("menuToggle");
    const mobileOverlay = document.getElementById("mobileOverlay");
    const sidebar = document.getElementById("sidebar");

    function isMobileScreen() {
        return window.matchMedia("(max-width: 768px)").matches;
    }

    function updateMenuAccessibility() {
        const expanded = isMobileScreen()
            ? mainLayout.classList.contains("mobile-menu-open")
            : !mainLayout.classList.contains("sidebar-collapsed");

        menuToggle.setAttribute("aria-expanded", String(expanded));
    }

    function closeMobileMenu() {
        mainLayout.classList.remove("mobile-menu-open");
        updateMenuAccessibility();
    }

    menuToggle.addEventListener("click", function() {
        if (isMobileScreen()) {
            mainLayout.classList.toggle("mobile-menu-open");
        } else {
            mainLayout.classList.toggle("sidebar-collapsed");
        }

        updateMenuAccessibility();
    });

    mobileOverlay.addEventListener("click", closeMobileMenu);

    sidebar.querySelectorAll("a").forEach(function(link) {
        link.addEventListener("click", function() {
            if (isMobileScreen()) {
                closeMobileMenu();
            }
        });
    });

    document.addEventListener("keydown", function(event) {
        if (event.key === "Escape") {
            closeMobileMenu();
        }
    });

    window.addEventListener("resize", function() {
        if (!isMobileScreen()) {
            mainLayout.classList.remove("mobile-menu-open");
        }

        updateMenuAccessibility();
    });

    const printButton = document.getElementById("printButton");

    if (printButton) {
        printButton.addEventListener("click", function() {
            window.print();
        });
    }

    /* Live audit log search */

    const auditSearch = document.getElementById("auditSearch");
    const auditTable = document.getElementById("auditTable");
    const auditRows = Array.from(document.querySelectorAll(".audit-row"));
    const emptyState = document.getElementById("emptyState");
    const emptyStateHeading = document.getElementById("emptyStateHeading");
    const emptyStateMessage = document.getElementById("emptyStateMessage");
    const visibleCount = document.getElementById("visibleCount");
    const tableCount = document.getElementById("tableCount");
    const totalRecords = auditRows.length;

    function filterAuditLogs() {
        const query = auditSearch.value.trim().toLowerCase();
        let count = 0;

        auditRows.forEach(function(row) {
            const matches = row.textContent.toLowerCase().includes(query);

            row.style.display = matches ? "" : "none";

            if (matches) {
                count++;
            }
        });

        if (visibleCount) {
            visibleCount.textContent = count;
        }

        if (tableCount) {
            tableCount.textContent =
                "Showing " + count + " of " + totalRecords + " audit log records";
        }

        if (auditTable) {
            auditTable.style.display = count > 0 ? "" : "none";
        }

        if (emptyState) {
            emptyState.style.display = count === 0 ? "block" : "none";
        }

        if (count === 0 && totalRecords > 0) {
            if (emptyStateHeading) {
                emptyStateHeading.textContent = "No Matching Audit Logs";
            }

            if (emptyStateMessage) {
                emptyStateMessage.textContent =
                    "Try searching by username, table, record ID, action, or date.";
            }
        }
    }

    if (auditSearch) {
        auditSearch.addEventListener("input", filterAuditLogs);
    }

    updateMenuAccessibility();
</script>

</body>
</html>