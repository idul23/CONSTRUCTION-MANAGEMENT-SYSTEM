                    <div class="stat-icon">☷</div>
                </div>

                <div class="stat-number"><%= totalLogs %></div>
                <div class="stat-note">All recorded system changes</div>
            </div>

            <div class="stat-card">
                <div class="stat-top">
                    <div class="stat-label">Affected Tables</div>
                    <div class="stat-icon">▤</div>
                </div>

                <div class="stat-number"><%= affectedTables %></div>
                <div class="stat-note">Different tables with logged changes</div>
            </div>

            <div class="stat-card">
                <div class="stat-top">
                    <div class="stat-label">Action Types</div>
                    <div class="stat-icon">↻</div>
                </div>

                <div class="stat-number"><%= logActions %></div>
                <div class="stat-note">Different recorded action types</div>
            </div>

        </section>

        <div class="section-label">Audit Records</div>

        <section class="panel">

            <div class="panel-header">
                <div class="panel-title-wrap">
                    <h2>All Audit Logs</h2>
                    <div class="panel-subtitle">
                        Review who changed a record, what action occurred, and when it happened
                    </div>
                </div>

                <span class="record-count-badge">
                    <%= totalLogs %> Total Records
                </span>
            </div>

            <div class="table-tools">
                <span class="table-count" id="tableCount">
                    Showing <%= totalLogs %> audit log records
                </span>

                <label class="search-box">
                    <span class="search-icon">⌕</span>
