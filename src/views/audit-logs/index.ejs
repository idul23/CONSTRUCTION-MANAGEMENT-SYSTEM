                height: 38px;
            }

            .welcome {
                display: none;
            }

            .logout-btn {
                padding: 9px 11px;
                font-size: 11px;
            }

            .layout {
                min-height: calc(100vh - 64px);
            }

            .sidebar {
                position: fixed;
                top: 64px;
                left: 0;
                bottom: 0;
                width: 270px;
                max-width: 85vw;
                height: calc(100vh - 64px);
                transform: translateX(-105%);
                visibility: hidden;
                box-shadow: none;
            }

            .layout.sidebar-collapsed .sidebar {
                width: 270px;
                flex-basis: 270px;
            }

            .layout.sidebar-collapsed .sidebar-heading,
            .layout.sidebar-collapsed .sidebar-divider {
                display: block;
            }

            .layout.sidebar-collapsed .nav-label {
                display: inline;
            }

            .layout.sidebar-collapsed .nav-link {
                justify-content: flex-start;
                padding: 11px 13px;
            }

            .layout.sidebar-collapsed .nav-link::after {
                display: none;
            }

            .layout.mobile-menu-open .sidebar {
                transform: translateX(0);
                visibility: visible;
                box-shadow: 10px 0 35px rgba(5,15,30,.23);
            }

            .mobile-overlay {
                position: fixed;
                top: 64px;
                left: 0;
                right: 0;
                bottom: 0;
                z-index: 800;
                background: rgba(8,18,34,.52);
                backdrop-filter: blur(3px);
            }

            .layout.mobile-menu-open .mobile-overlay {
                display: block;
            }

            .main-content {
                padding: 23px 16px;
            }

            .page-heading {
                align-items: flex-start;
                flex-direction: column;
                margin-bottom: 23px;
            }

            .heading-actions {
                width: 100%;
            }

            .heading-actions .btn {
                flex: 1;
            }

            .page-heading h1 {
                font-size: 28px;
            }

            .stats {
                gap: 12px;
                margin-bottom: 25px;
            }

            .stat-card {
                padding: 17px;
                border-radius: 14px;
            }

            .stat-top {
                margin-bottom: 15px;
            }

            .stat-icon {
                width: 38px;
                height: 38px;
                font-size: 19px;
                border-radius: 11px;
            }

            .stat-number {
                font-size: 27px;
            }

            .panel {
                border-radius: 14px;
            }

            .panel-header {
                padding: 18px;
            }

            .table-tools {
                padding: 14px 16px;
            }

            .search-box {
                width: 100%;
            }

            .table-footer {
                padding: 14px 16px;
            }
        }

        @media (max-width: 440px) {
            .stats {
                grid-template-columns: 1fr;
            }

            .main-content {
                padding: 20px 13px;
            }

            .page-heading h1 {
                font-size: 26px;
            }

            .heading-actions {
                flex-direction: column;
            }

            .heading-actions .btn {
                width: 100%;
                flex: auto;
            }

            .stat-card {
                padding: 18px;
            }

            .panel-header {
                align-items: flex-start;
                flex-direction: column;
            }

            .record-count-badge {
                align-self: flex-start;
            }
        }

        /* TOUCHSCREEN AND REDUCED MOTION */

        @media (hover: none) {
            .stat-card:hover {
                transform: none;
            }

            .btn:active,
            .json-details summary:active {
                transform: scale(.98);
            }
        }

        @media (prefers-reduced-motion: reduce) {
            html {
                scroll-behavior: auto;
            }

            *,
            *::before,
            *::after {
                animation-duration: .01ms !important;
                animation-iteration-count: 1 !important;
                transition-duration: .01ms !important;
            }
        }

        /* PRINT */

        @media print {
            .topbar,
            .sidebar,
            .mobile-overlay,
            .heading-actions,
            .table-tools,
            .json-details summary,
            .footer {
                display: none !important;
            }

            .layout {
                display: block;
                min-height: auto;
            }

            .main-content {
                padding: 0;
            }

            body {
                background: white;
                color: black;
            }

            .page-heading h1,
            .panel-header h2,
            .stat-number,
            .log-name,
            .record-id {
                color: black;
            }

            .panel,
            .stat-card {
                box-shadow: none;
                border: 1px solid #ddd;
                break-inside: avoid;
            }

            .table-wrapper {
                overflow: visible;
            }

            table {
                min-width: 0;
                width: 100%;
                font-size: 8px;
            }

            thead th,
            tbody td {
                padding: 6px;
            }

            .json-details {
                max-width: none;
            }

            .json-details pre {
                display: block;
                min-width: 0;
                max-width: none;
                max-height: none;
                overflow: visible;
                padding: 5px;
                font-size: 7px;
            }

            details:not([open]) > pre {
                display: block;
            }

            .status,
            .table-name {
                print-color-adjust: exact;
                -webkit-print-color-adjust: exact;
            }

            tr {
                break-inside: avoid;
            }
        }
    </style>
</head>

<body>

<%
    const logRows = typeof logs !== "undefined" && Array.isArray(logs)
        ? logs
        : [];

    const totalLogs = logRows.length;

    const affectedTables = new Set(
        logRows
            .map(function(log) {
                return log.table_name;
            })
            .filter(Boolean)
    ).size;

    const logActions = new Set(
        logRows
            .map(function(log) {
                return String(log.action_type || "").toUpperCase();
            })
            .filter(Boolean)
    ).size;

    const formatAuditDate = function(value) {
        if (!value) return "N/A";

        const date = new Date(value);

        if (isNaN(date.getTime())) {
            return String(value);
        }

        return date.toLocaleString("en-PH", {
            year: "numeric",
            month: "short",
            day: "numeric",
            hour: "2-digit",
            minute: "2-digit",
            second: "2-digit",
            hour12: true,
            timeZone: "Asia/Manila"
        });
    };

    const formatAuditValues = function(value) {
        if (value === null || value === undefined || value === "") {
            return "";
        }

        if (typeof value === "string") {
            try {
                return JSON.stringify(JSON.parse(value), null, 2);
            } catch (error) {
                return value;
            }
        }

        try {
            return JSON.stringify(value, null, 2);
        } catch (error) {
            return String(value);
        }
    };

    const getActionClass = function(action) {
        const type = String(action || "").toUpperCase();

        if (type === "INSERT" || type === "CREATE") return "insert";
        if (type === "DELETE" || type === "REMOVE") return "delete";
        if (type === "UPDATE") return "update";

        return "";
    };
%>

