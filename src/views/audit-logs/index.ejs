            padding: 21px 10px 8px;
            border-top: 1px solid #e2e8f0;
            color: #8a97a8;
            text-align: center;
            font-size: 10px;
            letter-spacing: .3px;
        }

        .footer span {
            color: #c06c19;
            font-weight: 800;
        }

        /* COLLAPSIBLE SIDEBAR */

        .layout.sidebar-collapsed .sidebar {
            width: 74px;
            flex-basis: 74px;
        }

        .layout.sidebar-collapsed .sidebar-heading,
        .layout.sidebar-collapsed .sidebar-divider,
        .layout.sidebar-collapsed .nav-label {
            display: none;
        }

        .layout.sidebar-collapsed .sidebar-nav {
            padding: 17px 9px 22px;
        }

        .layout.sidebar-collapsed .nav-link {
            justify-content: center;
            padding: 12px 8px;
        }

        .layout.sidebar-collapsed .nav-icon {
            width: 26px;
            min-width: 26px;
        }

        .layout.sidebar-collapsed .nav-link::after {
            content: attr(data-title);
            position: absolute;
            z-index: 1200;
            top: 50%;
            left: 64px;
            transform: translateY(-50%);
            padding: 9px 12px;
            color: white;
            background: #0b1729;
            border: 1px solid rgba(255,255,255,.12);
            border-radius: 8px;
            font-size: 11px;
            box-shadow: 0 5px 18px rgba(0,0,0,.18);
            opacity: 0;
            visibility: hidden;
            pointer-events: none;
        }

        .layout.sidebar-collapsed .nav-link:hover::after {
            opacity: 1;
            visibility: visible;
        }

        /* ACCESSIBILITY */

        a:focus-visible,
        button:focus-visible,
        input:focus-visible,
        summary:focus-visible {
            outline: 3px solid rgba(242,140,40,.65);
            outline-offset: 3px;
        }

        .mobile-overlay {
            display: none;
        }

        /* TABLET */

        @media (max-width: 1200px) {
            .main-content {
                padding: 24px;
            }

            .stats {
                gap: 14px;
            }

            .stat-card {
                padding: 19px;
            }
        }

        /* MOBILE */

        @media (max-width: 768px) {
            .topbar {
                height: 64px;
                padding: 0 14px;
                gap: 8px;
            }

