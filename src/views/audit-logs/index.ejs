            <% if (totalLogs > 0) { %>

                <div class="table-wrapper">
                    <table id="auditTable">
                        <thead>
                            <tr>
                                <th>Log ID</th>
                                <th>Changed By</th>
                                <th>Table</th>
                                <th>Record ID</th>
                                <th>Action</th>
                                <th>Old Values</th>
                                <th>New Values</th>
                                <th>Date and Time</th>
                            </tr>
                        </thead>

                        <tbody id="auditTableBody">
                            <% logRows.forEach(function(log) { %>
                                <tr class="audit-row">
                                    <td>
                                        <div class="log-name">
                                            Log #<%= log.log_id %>
                                        </div>
                                        <div class="log-id">Audit Record</div>
                                    </td>

                                    <td>
                                        <div class="log-name">
                                            <%= log.changedByUser
                                                ? log.changedByUser.username
                                                : "System" %>
                                        </div>
                                    </td>

                                    <td>
                                        <span class="table-name">
                                            <%= log.table_name || "N/A" %>
                                        </span>
                                    </td>

                                    <td>
                                        <span class="record-id">
                                            <%= log.record_id || "—" %>
                                        </span>
