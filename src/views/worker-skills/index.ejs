        .empty-icon {
            width: 58px;
            height: 58px;
            display: grid;
            place-items: center;
            margin: 0 auto 14px;
            color: var(--orange);
            background: #fff0df;
            border: 1px solid #ffe2c4;
            border-radius: 17px;
            font-size: 27px;
        }

        .empty-state strong {
            display: block;
            margin-bottom: 5px;
            color: var(--navy);
            font-size: 14px;
        }

        .empty-state p {
            margin-bottom: 16px;
        }

        .search-empty {
            display: none;
            padding: 25px 20px;
            color: #8290a4;
            text-align: center;
            font-size: 12px;
            background: #fffaf4;
