<!DOCTYPE html>
<html>
<head>
    <title>Worker Skills</title>
</head>
<body>

    <p>
        <a href="/dashboard">← Back to Dashboard</a>
        |
        <a href="/worker-skills/add">+ Add Worker Skill</a>
    </p>

    <h1>Worker Skills</h1>

    <% if (workerSkills.length === 0) { %>

        <p>No worker skills found.</p>

    <% } else { %>

        <table border="1" cellpadding="8" cellspacing="0">

            <thead>
                <tr>
                    <th>Worker</th>
                    <th>Skill</th>
                    <th>Proficiency</th>
                    <th>Years Experience</th>
                    <th>Certified Date</th>
                    <th>Actions</th>
                </tr>
            </thead>

            <tbody>

                <% workerSkills.forEach(workerSkill => { %>

                    <tr>

                        <td>
                            <%= workerSkill.Worker
                                ? workerSkill.Worker.first_name + " " + workerSkill.Worker.last_name
                                : "Unknown" %>
                        </td>

                        <td>
                            <%= workerSkill.Skill
                                ? workerSkill.Skill.skill_name
                                : "Unknown" %>
                        </td>

                        <td>
                            <%= workerSkill.proficiency || "" %>
                        </td>

                        <td>
                            <%= workerSkill.years_exp %>
                        </td>

                        <td>
                            <%= workerSkill.certified_date || "" %>
                        </td>

                        <td>

                            <a href="/worker-skills/edit/<%= workerSkill.worker_id %>/<%= workerSkill.skill_id %>">
                                Edit
                            </a>

                            |

                            <a
                                href="/worker-skills/delete/<%= workerSkill.worker_id %>/<%= workerSkill.skill_id %>"
                                onclick="return confirm('Are you sure you want to delete this worker skill?');"
                            >
                                Delete
                            </a>

                        </td>

                    </tr>

                <% }) %>

            </tbody>

        </table>

    <% } %>

</body>
</html>