            border: 1px solid #e4eaf2;
            border-radius: 13px;
            background: linear-gradient(145deg, #fff, #fbfcff);
            transition: transform .25s, border-color .25s, box-shadow .25s;
        }

        .guide-card::before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 3px;
            background: linear-gradient(90deg, var(--orange), #ffd09d, transparent);
        }

        .guide-card:hover {
            transform: translateY(-5px);
            border-color: rgba(242,140,40,.55);
            box-shadow: 0 10px 24px rgba(20,43,74,.08);
        }

        .guide-card h3 {
            margin-bottom: 14px;
        }

        .guide-card p {
            color: #718096;
            font-size: 12px;
            line-height: 1.8;
        }

        .footer {
            margin-top: 30px;
            padding: 21px 10px 8px;
            border-top: 1px solid #e2e8f0;
            color: #8a97a8;
            text-align: center;
            font-size: 10px;
            letter-spacing: .3px;
        }

        .footer span {
            color: #c06c19;
            font-weight: 800;
        }

        .layout.sidebar-collapsed .sidebar {
            width: 74px;
            flex-basis: 74px;
        }

        .layout.sidebar-collapsed .sidebar-heading,
        .layout.sidebar-collapsed .sidebar-divider,
        .layout.sidebar-collapsed .nav-label {
            display: none;
        }

        .layout.sidebar-collapsed .sidebar-nav {
            padding: 17px 9px 22px;
        }

        .layout.sidebar-collapsed .nav-link {
            justify-content: center;
            padding: 12px 8px;
        }

        .layout.sidebar-collapsed .nav-icon {
            width: 26px;
            min-width: 26px;
        }

        .layout.sidebar-collapsed .nav-link::after {
            content: attr(data-title);
            position: absolute;
            z-index: 1200;
            top: 50%;
            left: 64px;
            transform: translateY(-50%);
            padding: 9px 12px;
            color: white;
            background: #0b1729;
            border: 1px solid rgba(255,255,255,.12);
            border-radius: 8px;
            font-size: 11px;
            box-shadow: 0 5px 18px rgba(0,0,0,.18);
            opacity: 0;
            visibility: hidden;
            pointer-events: none;
        }

        .layout.sidebar-collapsed .nav-link:hover::after {
            opacity: 1;
            visibility: visible;
        }

        a:focus-visible,
        button:focus-visible,
        input:focus-visible {
            outline: 3px solid rgba(242,140,40,.65);
            outline-offset: 3px;
        }

        .mobile-overlay {
            display: none;
        }

        @media (max-width: 1200px) {
            .main-content {
                padding: 24px;
            }

            .stats {
                gap: 14px;
            }

            .stat-card {
                padding: 19px;
            }

            .guide-grid {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }
        }

        @media (max-width: 768px) {
            .topbar {
                height: 64px;
                padding: 0 14px;
                gap: 8px;
            }

            .topbar-left,
            .topbar-right {
                gap: 9px;
            }

            .brand {
                gap: 8px;
                font-size: 16px;
            }

            .brand-mark {
                width: 32px;
                height: 32px;
                font-size: 16px;
            }

            .menu-toggle {
                width: 38px;
                height: 38px;
            }

            .welcome {
                display: none;
            }

            .logout-btn {
                padding: 9px 11px;
                font-size: 11px;
            }

            .layout {
                min-height: calc(100vh - 64px);
            }

            .sidebar {
                position: fixed;
                top: 64px;
                left: 0;
                bottom: 0;
                width: 270px;
                max-width: 85vw;
                height: calc(100vh - 64px);
                transform: translateX(-105%);
                visibility: hidden;
                box-shadow: none;
            }

            .layout.sidebar-collapsed .sidebar {
                width: 270px;
                flex-basis: 270px;
            }

            .layout.sidebar-collapsed .sidebar-heading,
            .layout.sidebar-collapsed .sidebar-divider {
                display: block;
            }

            .layout.sidebar-collapsed .nav-label {
                display: inline;
            }

            .layout.sidebar-collapsed .nav-link {
                justify-content: flex-start;
                padding: 11px 13px;
            }

            .layout.sidebar-collapsed .nav-link::after {
                display: none;
            }

            .layout.mobile-menu-open .sidebar {
                transform: translateX(0);
                visibility: visible;
                box-shadow: 10px 0 35px rgba(5,15,30,.23);
            }

            .mobile-overlay {
                position: fixed;
                top: 64px;
                left: 0;
                right: 0;
                bottom: 0;
                z-index: 800;
                background: rgba(8,18,34,.52);
                backdrop-filter: blur(3px);
            }

            .layout.mobile-menu-open .mobile-overlay {
                display: block;
            }

            .main-content {
                padding: 23px 16px;
            }

            .page-heading {
                align-items: flex-start;
                flex-direction: column;
                margin-bottom: 23px;
            }

            .heading-actions {
                width: 100%;
            }

            .heading-actions .btn {
                flex: 1;
            }

            .page-heading h1 {
                font-size: 28px;
            }

            .stats {
                grid-template-columns: repeat(2, minmax(0, 1fr));
                gap: 12px;
                margin-bottom: 25px;
            }

            .stat-card {
                padding: 17px;
                border-radius: 14px;
            }

            .stat-top {
                margin-bottom: 15px;
            }

            .stat-icon {
                width: 38px;
                height: 38px;
                font-size: 19px;
                border-radius: 11px;
            }

            .stat-card h2 {
                font-size: 27px;
            }

            .panel {
                border-radius: 14px;
            }

            .panel-header {
                padding: 18px;
            }

            .table-tools {
                padding: 14px 16px;
            }

            .search-box {
                width: 100%;
            }

            .guide-grid {
                padding: 16px;
            }
        }

        @media (max-width: 440px) {
            .stats {
                grid-template-columns: 1fr;
            }

            .main-content {
                padding: 20px 13px;
            }

            .page-heading h1 {
                font-size: 26px;
            }

            .heading-actions {
                flex-direction: column;
            }

            .heading-actions .btn {
                width: 100%;
                flex: auto;
            }

            .stat-card {
                padding: 18px;
            }

            .panel-header {
                align-items: flex-start;
                flex-direction: column;
            }

            .record-count-badge {
                align-self: flex-start;
            }

            .guide-grid {
                grid-template-columns: 1fr;
            }
        }

        @media (hover: none) {
            .stat-card:hover,
            .guide-card:hover {
                transform: none;
            }

            .btn:active,
            .action-link:active {
                transform: scale(.98);
            }
        }

        @media (prefers-reduced-motion: reduce) {
            html {
                scroll-behavior: auto;
            }

            *,
            *::before,
            *::after {
                animation-duration: .01ms !important;
                animation-iteration-count: 1 !important;
                transition-duration: .01ms !important;
            }
        }

        @media print {
            .topbar,
            .sidebar,
            .mobile-overlay,
            .heading-actions,
            .table-tools,
            .actions,
            .footer {
                display: none !important;
            }

            .layout {
                display: block;
            }

            .main-content {
                padding: 0;
            }

            .panel,
            .stat-card,
            .guide-card {
                box-shadow: none;
                break-inside: avoid;
            }

            .table-wrapper {
                overflow: visible;
            }

            table {
                min-width: 0;
                font-size: 9px;
            }

            th,
            td {
                padding: 8px;
            }

            body {
                background: white;
            }
        }
    </style>
</head>

<body>

<%
    const skillRows = typeof workerSkills !== "undefined" && Array.isArray(workerSkills)
        ? workerSkills
        : [];

    const workerIds = new Set(
        skillRows
            .map(function(item) {
                return item.worker_id;
            })
            .filter(function(id) {
                return id !== null && id !== undefined;
            })
    );

    const certifiedCount = skillRows.filter(function(item) {
        return Boolean(item.certified_date);
    }).length;

    const formatSkillDate = function(value) {
        if (!value) return "Not certified";

        const date = new Date(value);

        if (isNaN(date.getTime())) return "Not certified";

        return date.toLocaleDateString("en-PH", {
            year: "numeric",
            month: "short",
            day: "numeric",
            timeZone: "UTC"
        });
    };

    const proficiencyClass = function(value) {
        const level = String(value || "").toLowerCase().trim();

        if (level === "basic") return "basic";
        if (level === "intermediate") return "intermediate";
        if (level === "advanced") return "advanced";

        return "unknown";
    };
%>

<header class="topbar">
    <div class="topbar-left">
        <button
            type="button"
            class="menu-toggle"
            id="menuToggle"
            aria-label="Toggle navigation menu"
            aria-controls="sidebar"
            aria-expanded="true"
        >
            <span></span>
            <span></span>
            <span></span>
        </button>

        <a href="/dashboard" class="brand">
            <span class="brand-mark">⌂</span>
            <span>Construction <span>MS</span></span>
        </a>
    </div>

    <div class="topbar-right">
        <div class="welcome">
            Welcome back,
            <strong><%= typeof user !== "undefined" && user ? user.username : "User" %></strong>
            <span class="role-badge"><%= typeof user !== "undefined" && user ? user.role_name : "" %></span>
        </div>

        <a href="/logout" class="logout-btn">
            <span>↪</span>
            Logout
        </a>
    </div>
</header>

<div class="layout" id="mainLayout">

    <aside class="sidebar" id="sidebar">
        <div class="sidebar-heading">Workspace</div>

        <nav class="sidebar-nav">
            <a href="/dashboard" class="nav-link" data-title="Dashboard">
                <span class="nav-icon">⌂</span>
                <span class="nav-label">Dashboard</span>
            </a>

            <a href="/projects" class="nav-link" data-title="Projects">
                <span class="nav-icon">▣</span>
                <span class="nav-label">Projects</span>
            </a>

            <a href="/workers" class="nav-link" data-title="Workers">
                <span class="nav-icon">♟</span>
                <span class="nav-label">Workers</span>
            </a>

            <a href="/worker-skills" class="nav-link active" data-title="Worker Skills" aria-current="page">
                <span class="nav-icon">✦</span>
                <span class="nav-label">Worker Skills</span>
            </a>

            <a href="/project-members" class="nav-link" data-title="Project Members">
                <span class="nav-icon">♧</span>
                <span class="nav-label">Project Members</span>
            </a>

            <a href="/user-profiles" class="nav-link" data-title="User Profiles">
                <span class="nav-icon">♙</span>
                <span class="nav-label">User Profiles</span>
            </a>

            <div class="sidebar-divider"></div>
            <div class="sidebar-heading">Project Operations</div>

            <a href="/tasks" class="nav-link" data-title="Tasks">
                <span class="nav-icon">☑</span>
                <span class="nav-label">Tasks</span>
            </a>

            <a href="/project-phases" class="nav-link" data-title="Project Phases">
                <span class="nav-icon">▤</span>
                <span class="nav-label">Project Phases</span>
            </a>

            <a href="/assignments" class="nav-link" data-title="Assignments">
                <span class="nav-icon">↗</span>
                <span class="nav-label">Assignments</span>
            </a>

            <a href="/attendance" class="nav-link" data-title="Attendance">
                <span class="nav-icon">◷</span>
                <span class="nav-label">Attendance</span>
            </a>

            <div class="sidebar-divider"></div>
            <div class="sidebar-heading">Inventory & Resources</div>

            <a href="/materials" class="nav-link" data-title="Materials">
                <span class="nav-icon">▤</span>
                <span class="nav-label">Materials</span>
            </a>

            <a href="/material-usage" class="nav-link" data-title="Material Usage">
                <span class="nav-icon">↗</span>
                <span class="nav-label">Material Usage</span>
            </a>

            <a href="/suppliers" class="nav-link" data-title="Suppliers">
                <span class="nav-icon">♧</span>
                <span class="nav-label">Suppliers</span>
            </a>

            <a href="/equipment" class="nav-link" data-title="Equipment">
                <span class="nav-icon">⚒</span>
                <span class="nav-label">Equipment</span>
            </a>

            <a href="/equipment-usage" class="nav-link" data-title="Equipment Usage">
                <span class="nav-icon">↗</span>
                <span class="nav-label">Equipment Usage</span>
            </a>

            <div class="sidebar-divider"></div>
            <div class="sidebar-heading">Finance & Reports</div>

            <a href="/expenses" class="nav-link" data-title="Expenses">
                <span class="nav-icon">₱</span>
                <span class="nav-label">Expenses</span>
            </a>

            <a href="/reports" class="nav-link" data-title="Reports">
                <span class="nav-icon">▥</span>
                <span class="nav-label">Reports</span>
            </a>

            <% if (typeof user !== "undefined" && user && user.role_name === "Administrator") { %>
                <div class="sidebar-divider"></div>
                <div class="sidebar-heading">Administration</div>

                <a href="/users" class="nav-link" data-title="Users">
                    <span class="nav-icon">♙</span>
                    <span class="nav-label">Users</span>
                </a>

                <a href="/audit-logs" class="nav-link" data-title="Audit Logs">
                    <span class="nav-icon">▤</span>
                    <span class="nav-label">Audit Logs</span>
                </a>
            <% } %>
        </nav>
    </aside>

    <div class="mobile-overlay" id="mobileOverlay"></div>

    <main class="main-content">

        <div class="page-heading">
            <div class="heading-copy">
                <div class="eyebrow">Worker Management</div>
                <h1>Worker Skills</h1>
                <p>
                    Manage worker qualifications, proficiency levels, experience,
                    and certifications to keep track of your team's skills.
                </p>
            </div>

            <div class="heading-actions">
                <button type="button" class="btn btn-secondary" id="printSkills">
                    <span>▤</span>
                    Print Skills
                </button>

                <a href="/worker-skills/add" class="btn btn-primary">
                    <span>＋</span>
                    Assign Skill
                </a>
            </div>
        </div>

        <div class="section-label">Worker Skills Overview</div>

        <section class="stats">

            <div class="stat-card">
                <div class="stat-top">
                    <div class="stat-label">Total Skill Assignments</div>
                    <div class="stat-icon">✦</div>
                </div>
                <h2><%= skillRows.length %></h2>
                <div class="stat-note">All assigned worker skills</div>
            </div>

            <div class="stat-card">
                <div class="stat-top">
                    <div class="stat-label">Workers with Skills</div>
                    <div class="stat-icon">♟</div>
                </div>
                <h2><%= workerIds.size %></h2>
                <div class="stat-note">Workers with at least one skill</div>
            </div>

            <div class="stat-card">
                <div class="stat-top">
                    <div class="stat-label">Certified Assignments</div>
                    <div class="stat-icon">✓</div>
                </div>
                <h2><%= certifiedCount %></h2>
                <div class="stat-note">Assignments with certification dates</div>
            </div>

        </section>

        <div class="section-label">Worker Skill Records</div>

        <section class="panel">

            <div class="panel-header">
                <div class="panel-title-wrap">
                    <h2>All Worker Skills</h2>
                    <div class="panel-subtitle">
                        View and manage the skills assigned to your workers
                    </div>
                </div>

                <span class="record-count-badge">
                    <%= skillRows.length %> Total Records
                </span>
            </div>

            <div class="table-tools">
                <span class="table-count" id="visibleCount">
                    Showing <%= skillRows.length %> skill assignment records
                </span>

                <label class="search-box">
                    <span class="search-icon">⌕</span>
                    <input
                        type="search"
                        id="skillSearch"
                        placeholder="Search workers or skills..."
                        aria-label="Search worker skills"
                    >
                </label>
            </div>

            <% if (skillRows.length > 0) { %>

                <div class="table-wrapper">
                    <table id="skillsTable">
                        <thead>
                            <tr>
                                <th>Worker</th>
                                <th>Skill</th>
                                <th>Proficiency</th>
                                <th>Experience</th>
                                <th>Certification</th>
                                <th>Actions</th>
                            </tr>
                        </thead>

                        <tbody id="skillsTableBody">
                            <% skillRows.forEach(function(item) {
                                const workerRecord = item.Worker || item.worker || {};
                                const skillRecord = item.Skill || item.skill || {};

                                const workerName = [
                                    workerRecord.first_name || item.first_name,
                                    workerRecord.last_name || item.last_name
                                ].filter(Boolean).join(" ") || "Unknown Worker";

                                const skillName = skillRecord.skill_name ||
                                    item.skill_name ||
                                    item.name ||
                                    "Unknown Skill";

                                const proficiency = item.proficiency ||
                                    item.proficiency_level ||
                                    "Not specified";

                                const experience = Number(
                                    item.years_exp !== undefined && item.years_exp !== null
                                        ? item.years_exp
                                        : item.years_experience
                                ) || 0;
                            %>

                                <tr class="skill-row">
                                    <td>
                                        <div class="record-name"><%= workerName %></div>
                                        <div class="record-id">Worker ID: <%= item.worker_id %></div>
                                    </td>

                                    <td>
                                        <div class="record-name"><%= skillName %></div>
                                        <div class="record-id">Skill ID: <%= item.skill_id %></div>
                                    </td>

                                    <td>
                                        <span class="level <%= proficiencyClass(proficiency) %>">
                                            <%= proficiency %>
                                        </span>
                                    </td>

                                    <td class="experience">
                                        <%= experience %> year(s)
                                    </td>

                                    <td>
                                        <% if (item.certified_date) { %>
                                            <span class="certified">
                                                <%= formatSkillDate(item.certified_date) %>
                                            </span>
                                        <% } else { %>
                                            <span class="not-certified">Not certified</span>
                                        <% } %>
                                    </td>

                                    <td>
                                        <div class="actions">
                                            <a
                                                href="/worker-skills/edit/<%= item.worker_id %>/<%= item.skill_id %>"
                                                class="action-link edit-link"
                                                aria-label="Edit skill assignment"
                                                title="Edit skill assignment"
                                            >
                                                <span>✎</span>
                                                Edit
                                            </a>

                                            <form
                                                class="delete-form"
                                                action="/worker-skills/delete/<%= item.worker_id %>/<%= item.skill_id %>"
                                                method="POST"
                                                onsubmit="return confirm('Are you sure you want to delete this skill assignment?');"
                                            >
                                                <button
                                                    type="submit"
                                                    class="action-link delete-link"
                                                    title="Delete skill assignment"
                                                >
                                                    <span>×</span>
                                                    Delete
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>

                            <% }); %>
                        </tbody>
                    </table>
                </div>

                <div class="search-empty" id="emptyState">
                    No matching worker skills found. Try another search.
                </div>

            <% } else { %>

                <div class="empty-state">
                    <div class="empty-icon">✦</div>
                    <strong>No Skill Assignments Available</strong>
                    <p>
                        There are no worker skill assignments yet.
                        Assign a skill to a worker to start tracking qualifications.
                    </p>
                    <a href="/worker-skills/add" class="btn btn-primary">
                        ＋ Assign Your First Skill
                    </a>
                </div>

            <% } %>

        </section>

        <div class="section-label">Proficiency Guide</div>

        <section class="panel">
            <div class="panel-header">
                <div class="panel-title-wrap">
                    <h2>Skill Proficiency Levels</h2>
                    <div class="panel-subtitle">
                        Use these levels to describe each worker's skill experience
                    </div>
                </div>
            </div>

            <div class="guide-grid">
                <div class="guide-card">
                    <h3><span class="level basic">Basic</span></h3>
                    <p>
                        Understands basic tasks but may need guidance or supervision.
                    </p>
                </div>

                <div class="guide-card">
                    <h3><span class="level intermediate">Intermediate</span></h3>
                    <p>
                        Can perform regular tasks independently and has practical experience.
                    </p>
                </div>

                <div class="guide-card">
                    <h3><span class="level advanced">Advanced</span></h3>
                    <p>
                        Has strong experience and can handle more complex tasks within their qualifications.
                    </p>
                </div>
            </div>
        </section>

        <footer class="footer">
            <span>CONSTRUCTION MS</span>
            &nbsp;·&nbsp; Construction Project and Labor Management System
        </footer>

    </main>
</div>

<script>
    const menuToggle = document.getElementById("menuToggle");
    const mainLayout = document.getElementById("mainLayout");
    const mobileOverlay = document.getElementById("mobileOverlay");
    const sidebar = document.getElementById("sidebar");

    function isMobileScreen() {
        return window.matchMedia("(max-width: 768px)").matches;
    }

    function updateMenuAccessibility() {
        const expanded = isMobileScreen()
            ? mainLayout.classList.contains("mobile-menu-open")
            : !mainLayout.classList.contains("sidebar-collapsed");

        menuToggle.setAttribute("aria-expanded", String(expanded));
    }

    function closeMobileMenu() {
        mainLayout.classList.remove("mobile-menu-open");
        updateMenuAccessibility();
    }

    menuToggle.addEventListener("click", function() {
        if (isMobileScreen()) {
            mainLayout.classList.toggle("mobile-menu-open");
        } else {
            mainLayout.classList.toggle("sidebar-collapsed");
        }

        updateMenuAccessibility();
    });

    mobileOverlay.addEventListener("click", closeMobileMenu);

    sidebar.querySelectorAll("a").forEach(function(link) {
        link.addEventListener("click", function() {
            if (isMobileScreen()) {
                closeMobileMenu();
            }
        });
    });

    document.addEventListener("keydown", function(event) {
        if (event.key === "Escape") {
            closeMobileMenu();
        }
    });

    window.addEventListener("resize", function() {
        if (!isMobileScreen()) {
            mainLayout.classList.remove("mobile-menu-open");
        }

        updateMenuAccessibility();
    });

    const skillSearch = document.getElementById("skillSearch");
    const skillRows = Array.from(
        document.querySelectorAll("#skillsTableBody .skill-row")
    );
    const visibleCount = document.getElementById("visibleCount");
    const emptyState = document.getElementById("emptyState");
    const skillsTable = document.getElementById("skillsTable");

    if (skillSearch) {
        skillSearch.addEventListener("input", function() {
            const query = skillSearch.value.trim().toLowerCase();
            let visible = 0;

            skillRows.forEach(function(row) {
                const matches = row.textContent.toLowerCase().includes(query);

                row.style.display = matches ? "" : "none";

                if (matches) {
                    visible++;
                }
            });

            if (visibleCount) {
                visibleCount.textContent =
                    "Showing " + visible + " of " +
                    skillRows.length + " skill assignment records";
            }

            if (emptyState) {
                emptyState.style.display =
                    skillRows.length > 0 && visible === 0 ? "block" : "none";
            }

            if (skillsTable) {
                skillsTable.style.display = visible > 0 ? "table" : "none";
            }
        });
    }

    const printSkills = document.getElementById("printSkills");

    if (printSkills) {
        printSkills.addEventListener("click", function() {
            window.print();
        });
    }

    updateMenuAccessibility();
</script>

</body>
</html>