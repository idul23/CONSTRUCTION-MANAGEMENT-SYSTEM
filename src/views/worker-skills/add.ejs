<!DOCTYPE html>
<html>
<head>
    <title>Add Worker Skill</title>
</head>
<body>

    <p>
        <a href="/worker-skills">← Back to Worker Skills</a>
    </p>

    <h1>Add Worker Skill</h1>

    <% if (error) { %>
        <p><%= error %></p>
    <% } %>

    <form action="/worker-skills/add" method="POST">

        <p>
            <label>Worker:</label><br>

            <select name="worker_id" required>

                <option value="">
                    Select Worker
                </option>

                <% workers.forEach(worker => { %>

                    <option value="<%= worker.worker_id %>">
                        <%= worker.first_name %> <%= worker.last_name %>
                    </option>

                <% }) %>

            </select>
        </p>

        <p>
            <label>Skill:</label><br>

            <select name="skill_id" required>

                <option value="">
                    Select Skill
                </option>

                <% skills.forEach(skill => { %>

                    <option value="<%= skill.skill_id %>">
                        <%= skill.skill_name %>
                    </option>

                <% }) %>

            </select>
        </p>

        <p>
            <label>Proficiency:</label><br>

            <input
                type="text"
                name="proficiency"
                maxlength="50"
                placeholder="Example: Beginner, Intermediate, Advanced"
            >
        </p>

        <p>
            <label>Years of Experience:</label><br>

            <input
                type="number"
                name="years_exp"
                min="0"
                value="0"
                required
            >
        </p>

        <p>
            <label>Certified Date:</label><br>

            <input
                type="date"
                name="certified_date"
            >
        </p>

        <button type="submit">
            Save Worker Skill
        </button>

    </form>

</body>
</html>