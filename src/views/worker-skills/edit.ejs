
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Worker Skill - Construction MS</title>

    <style>
        :root {
            --navy: #142b4a;
            --navy-light: #203e63;
            --orange: #f28c28;
            --white: #ffffff;
            --background: #f3f5f9;
            --border: #e1e6ed;
            --text: #263445;
            --muted: #758195;
            --red: #c93636;
        }

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background: var(--background);
            color: var(--text);
        }

        .header {
            background: var(--navy);
            color: var(--white);
            padding: 18px 4%;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 18px;
            box-shadow: 0 3px 12px rgba(20, 43, 74, 0.15);
        }

        .brand {
            font-size: 21px;
            font-weight: bold;
            white-space: nowrap;
        }

        .brand span {
            color: var(--orange);
        }

        .navigation {
            display: flex;
            align-items: center;
            flex-wrap: wrap;
            gap: 5px;
        }

        .navigation a {
            display: inline-flex;
            justify-content: center;
            align-items: center;
            background: var(--orange);
            color: var(--white);
            text-decoration: none;
            font-size: 14px;
            font-weight: bold;
            padding: 11px 20px;
            border: 1px solid var(--orange);
            border-radius: 7px;
            box-shadow: 0 3px 8px rgba(242, 140, 40, 0.22);
            transition: background 0.2s, border-color 0.2s,
                        box-shadow 0.2s, transform 0.2s;
        }

        .navigation a:hover {
            background: #d97515;
            border-color: #d97515;
            color: var(--white);
            box-shadow: 0 5px 12px rgba(20, 43, 74, 0.18);
            transform: translateY(-2px);
        }

        .navigation a:active {
            transform: translateY(0);
            box-shadow: none;
        }

        .container {
            width: 100%;
            max-width: 900px;
            margin: 32px auto;
            padding: 0 24px;
        }

        .breadcrumb {
            margin-bottom: 22px;
            color: var(--muted);
            font-size: 14px;
        }

        .breadcrumb a {
            color: var(--navy);
            text-decoration: none;
        }

        .breadcrumb a:hover {
            color: var(--orange);
        }

        .page-heading {
            margin-bottom: 24px;
        }

        h1 {
            color: var(--navy);
            font-size: 29px;
            margin: 0 0 8px;
        }

        .subtitle {
            color: var(--muted);
            font-size: 14px;
            line-height: 1.6;
            margin: 0;
        }

        .form-box {
            background: var(--white);
            border: 1px solid var(--border);
            border-radius: 12px;
            box-shadow: 0 5px 18px rgba(24, 43, 68, 0.05);
            overflow: hidden;
        }

        .form-header {
            padding: 22px 28px;
            background: linear-gradient(135deg, var(--navy), var(--navy-light));
            color: var(--white);
            border-bottom: 4px solid var(--orange);
        }

        .form-header h2 {
            margin: 0 0 7px;
            font-size: 20px;
        }

        .form-header p {
            margin: 0;
            color: #dbe4ef;
            font-size: 13px;
            line-height: 1.5;
        }

        .form-content {
            padding: 28px;
        }

        .section-title {
            color: var(--navy);
            font-size: 15px;
            font-weight: bold;
            padding-bottom: 12px;
            margin: 0 0 20px;
            border-bottom: 1px solid var(--border);
        }

        .form-grid {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 20px 22px;
        }

        .form-group {
            min-width: 0;
        }

        .form-group.full-width {
            grid-column: 1 / -1;
        }

        label {
            display: block;
            margin-bottom: 8px;
            font-size: 13px;
            font-weight: bold;
            color: var(--navy);
        }

        .required {
            color: var(--red);
        }

        input,
        select {
            display: block;
            width: 100%;
            min-height: 44px;
            padding: 11px 13px;
            margin: 0;
            border: 1px solid #d5dce6;
            border-radius: 7px;
            background: var(--white);
            color: var(--text);
            font-family: Arial, sans-serif;
            font-size: 14px;
            transition: border-color 0.2s, box-shadow 0.2s;
        }

        input::placeholder {
            color: #9aa4b3;
        }

        input:hover,
        select:hover {
            border-color: #aab7c8;
        }

        input:focus,
        select:focus {
            outline: none;
            border-color: var(--orange);
            box-shadow: 0 0 0 3px rgba(242, 140, 40, 0.13);
        }

        .field-hint {
            display: block;
            margin-top: 7px;
            color: var(--muted);
            font-size: 12px;
            line-height: 1.5;
        }

        .error {
            background: #fdeaea;
            color: #922b2b;
            border: 1px solid #f3c6c6;
            border-left: 4px solid var(--red);
            padding: 13px 15px;
            border-radius: 7px;
            margin-bottom: 24px;
            font-size: 14px;
            line-height: 1.5;
        }

        .form-actions {
            display: flex;
            justify-content: flex-end;
            align-items: center;
            flex-wrap: wrap;
            gap: 12px;
            margin-top: 30px;
            padding-top: 22px;
            border-top: 1px solid var(--border);
        }

        .button {
            display: inline-flex;
            justify-content: center;
            align-items: center;
            min-height: 44px;
            padding: 12px 20px;
            border-radius: 7px;
            border: 1px solid transparent;
            font-family: Arial, sans-serif;
            font-size: 14px;
            font-weight: bold;
            text-decoration: none;
            cursor: pointer;
            transition: transform 0.2s, box-shadow 0.2s,
                        background 0.2s, color 0.2s;
        }

        .button:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 12px rgba(20, 43, 74, 0.14);
        }

        .button:active {
            transform: translateY(0);
            box-shadow: none;
        }

        .button-primary {
            background: var(--orange);
            color: var(--white);
        }

        .button-primary:hover {
            background: #d97515;
            color: var(--white);
        }

        .button-secondary {
            background: var(--white);
            color: var(--navy);
            border-color: var(--border);
        }

        .button-secondary:hover {
            background: var(--navy);
            color: var(--white);
            border-color: var(--navy);
        }

        button:focus-visible,
        a:focus-visible,
        input:focus-visible,
        select:focus-visible {
            outline: 3px solid #ffad5c;
            outline-offset: 3px;
        }

        @media (max-width: 900px) {
            .header {
                align-items: flex-start;
            }

            .navigation {
                width: 100%;
            }
        }

        @media (max-width: 600px) {
            .header {
                padding: 17px 18px;
            }

            .navigation {
                gap: 4px;
            }

            .navigation a {
                padding: 9px 16px;
                font-size: 12px;
            }

            .container {
                margin: 22px auto;
                padding: 0 14px;
            }

            h1 {
                font-size: 25px;
            }

            .form-header {
                padding: 20px;
            }

            .form-content {
                padding: 20px;
            }

            .form-grid {
                grid-template-columns: 1fr;
                gap: 18px;
            }

            .form-group.full-width {
                grid-column: auto;
            }

            .form-actions {
                flex-direction: column-reverse;
                align-items: stretch;
            }

            .form-actions .button {
                width: 100%;
            }
        }

        @media (prefers-reduced-motion: reduce) {
            *,
            *::before,
            *::after {
                transition: none !important;
            }
        }
    </style>
</head>

<body>

<header class="header">
    <div class="brand">CONSTRUCTION <span>MS</span></div>

    <nav class="navigation">
        <a href="/dashboard">Dashboard</a>
    </nav>
</header>

<main class="container">

    <div class="breadcrumb">
        <a href="/dashboard">Dashboard</a> /
        <a href="/worker-skills">Worker Skills</a> /
        Edit Worker Skill
    </div>

    <section class="page-heading">
        <h1>Edit Worker Skill</h1>
        <p class="subtitle">Update the worker's skill, proficiency level, years of experience, and certification date.</p>
    </section>

    <section class="form-box">

        <div class="form-header">
            <h2>Worker Skill Information</h2>
            <p>Make the necessary changes below and save the updated worker skill details.</p>
        </div>

        <div class="form-content">

            <% if (typeof error !== "undefined" && error) { %>
                <div class="error" role="alert">
                    <%= error %>
                </div>
            <% } %>

            <form
                action="/worker-skills/edit/<%= workerSkill.worker_id %>/<%= workerSkill.skill_id %>"
                method="POST"
                id="workerSkillForm"
            >

                <h3 class="section-title">Worker and Skill Details</h3>

                <div class="form-grid">

                    <div class="form-group">
                        <label for="worker_id">
                            Worker <span class="required">*</span>
                        </label>

                        <select id="worker_id" name="worker_id" required>
                            <% workers.forEach(worker => { %>
                                <option
                                    value="<%= worker.worker_id %>"
                                    <%= Number(worker.worker_id) === Number(workerSkill.worker_id) ? "selected" : "" %>
                                >
                                    <%= worker.first_name %> <%= worker.last_name %>
                                </option>
                            <% }) %>
                        </select>

                        <span class="field-hint">Choose the worker assigned to this skill.</span>
                    </div>

                    <div class="form-group">
                        <label for="skill_id">
                            Skill <span class="required">*</span>
                        </label>

                        <select id="skill_id" name="skill_id" required>
                            <% skills.forEach(skill => { %>
                                <option
                                    value="<%= skill.skill_id %>"
                                    <%= Number(skill.skill_id) === Number(workerSkill.skill_id) ? "selected" : "" %>
                                >
                                    <%= skill.skill_name %>
                                </option>
                            <% }) %>
                        </select>

                        <span class="field-hint">Select the skill assigned to this worker.</span>
                    </div>

                    <div class="form-group full-width">
                        <label for="proficiency">Proficiency</label>

                        <input
                            type="text"
                            id="proficiency"
                            name="proficiency"
                            maxlength="50"
                            value="<%= workerSkill.proficiency || '' %>"
                            placeholder="Example: Beginner, Intermediate, Advanced"
                        >

                        <span class="field-hint">Enter the worker's proficiency level.</span>
                    </div>

                </div>

                <h3 class="section-title" style="margin-top: 30px;">Experience and Certification</h3>

                <div class="form-grid">

                    <div class="form-group">
                        <label for="years_exp">
                            Years of Experience <span class="required">*</span>
                        </label>

                        <input
                            type="number"
                            id="years_exp"
                            name="years_exp"
                            min="0"
                            step="1"
                            value="<%= workerSkill.years_exp ?? 0 %>"
                            required
                        >

                        <span class="field-hint">Enter the number of years the worker has experience in this skill.</span>
                    </div>

                    <div class="form-group">
                        <label for="certified_date">Certified Date</label>

                        <input
                            type="date"
                            id="certified_date"
                            name="certified_date"
                            value="<%= workerSkill.certified_date ? String(workerSkill.certified_date).slice(0, 10) : '' %>"
                        >

                        <span class="field-hint">Optional. Select the certification date, if applicable.</span>
                    </div>

                </div>

                <div class="form-actions">
                    <a href="/worker-skills" class="button button-secondary">Cancel</a>

                    <button type="submit" class="button button-primary" id="submitButton">
                        Update Worker Skill
                    </button>
                </div>

            </form>
        </div>
    </section>

</main>

<script>
    const workerSkillForm = document.getElementById("workerSkillForm");
    const submitButton = document.getElementById("submitButton");

    workerSkillForm.addEventListener("submit", function(event) {
        if (!workerSkillForm.checkValidity()) {
            event.preventDefault();
            workerSkillForm.reportValidity();
            return;
        }

        submitButton.disabled = true;
        submitButton.textContent = "Saving Changes...";
        submitButton.style.opacity = "0.75";
        submitButton.style.cursor = "wait";
    });
</script>

</body>
</html>
